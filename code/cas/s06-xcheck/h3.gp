\\
\\ S06 cross-check (F4, batch 7), row S06-C7 (H3), and the shared routines used by t4_hecke.gp.
\\ Definitions: code/cas/s06-xcheck/README.md, Section 1.
\\   c_q(f)    = lambda_f(b_k) O_P,  b_k  = ker(T_k(N) -> End S^old), T_k(N) = Z[T_n : n >= 1] (contains U_q);
\\   t^an_f(q) = ord_P lambda_f(b^an), b^an = ker(T^an_k(N) -> End S^old), T^an = Z[T_l : l not dividing N p].
\\ S^old = span{ g(z), g(qz) : g in S_k(Gamma_0(M)) } (cusp forms); M = 1 for the four H3 triples, M > 1 in H3M_CASES.
\\ Run through code/cas/s06-xcheck/run.py (cypari2; PARI/GP 2.15.4).

\\ Two equivalent realisations of the abstract Z-module T = Z-span{T_n} (XC_MODE selects one; both are kept for cross-checks):
\\  "mat":  T_n as flattened matrices on the PARI basis of mf (mfheckemat);
\\  "coef": T_n |-> (a_n(b_1), ..., a_n(b_d)) for the basis b_i of mf, i.e. t |-> (a_1(t b_i))_i. This is Q-linear and injective
\\          (the pairing (t, g) |-> a_1(t g) is perfect on T_Q x S_Q), so it carries the Z-span of the T_n isomorphically.
\\ Returns [nl, C, H, den]: H = HNF basis of den * (image lattice), C = coefficients (#nl x r) with (den*Mf)*C = H.
XC_MODE = "coef";
xc_latmat(mf, nl, mode) =
{
  my(d = mfdim(mf), Mf);
  if(mode == "mat",
    my(mats = mfheckemat(mf, nl));
    Mf = matrix(d*d, #nl, i, j, mats[j][(i-1)\d + 1, (i-1)%d + 1]),
  \\ else "coef"
    my(cf = mfcoefs(mf, vecmax(nl)));                \\ (B+1) x d, row n+1 = (a_n(b_i))_i
    Mf = matrix(d, #nl, i, j, cf[nl[j] + 1, i]));
  Mf;
}
xc_lattice(mf, nl, mode = XC_MODE) =
{
  my(Mf = xc_latmat(mf, nl, mode), den, HU, H, U, r);
  den = denominator(Mf); Mf = den*Mf;
  HU = mathnf(Mf, 1); H = HU[1]; U = HU[2]; r = #H;
  [nl, U[, #nl-r+1 .. #nl], H, den];
}
\\ HNF of the image lattice only (no transformation matrix), scaled back by the denominator.
xc_lathnf(mf, nl, mode) = my(Mf = xc_latmat(mf, nl, mode), den = denominator(Mf)); mathnf(den*Mf)/den;

\\ Lattice of all T_n (cond = 0) or of the T_n with gcd(n, cond) = 1 (cond > 0), n <= B; B doubled until the HNF is stable.
\\ Returns [nl, C, H, den, B, stable_flag].
xc_hecke_lattice(mf, B0, cond, mode = XC_MODE) =
{
  my(B = B0, H1, H2, sel = B -> if(cond, select(n -> gcd(n, cond) == 1, [1..B]), [1..B]), fl = 0);
  H1 = xc_lathnf(mf, sel(B), mode);
  for(it = 1, 3,
    H2 = xc_lathnf(mf, sel(2*B), mode);
    if(H2 == H1, fl = 1; break);
    B *= 2; H1 = H2);
  \\ stable: the T_n with n <= B (the smaller list) already span the lattice; else the last list, flagged unstable
  if(!fl, B *= 2);
  concat(xc_lattice(mf, sel(B), mode), [B, fl]);
}

\\ Old space of level N = q*M, basis g(z), g(qz) for g in the basis of S_k(Gamma_0(M)) (all of it, incl. M-old forms).
\\ "mat":  columns = coordinates in the PARI basis of mf (mftobasis);
\\ "coef": list of q-expansion vectors [a_0..a_Bc] (Bc given).
xc_oldspace(mf, q, k, mode = XC_MODE, Bc = 0, M = 1) =
{
  my(mf1 = mfinit([M, k], 1), B1 = mfbasis(mf1), V = []);
  if(mode == "mat",
    for(i = 1, #B1, V = concat(V, [mftobasis(mf, B1[i]), mftobasis(mf, mfbd(B1[i], q))]));
    return(if(#V == 0, matrix(mfdim(mf), 0), Mat(V))));
  for(i = 1, #B1,
    my(c = mfcoefs(B1[i], Bc));
    V = concat(V, [c, vector(Bc + 1, n, if((n-1) % q, 0, c[(n-1)/q + 1]))]));
  V;
}

\\ Coefficients (#nl x s) of a Z-basis of b = ker(T -> End(S^old)) in terms of the T_n, n in L[1].
\\ "mat":  t |-> t * Vold (matrices);
\\ "coef": t = sum c_n T_n kills S^old iff sum c_n a_n(g) = 0 for all g in S^old (as S^old is T-stable: a_n(t g) = a_1(t T_n g)).
xc_kernel_old(mf, L, Vold, mode = XC_MODE) =
{
  my(nl = L[1], C = L[2], R, Rb, K);
  if(#Vold == 0, return(C));                      \\ S^old = 0: the kernel is the whole algebra
  if(mode == "mat",
    my(mats = mfheckemat(mf, nl), r = #Vold~);
    R = matrix(r * #Vold, #nl);
    for(j = 1, #nl, my(W = mats[j]*Vold);
      for(i = 1, r * #Vold, R[i, j] = W[(i-1)%r + 1, (i-1)\r + 1])),
    R = matrix(#Vold, #nl, i, j, Vold[i][nl[j] + 1]));
  Rb = R*C; Rb = denominator(Rb)*Rb;
  K = matkerint(Rb);
  C*K;
}

\\ ord_P of the ideal of O_P generated by lambda_f(columns of bcoef), av[i] = a_{nl[i]}(f) (polmods or rationals).
xc_ordideal(nf, P, av, bcoef) =
{
  my(m = oo, x, v);
  for(j = 1, #bcoef,
    x = sum(i = 1, #av, bcoef[i, j]*av[i]);
    if(x != 0, v = nfeltval(nf, lift(x), P); if(v < m, m = v)));
  m;
}

\\ The newforms of level N, weight k: list of [field polynomial, coefficient vector a_0..a_B (a_n at index n+1)].
xc_newforms(N, k, B) =
{
  my(mfn = mfinit([N, k], 0), L, F);
  if(mfdim(mfn) == 0, return([]));
  L = mfeigenbasis(mfn); F = mffields(mfn);
  vector(#L, i, [F[i], mfcoefs(L[i], B)]);
}

\\ Eisenstein test of (f, P): a_l = 1 + l^(k-1) mod P for all primes l <= B, l not dividing N p.
xc_is_eis(nf, P, a, k, N, p, B) =
{
  forprime(l = 2, B, if(N % l && l != p,
    my(x = a[l+1] - (1 + l^(k-1))); if(x != 0 && nfeltval(nf, lift(x), P) == 0, return(0))));
  1;
}

\\ One H3 / level-qM computation: weight k, level N = q*M (default M = 1), prime p; f runs over the newforms of level N.
\\ Optional sel(nf, P, a) -> 0/1 restricts to the pairs (f, P) of interest (default: all).
\\ Returns [N, k, p, dim S_k(N), dim S^old, rank T, rank b, rank T^an, rank b^an, B, Ban, stable, stable_an, rows],
\\ rows = list of [form index, field poly, deg, P index, e, f, a_q(f), eisenstein?, ord c_q(f), t^an_f(q), diff].
xc_level_q(q, k, p, sel = 0, mode = XC_MODE, M = 1) =
{
  my(N = q*M, mf = mfinit([N, k], 1), d = mfdim(mf), B0 = mfsturm(mf) + 1, L, Lan, Vold, bc, bcan, nfs, rows = List(), Bmax);
  L = xc_hecke_lattice(mf, B0, 0, mode);
  Lan = xc_hecke_lattice(mf, B0, N*p, mode);
  Vold = xc_oldspace(mf, q, k, mode, max(vecmax(L[1]), vecmax(Lan[1])), M);
  bc = xc_kernel_old(mf, L, Vold, mode);
  bcan = xc_kernel_old(mf, Lan, Vold, mode);
  Bmax = max(max(vecmax(L[1]), vecmax(Lan[1])), max(q, B0));
  nfs = xc_newforms(N, k, Bmax);
  for(i = 1, #nfs,
    my(pol = nfs[i][1], a = nfs[i][2], nf = nfinit([pol, [p]]), Pl = idealprimedec(nf, p));
    for(j = 1, #Pl,
      my(P = Pl[j], av, avan, oc, ot, eis);
      if(type(sel) == "t_CLOSURE" && !sel(nf, P, a), next);
      av = vector(#L[1], t, a[L[1][t] + 1]);
      avan = vector(#Lan[1], t, a[Lan[1][t] + 1]);
      oc = xc_ordideal(nf, P, av, bc);
      ot = xc_ordideal(nf, P, avan, bcan);
      eis = xc_is_eis(nf, P, a, k, N, p, B0);
      listput(rows, [i, pol, poldegree(pol), j, P.e, P.f, a[q+1], eis, oc, ot, oc - ot])));
  [N, k, p, d, #Vold, #L[3], #bc, #Lan[3], #bcan, L[5], Lan[5], L[6], Lan[6], Vec(rows)];
}

\\ The four H3 triples (q, p, k).
H3_TRIPLES = [[13, 7, 4], [13, 7, 6], [19, 5, 4], [29, 5, 4]];
h3_run() = vector(#H3_TRIPLES, i, my(t = H3_TRIPLES[i]); xc_level_q(t[1], t[3], t[2]));

\\ ---------------------------------------------------------------------------------------------------------------------------
\\ p-adic variant (for larger levels, where the integral HNF of the Hecke lattice overflows). Same definitions, computed in
\\ T (x) Z_p: the coefficient realisation t |-> v(t) = (a_1(t b_i))_i embeds T in Q^d; lambda_f(t) = x_f . v(t) with
\\ f = sum x_i b_i (mftobasis); t kills S^old iff y_g . v(t) = 0 for g in a basis of S^old. Lattices are replaced by
\\ L + p^e Z^d (full rank) resp., for the anemic lattice of rank r < d, by its image under an injective coordinate projection;
\\ this is exact in (x) Z_p as long as v_p(index) < e, which is checked.
xc_rows(X, R) = vecextract(X, R, [1..#X]);
xc_padic_basis(G, p, e) =
{
  my(den = denominator(G), Gi = den*G, ri = matindexrank(Gi), R = Vec(ri[1]), Cc = Vec(ri[2]), V, A, Hp, r = #R);
  V = vecextract(Gi, [1..#Gi~], Cc);              \\ basis of the Q-span (d x r)
  A = V * matsolve(xc_rows(V, R), matid(r));      \\ lift from the R-coordinates back to the span
  Hp = mathnfmodid(xc_rows(Gi, R), p^e);
  if(valuation(matdet(Hp), p) >= e, error("xc_padic_basis: increase e"));
  [A*Hp/den, r];
}
xc_level_qp(q, k, p, M = 1, e = 40, sel = 0) =
{
  my(N = q*M, mf = mfinit([N, k], 1), d = mfdim(mf), B0 = mfsturm(mf) + 1, cf, Bc, nl, nlan, Hf, Han, Y, K, Kan, bf, ban,
     mfn = mfinit([N, k], 0), Lf, F, rows = List(), stab = [0, 0]);
  \\ generator lists; stability: the Z_p-lattice from n <= B equals that from n <= 2B
  Bc = 4*B0; cf = mfcoefs(mf, Bc);
  my(G = (L) -> matrix(d, #L, i, j, cf[L[j] + 1, i]), sl = (B, c) -> if(c, select(n -> gcd(n, c) == 1, [1..B]), [1..B]));
  my(tryB = (c) -> my(B = B0, H1, H2, fl = 0); for(it = 1, 2, H1 = xc_padic_basis(G(sl(B, c)), p, e); H2 = xc_padic_basis(G(sl(2*B, c)), p, e);
       if(H1[2] == H2[2] && xc_samelat(H1[1], H2[1], p), fl = 1; break); B *= 2);
       [H2[1], fl, 2*B]);
  my(rf = tryB(0), ra = tryB(N*p)); Hf = rf[1]; Han = ra[1]; stab = [rf[2], ra[2]];
  \\ old space coordinates (rows y_g)
  my(V = xc_oldspace(mf, q, k, "mat", 0, M));
  if(#V == 0, bf = Hf; ban = Han,
    Y = V~; K = matkerint(denominator(Y*Hf)*(Y*Hf)); bf = Hf*K;
    Kan = matkerint(denominator(Y*Han)*(Y*Han)); ban = Han*Kan);
  if(mfdim(mfn) == 0, return([N, k, p, d, #V, #Hf, #bf, #Han, #ban, rf[3], ra[3], stab[1], stab[2], []]));
  Lf = mfeigenbasis(mfn); F = mffields(mfn);
  for(i = 1, #Lf,
    my(pol = F[i], a = mfcoefs(Lf[i], max(B0, q)), x = mftobasis(mf, Lf[i]), nf = nfinit([pol, [p]]), Pl = idealprimedec(nf, p));
    for(j = 1, #Pl,
      my(P = Pl[j], oc = oo, ot = oo, eis);
      if(type(sel) == "t_CLOSURE" && !sel(nf, P, a), next);
      for(c = 1, #bf, my(z = x~ * bf[, c]); if(z != 0, oc = min(oc, nfeltval(nf, lift(z), P))));
      for(c = 1, #ban, my(z = x~ * ban[, c]); if(z != 0, ot = min(ot, nfeltval(nf, lift(z), P))));
      eis = xc_is_eis(nf, P, a, k, N, p, B0);
      listput(rows, [i, pol, poldegree(pol), j, P.e, P.f, a[q+1], eis, oc, ot, oc - ot])));
  [N, k, p, d, #V, #Hf, #bf, #Han, #ban, rf[3], ra[3], stab[1], stab[2], Vec(rows)];
}
\\ Same Z_p-lattice: each basis is a Z_p-combination of the other (spans of the same rank).
xc_samelat(H1, H2, p) =
{
  my(R1 = Vec(matindexrank(H1)[1]), R2 = Vec(matindexrank(H2)[1]), X, Z);
  X = matsolve(xc_rows(H1, R1), xc_rows(H2, R1)); Z = matsolve(xc_rows(H2, R2), xc_rows(H1, R2));
  (valuation(denominator(X), p) == 0) && (valuation(denominator(Z), p) == 0);
}

\\ Non-vacuous q = -1 mod p supplement (M > 1, S^old != 0, rho-bar unramified at q for the reported pairs); found by a search
\\ for level-M newforms g with a_q(g) = eps (q+1) q^((k-2)/2) mod P^v, v >= 1 (v >= 2 for the t >= 2 cases), g non-Eisenstein.
\\ Each entry [q, p, k, M, route]; route "int" = xc_level_q (integral HNF), "zp" = xc_level_qp (Z_p route).
H3M_CASES = [[13, 7, 4, 9, "int"], [13, 7, 6, 11, "int"], [97, 7, 2, 11, "int"], [19, 5, 2, 53, "int"], [41, 7, 2, 31, "int"], [89, 5, 2, 17, "int"], [41, 7, 4, 6, "zp"], [19, 5, 4, 18, "zp"]];
h3m_one(c) = if(c[5] == "int", xc_level_q(c[1], c[3], c[2], 0, "coef", c[4]), xc_level_qp(c[1], c[3], c[2], c[4]));
h3m_run() = vector(#H3M_CASES, i, h3m_one(H3M_CASES[i]));
