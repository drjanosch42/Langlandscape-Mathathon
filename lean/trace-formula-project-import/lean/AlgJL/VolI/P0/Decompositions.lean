open ValuativeRel GL2TF

set_option linter.unusedSectionVars false

namespace GL2TF.Local

section Generic

variable {F : Type*} [Field F]

theorem det_ne_zero (g : GL (Fin 2) F) : (g : Matrix (Fin 2) (Fin 2) F).det ≠ 0 :=
  ((Matrix.isUnit_iff_isUnit_det _).mp g.isUnit).ne_zero

variable [ValuativeRel F]

theorem v_ne_zero {x : F} (hx : x ≠ 0) : valuation F x ≠ 0 := (Valuation.ne_zero_iff _).mpr hx

theorem v_unit (u : 𝒪[F]ˣ) : valuation F ((u : 𝒪[F]) : F) = 1 :=
  (Valuation.integer.integers (valuation F)).valuation_unit u

theorem exists_unit_of_v_eq_one (x : F) (hx : valuation F x = 1) : ∃ u : 𝒪[F]ˣ, x = ((u : 𝒪[F]) : F) := by
  have hmem : x ∈ 𝒪[F] := (Valuation.mem_integer_iff _ _).mpr hx.le
  have hu : IsUnit (⟨x, hmem⟩ : 𝒪[F]) :=
    (Valuation.integer.integers (valuation F)).isUnit_iff_valuation_eq_one.mpr hx
  exact ⟨hu.unit, rfl⟩

theorem exists_unit_of_v_eq (x y : F) (hy : y ≠ 0) (h : valuation F x = valuation F y) :
    ∃ u : 𝒪[F]ˣ, x = y * ((u : 𝒪[F]) : F) := by
  obtain ⟨u, hu⟩ := exists_unit_of_v_eq_one (x / y)
    (by rw [map_div₀, h, div_self (v_ne_zero hy)])
  exact ⟨u, by rw [← hu]; field_simp⟩

/-- Membership in `K_F` through valuations: entries in `𝒪_F` and determinant a unit. -/
theorem mem_K_iff (g : GL (Fin 2) F) :
    g ∈ 𝐊[F] ↔ (∀ i j, valuation F ((g : Matrix (Fin 2) (Fin 2) F) i j) ≤ 1) ∧
      valuation F (g : Matrix (Fin 2) (Fin 2) F).det = 1 := by
  refine ((mem_maxCompact_tfae (Subring.subtype (Valuation.integer (valuation F)))
    (Subring.subtype_injective _) g).out 1 2).trans ?_
  constructor
  · rintro ⟨h, u, hu⟩
    refine ⟨fun i j => ?_, ?_⟩
    · obtain ⟨r, hr⟩ := h i j
      have hr' : (r : F) = (g : Matrix (Fin 2) (Fin 2) F) i j := hr
      rw [← hr']
      exact (Valuation.mem_integer_iff _ _).mp r.2
    · rw [hu]
      exact v_unit u
  · rintro ⟨h, hdet⟩
    refine ⟨fun i j => ⟨⟨_, (Valuation.mem_integer_iff _ _).mpr (h i j)⟩, rfl⟩, ?_⟩
    obtain ⟨u, hu⟩ := exists_unit_of_v_eq_one _ hdet
    exact ⟨u, hu⟩

theorem mkOfDetNeZero_mem_K (A : Matrix (Fin 2) (Fin 2) F) (hA : A.det ≠ 0)
    (h : ∀ i j, valuation F (A i j) ≤ 1) (hdet : valuation F A.det = 1) :
    Matrix.GeneralLinearGroup.mkOfDetNeZero A hA ∈ 𝐊[F] :=
  (mem_K_iff _).mpr ⟨by simpa using h, by simpa using hdet⟩

theorem exists_unit_iff_v_eq (x y : F) (hy : y ≠ 0) :
    (∃ u : 𝒪[F]ˣ, x = y * ((u : 𝒪[F]) : F)) ↔ valuation F x = valuation F y := by
  constructor
  · rintro ⟨u, rfl⟩
    rw [map_mul, v_unit, mul_one]
  · exact exists_unit_of_v_eq x y hy

end Generic

variable (F : Type*) [Field F] [ValuativeRel F] [TopologicalSpace F] [IsNALF F]

/-- The maximal ideal of `𝒪[F]` is generated by `ϖ_F` (the defining property of `unif`). -/
@[tf_aux "I.cartan.lem:maximal-ideal-eq-span-unif"]
theorem maximalIdeal_eq_span_unif : 𝓂[F] = Ideal.span {unif F} := by
  unfold unif
  exact Classical.choose_spec (p := fun ϖ : 𝒪[F] => 𝓂[F] = Ideal.span {ϖ}) _

/-- `ϖ_F ≠ 0` in `F`. -/
@[tf_aux "I.cartan.lem:unif-ne-zero"]
theorem unif_ne_zero : ((unif F : 𝒪[F]) : F) ≠ 0 := by
  intro h
  apply IsDiscreteValuationRing.not_a_field (R := 𝒪[F])
  rw [maximalIdeal_eq_span_unif, Ideal.span_singleton_eq_bot]
  exact Subtype.ext h

/-- `ϖ_F` as an element of `F` (local notation). -/
local notation "ϖ" => ((unif F : 𝒪[F]) : F)

section Toolkit

variable {F}

theorem v_unif_pos : 0 < valuation F ϖ :=
  zero_lt_iff.mpr ((Valuation.ne_zero_iff _).mpr (unif_ne_zero F))

theorem v_unif_lt_one : valuation F ϖ < 1 :=
  (Valuation.integer.integers (valuation F)).valuation_irreducible_lt_one (irreducible_unif F)

theorem v_zpow_le_iff {m n : ℤ} : valuation F (ϖ ^ m) ≤ valuation F (ϖ ^ n) ↔ n ≤ m := by
  rw [map_zpow₀, map_zpow₀]
  exact zpow_le_zpow_iff_right_of_lt_one₀ v_unif_pos v_unif_lt_one

theorem v_zpow_inj {m n : ℤ} : valuation F (ϖ ^ m) = valuation F (ϖ ^ n) ↔ m = n := by
  rw [le_antisymm_iff, v_zpow_le_iff, v_zpow_le_iff, le_antisymm_iff, and_comm]

theorem v_zpow_le_one_iff {n : ℤ} : valuation F (ϖ ^ n) ≤ 1 ↔ 0 ≤ n := by
  simpa using v_zpow_le_iff (F := F) (m := n) (n := 0)

theorem v_zpow_eq_one_iff {n : ℤ} : valuation F (ϖ ^ n) = 1 ↔ n = 0 := by
  simpa using v_zpow_inj (F := F) (m := n) (n := 0)

theorem exists_v_eq_zpow (x : F) (hx : x ≠ 0) : ∃ n : ℤ, valuation F x = valuation F (ϖ ^ n) := by
  obtain ⟨⟨u, n⟩, h, -⟩ := unit_uniformizer_decomposition F x hx
  exact ⟨n, by rw [h, map_mul, v_unit, one_mul]⟩

end Toolkit

/-- Local Iwasawa decomposition: every `g ∈ GL₂(F)` is `b k` with `k ∈ K_F` and `b` upper triangular. -/
@[tf_id "I.decomp.thm:iwasawa-local"]
theorem iwasawa_local (g : GL (Fin 2) F) :
    ∃ b k : GL (Fin 2) F, k ∈ 𝐊[F] ∧ (b : Matrix (Fin 2) (Fin 2) F) 1 0 = 0 ∧ g = b * k := by
  obtain ⟨e, β, γ, δ, hg⟩ : ∃ e β γ δ : F, (g : Matrix (Fin 2) (Fin 2) F) = !![e, β; γ, δ] :=
    ⟨_, _, _, _, Matrix.eta_fin_two _⟩
  have hdet := det_ne_zero g
  rw [hg, Matrix.det_fin_two_of] at hdet
  suffices ∃ k ∈ 𝐊[F], ((g * k : GL (Fin 2) F) : Matrix (Fin 2) (Fin 2) F) 1 0 = 0 by
    obtain ⟨k, hk, h⟩ := this
    exact ⟨g * k, k⁻¹, inv_mem hk, h, by group⟩
  by_cases hc : δ ≠ 0 ∧ valuation F γ ≤ valuation F δ
  · refine ⟨Matrix.GeneralLinearGroup.mkOfDetNeZero !![1, 0; -(γ / δ), 1]
      (by simp [Matrix.det_fin_two_of]), mkOfDetNeZero_mem_K _ _ ?_ (by simp [Matrix.det_fin_two_of]), ?_⟩
    · simp [Fin.forall_fin_two, div_le_one₀ (zero_lt_iff.mpr (v_ne_zero hc.1)), hc.2]
    · rw [Units.val_mul, hg, Matrix.GeneralLinearGroup.val_mkOfDetNeZero, Matrix.mul_fin_two]
      simp
      field_simp [hc.1]
      ring
  · have hγ : γ ≠ 0 := by
      rintro rfl
      by_cases hδ : δ = 0
      · simp [hδ] at hdet
      · exact hc ⟨hδ, by simp⟩
    have hδγ : valuation F δ ≤ valuation F γ := by
      by_cases hδ : δ = 0
      · simp [hδ]
      · exact (lt_of_not_ge fun h => hc ⟨hδ, h⟩).le
    refine ⟨Matrix.GeneralLinearGroup.mkOfDetNeZero !![-(δ / γ), 1; 1, 0]
      (by simp [Matrix.det_fin_two_of]), mkOfDetNeZero_mem_K _ _ ?_ (by simp [Matrix.det_fin_two_of]), ?_⟩
    · simp [Fin.forall_fin_two, div_le_one₀ (zero_lt_iff.mpr (v_ne_zero hγ)), hδγ]
    · rw [Units.val_mul, hg, Matrix.GeneralLinearGroup.val_mkOfDetNeZero, Matrix.mul_fin_two]
      simp
      field_simp [hγ]
      ring

/-- The Cartan element `t_{a,b} = diag(ϖ^a, ϖ^b) ∈ GL₂(F)`, `a b ∈ ℤ`. -/
@[tf_id "I.cartan.def:cartan-element"]
noncomputable def cartanElement (a b : ℤ) : GL (Fin 2) F where
  val := Matrix.diagonal ![((unif F : 𝒪[F]) : F) ^ a, ((unif F : 𝒪[F]) : F) ^ b]
  inv := Matrix.diagonal ![((unif F : 𝒪[F]) : F) ^ (-a), ((unif F : 𝒪[F]) : F) ^ (-b)]
  val_inv := by
    rw [Matrix.diagonal_mul_diagonal, ← Matrix.diagonal_one]
    congr 1
    ext i
    fin_cases i <;> simp [zpow_ne_zero _ (unif_ne_zero F)]
  inv_val := by
    rw [Matrix.diagonal_mul_diagonal, ← Matrix.diagonal_one]
    congr 1
    ext i
    fin_cases i <;> simp [zpow_ne_zero _ (unif_ne_zero F)]

/-- The matrix of `t_{a,b}` (proof helper). -/
theorem cartanElement_val (a b : ℤ) :
    ((cartanElement F a b : GL (Fin 2) F) : Matrix (Fin 2) (Fin 2) F) =
      !![((unif F : 𝒪[F]) : F) ^ a, 0; 0, ((unif F : 𝒪[F]) : F) ^ b] := by
  ext i j
  fin_cases i <;> fin_cases j <;> simp [cartanElement]

section CartanExists

variable {F}

/-- Existence of the Cartan decomposition when the `(0,0)` entry has maximal valuation. -/
theorem cartan_exists_core (g : GL (Fin 2) F) (e β γ δ : F)
    (hg : (g : Matrix (Fin 2) (Fin 2) F) = !![e, β; γ, δ]) (h0 : e ≠ 0)
    (hβ : valuation F β ≤ valuation F e) (hγ : valuation F γ ≤ valuation F e)
    (hδ : valuation F δ ≤ valuation F e) :
    ∃ a b : ℤ, b ≤ a ∧ g ∈ DoubleCoset.doubleCoset (cartanElement F a b) 𝐊[F] 𝐊[F] := by
  have hdet : e * (δ - γ * (β / e)) ≠ 0 := by
    have := det_ne_zero g
    rw [hg, Matrix.det_fin_two_of] at this
    field_simp
    rwa [mul_comm γ β]
  have hy0 : δ - γ * (β / e) ≠ 0 := right_ne_zero_of_mul hdet
  obtain ⟨⟨u, m⟩, hu, -⟩ := unit_uniformizer_decomposition F e h0
  obtain ⟨⟨u', m'⟩, hu', -⟩ := unit_uniformizer_decomposition F _ hy0
  simp only at hu hu'
  have hvy : valuation F (δ - γ * (β / e)) ≤ valuation F e := by
    refine (Valuation.map_sub _ _ _).trans (max_le hδ ?_)
    rw [map_mul, map_div₀, mul_div_assoc', div_le_iff₀ (zero_lt_iff.mpr (v_ne_zero h0))]
    exact mul_le_mul' hγ hβ
  have hmm : m ≤ m' := by
    rw [hu', hu, map_mul, map_mul, v_unit, v_unit, one_mul, one_mul] at hvy
    exact v_zpow_le_iff.mp hvy
  refine ⟨m', m, hmm, ?_⟩
  have hk1 : (!![0, ((u : 𝒪[F]) : F); ((u' : 𝒪[F]) : F), γ / e * ((u : 𝒪[F]) : F)] :
      Matrix (Fin 2) (Fin 2) F).det ≠ 0 := by
    simp [Matrix.det_fin_two_of]
  have hk2 : (!![0, 1; 1, β / e] : Matrix (Fin 2) (Fin 2) F).det ≠ 0 := by
    simp [Matrix.det_fin_two_of]
  have hγe : valuation F γ / valuation F e ≤ 1 := by
    rw [div_le_one₀ (zero_lt_iff.mpr (v_ne_zero h0))]; exact hγ
  have hβe : valuation F β / valuation F e ≤ 1 := by
    rw [div_le_one₀ (zero_lt_iff.mpr (v_ne_zero h0))]; exact hβ
  rw [DoubleCoset.mem_doubleCoset]
  refine ⟨Matrix.GeneralLinearGroup.mkOfDetNeZero _ hk1, ?_,
    Matrix.GeneralLinearGroup.mkOfDetNeZero _ hk2, ?_, ?_⟩
  · refine mkOfDetNeZero_mem_K _ _ ?_ ?_
    · simp [Fin.forall_fin_two, v_unit, hγe]
    · simp [Matrix.det_fin_two_of, v_unit]
  · refine mkOfDetNeZero_mem_K _ _ ?_ ?_
    · simp [Fin.forall_fin_two, hβe]
    · simp [Matrix.det_fin_two_of]
  · apply Units.ext
    rw [Units.val_mul, Units.val_mul, Matrix.GeneralLinearGroup.val_mkOfDetNeZero,
      Matrix.GeneralLinearGroup.val_mkOfDetNeZero, cartanElement_val, hg]
    have hϖ : ((unif F : 𝒪[F]) : F) ^ m ≠ 0 := zpow_ne_zero _ (unif_ne_zero F)
    have hu0 : ((u : 𝒪[F]) : F) ≠ 0 := by simp
    rw [Matrix.mul_fin_two, Matrix.mul_fin_two]
    subst hu
    have hδ' : δ = ((u' : 𝒪[F]) : F) * ((unif F : 𝒪[F]) : F) ^ m' +
        γ * (β / (((u : 𝒪[F]) : F) * ((unif F : 𝒪[F]) : F) ^ m)) := by
      rw [← hu']; ring
    subst hδ'
    ext i j
    fin_cases i <;> fin_cases j <;> simp <;> field_simp
    all_goals first | ring1 | simp

/-- The swap `s = (0 1; 1 0)`. -/
noncomputable def cartanSwap : GL (Fin 2) F :=
  Matrix.GeneralLinearGroup.mkOfDetNeZero !![0, 1; 1, 0] (by simp [Matrix.det_fin_two_of])

theorem cartanSwap_val : ((cartanSwap : GL (Fin 2) F) : Matrix (Fin 2) (Fin 2) F) = !![0, 1; 1, 0] :=
  Matrix.GeneralLinearGroup.val_mkOfDetNeZero _ _

theorem cartanSwap_mem : (cartanSwap : GL (Fin 2) F) ∈ 𝐊[F] :=
  mkOfDetNeZero_mem_K _ _ (by simp [Fin.forall_fin_two]) (by simp [Matrix.det_fin_two_of])

theorem mem_doubleCoset_of_mul {k₁ k₂ g t : GL (Fin 2) F} (hk₁ : k₁ ∈ 𝐊[F]) (hk₂ : k₂ ∈ 𝐊[F])
    (h : k₁ * g * k₂ ∈ DoubleCoset.doubleCoset t 𝐊[F] 𝐊[F]) :
    g ∈ DoubleCoset.doubleCoset t 𝐊[F] 𝐊[F] := by
  obtain ⟨x, hx, y, hy, hxy⟩ := DoubleCoset.mem_doubleCoset.mp h
  refine DoubleCoset.mem_doubleCoset.mpr ⟨k₁⁻¹ * x, mul_mem (inv_mem hk₁) hx, y * k₂⁻¹,
    mul_mem hy (inv_mem hk₂), ?_⟩
  calc g = k₁⁻¹ * (k₁ * g * k₂) * k₂⁻¹ := by group
    _ = _ := by rw [hxy]; group

end CartanExists

/-- Existence of the Cartan decomposition: `g ∈ K_F t_{a,b} K_F` for some integers `a ≥ b`. -/
@[tf_id "I.cartan.lem:cartan-exists"]
theorem cartan_exists (g : GL (Fin 2) F) :
    ∃ a b : ℤ, b ≤ a ∧ g ∈ DoubleCoset.doubleCoset (cartanElement F a b) 𝐊[F] 𝐊[F] := by
  obtain ⟨e, β, γ, δ, hg⟩ : ∃ e β γ δ : F, (g : Matrix (Fin 2) (Fin 2) F) = !![e, β; γ, δ] :=
    ⟨_, _, _, _, Matrix.eta_fin_two _⟩
  have hdet := det_ne_zero g
  rw [hg, Matrix.det_fin_two_of] at hdet
  obtain ⟨⟨i, j⟩, hij⟩ := Finite.exists_max
    (fun ij : Fin 2 × Fin 2 => valuation F ((!![e, β; γ, δ] : Matrix (Fin 2) (Fin 2) F) ij.1 ij.2))
  simp only [Prod.forall, Fin.forall_fin_two] at hij
  have hne : ∀ x : F, valuation F e ≤ valuation F x → valuation F β ≤ valuation F x →
      valuation F γ ≤ valuation F x → valuation F δ ≤ valuation F x → x ≠ 0 := by
    rintro x h1 h2 h3 h4 rfl
    simp only [map_zero, le_zero_iff, Valuation.zero_iff] at h1 h2 h3 h4
    subst h1 h2 h3 h4
    simp at hdet
  have hs := cartanSwap_mem (F := F)
  fin_cases i <;> fin_cases j <;>
    simp only [Matrix.of_apply, Matrix.cons_val', Matrix.cons_val_zero, Matrix.cons_val_one,
      Matrix.empty_val', Matrix.cons_val_fin_one, Fin.isValue, Fin.zero_eta, Fin.mk_one] at hij
  · exact cartan_exists_core g e β γ δ hg (hne e hij.1.1 hij.1.2 hij.2.1 hij.2.2)
      hij.1.2 hij.2.1 hij.2.2
  · obtain ⟨a, b, hab, h⟩ := cartan_exists_core (g * cartanSwap) β e δ γ
      (by rw [Units.val_mul, hg, cartanSwap_val, Matrix.mul_fin_two]; simp)
      (hne β hij.1.1 hij.1.2 hij.2.1 hij.2.2) hij.1.1 hij.2.2 hij.2.1
    exact ⟨a, b, hab, mem_doubleCoset_of_mul (one_mem _) hs (by rwa [one_mul])⟩
  · obtain ⟨a, b, hab, h⟩ := cartan_exists_core (cartanSwap * g) γ δ e β
      (by rw [Units.val_mul, hg, cartanSwap_val, Matrix.mul_fin_two]; simp)
      (hne γ hij.1.1 hij.1.2 hij.2.1 hij.2.2) hij.2.2 hij.1.1 hij.1.2
    exact ⟨a, b, hab, mem_doubleCoset_of_mul hs (one_mem _) (by rwa [mul_one])⟩
  · obtain ⟨a, b, hab, h⟩ := cartan_exists_core (cartanSwap * g * cartanSwap) δ γ β e
      (by rw [Units.val_mul, Units.val_mul, hg, cartanSwap_val, Matrix.mul_fin_two,
        Matrix.mul_fin_two]; simp)
      (hne δ hij.1.1 hij.1.2 hij.2.1 hij.2.2) hij.2.1 hij.1.2 hij.1.1
    exact ⟨a, b, hab, mem_doubleCoset_of_mul hs hs h⟩

/-- The `𝒪_F`-submodule `I(g)` of `F` generated by the entries of `g` (proof helper). -/
noncomputable def entrySpan (g : GL (Fin 2) F) : Submodule 𝒪[F] F :=
  Submodule.span 𝒪[F] (Set.range fun ij : Fin 2 × Fin 2 => (g : Matrix (Fin 2) (Fin 2) F) ij.1 ij.2)

/-- `I(g)`: the `𝒪_F`-submodule generated by the entries of `g` (local notation; see `entrySpan`). -/
local notation "𝓘(" g ")" => entrySpan F g

section CartanInvariants

variable {F}

/-- `x ∈ 𝒪_F c` iff `v(x) ≤ v(c)`, for `c ≠ 0`. -/
theorem mem_span_singleton_iff_v {c : F} (hc : c ≠ 0) (x : F) :
    x ∈ Submodule.span 𝒪[F] {c} ↔ valuation F x ≤ valuation F c := by
  rw [Submodule.mem_span_singleton]
  constructor
  · rintro ⟨a, rfl⟩
    change valuation F ((a : F) * c) ≤ _
    rw [map_mul]
    exact mul_le_of_le_one_left' ((Valuation.mem_integer_iff _ _).mp a.2)
  · intro h
    refine ⟨⟨x / c, (Valuation.mem_integer_iff _ _).mpr ?_⟩, ?_⟩
    · rw [map_div₀, div_le_one₀ (zero_lt_iff.mpr (v_ne_zero hc))]; exact h
    · change x / c * c = x
      field_simp

theorem mul_mem_span {S : Submodule 𝒪[F] F} {a x : F} (ha : valuation F a ≤ 1) (hx : x ∈ S) :
    a * x ∈ S :=
  S.smul_mem (⟨a, (Valuation.mem_integer_iff _ _).mpr ha⟩ : 𝒪[F]) hx

theorem mem_span_mul {S : Submodule 𝒪[F] F} {a x : F} (ha : valuation F a ≤ 1) (hx : x ∈ S) :
    x * a ∈ S := by
  rw [mul_comm]; exact mul_mem_span ha hx

theorem entrySpan_mul_le {k₁ k₂ : GL (Fin 2) F} (hk₁ : k₁ ∈ 𝐊[F]) (hk₂ : k₂ ∈ 𝐊[F]) (g : GL (Fin 2) F) :
    𝓘(k₁ * g * k₂) ≤ 𝓘(g) := by
  have h₁ := ((mem_K_iff k₁).mp hk₁).1
  have h₂ := ((mem_K_iff k₂).mp hk₂).1
  have hg : ∀ i j, ((g : GL (Fin 2) F) : Matrix (Fin 2) (Fin 2) F) i j ∈ 𝓘(g) :=
    fun i j => Submodule.subset_span ⟨(i, j), rfl⟩
  rw [entrySpan, Submodule.span_le]
  rintro _ ⟨⟨i, j⟩, rfl⟩
  simp only [Units.val_mul, Matrix.mul_apply, Fin.sum_univ_two]
  exact add_mem (mem_span_mul (h₂ _ _) (add_mem (mul_mem_span (h₁ _ _) (hg _ _))
      (mul_mem_span (h₁ _ _) (hg _ _))))
    (mem_span_mul (h₂ _ _) (add_mem (mul_mem_span (h₁ _ _) (hg _ _)) (mul_mem_span (h₁ _ _) (hg _ _))))

theorem invariants_of_mem {g t : GL (Fin 2) F} (h : g ∈ DoubleCoset.doubleCoset t 𝐊[F] 𝐊[F]) :
    𝓘(g) = 𝓘(t) ∧ valuation F (g : Matrix (Fin 2) (Fin 2) F).det =
      valuation F (t : Matrix (Fin 2) (Fin 2) F).det := by
  obtain ⟨k₁, hk₁, k₂, hk₂, rfl⟩ := DoubleCoset.mem_doubleCoset.mp h
  refine ⟨le_antisymm (entrySpan_mul_le hk₁ hk₂ t) ?_, ?_⟩
  · have := entrySpan_mul_le (inv_mem hk₁) (inv_mem hk₂) (k₁ * t * k₂)
    rwa [show k₁⁻¹ * (k₁ * t * k₂) * k₂⁻¹ = t by group] at this
  · rw [Units.val_mul, Units.val_mul, Matrix.det_mul, Matrix.det_mul, map_mul, map_mul,
      ((mem_K_iff k₁).mp hk₁).2, ((mem_K_iff k₂).mp hk₂).2, one_mul, mul_one]

theorem entrySpan_cartanElement {a b : ℤ} (hab : b ≤ a) :
    𝓘(cartanElement F a b) = Submodule.span 𝒪[F] {ϖ ^ b} := by
  have hϖ : ϖ ^ b ≠ 0 := zpow_ne_zero _ (unif_ne_zero F)
  apply le_antisymm
  · rw [entrySpan, Submodule.span_le]
    rintro _ ⟨⟨i, j⟩, rfl⟩
    rw [SetLike.mem_coe, mem_span_singleton_iff_v hϖ, cartanElement_val]
    have hv : valuation F ϖ ^ a ≤ valuation F ϖ ^ b := by
      simpa only [map_zpow₀] using (v_zpow_le_iff (F := F)).mpr hab
    fin_cases i <;> fin_cases j <;> simp [hv]
  · rw [Submodule.span_le, Set.singleton_subset_iff]
    unfold entrySpan
    exact Submodule.subset_span ⟨(1, 1), by simp [cartanElement_val]⟩

theorem det_cartanElement (a b : ℤ) :
    ((cartanElement F a b : GL (Fin 2) F) : Matrix (Fin 2) (Fin 2) F).det = ϖ ^ (a + b) := by
  rw [cartanElement_val, Matrix.det_fin_two_of, zpow_add₀ (unif_ne_zero F)]
  ring

theorem eq_of_invariants {a b a' b' : ℤ}
    (h₁ : Submodule.span 𝒪[F] {ϖ ^ b} = Submodule.span 𝒪[F] {ϖ ^ b'})
    (h₂ : valuation F (ϖ ^ (a + b)) = valuation F (ϖ ^ (a' + b'))) : a = a' ∧ b = b' := by
  have hϖ : ∀ n : ℤ, ϖ ^ n ≠ 0 := fun n => zpow_ne_zero _ (unif_ne_zero F)
  have hb : b = b' := by
    have h1 : ϖ ^ b ∈ Submodule.span 𝒪[F] {ϖ ^ b'} := h₁ ▸ Submodule.mem_span_singleton_self _
    have h2 : ϖ ^ b' ∈ Submodule.span 𝒪[F] {ϖ ^ b} := h₁ ▸ Submodule.mem_span_singleton_self _
    rw [mem_span_singleton_iff_v (hϖ _), v_zpow_le_iff] at h1 h2
    omega
  subst hb
  have := (v_zpow_inj (F := F)).mp h₂
  exact ⟨by omega, rfl⟩

end CartanInvariants

/-- Invariants of the Cartan double cosets: for `a ≥ b`, `g ∈ K_F t_{a,b} K_F` iff the `𝒪_F`-submodule of `F`
generated by the entries of `g` is `ϖ^b 𝒪_F` and `det g ∈ ϖ^{a+b} 𝒪_F^×`. -/
@[tf_id "I.cartan.lem:cartan-invariants"]
theorem cartan_invariants (a b : ℤ) (hab : b ≤ a) (g : GL (Fin 2) F) :
    g ∈ DoubleCoset.doubleCoset (cartanElement F a b) 𝐊[F] 𝐊[F] ↔
      (Submodule.span 𝒪[F] (Set.range fun ij : Fin 2 × Fin 2 => (g : Matrix (Fin 2) (Fin 2) F) ij.1 ij.2) =
          Submodule.span 𝒪[F] {((unif F : 𝒪[F]) : F) ^ b} ∧
        ∃ u : 𝒪[F]ˣ, (g : Matrix (Fin 2) (Fin 2) F).det = ((unif F : 𝒪[F]) : F) ^ (a + b) * ((u : 𝒪[F]) : F)) := by
  have hϖ : ∀ n : ℤ, ϖ ^ n ≠ 0 := fun n => zpow_ne_zero _ (unif_ne_zero F)
  have fwd : ∀ a b : ℤ, b ≤ a → g ∈ DoubleCoset.doubleCoset (cartanElement F a b) 𝐊[F] 𝐊[F] →
      𝓘(g) = Submodule.span 𝒪[F] {ϖ ^ b} ∧
        valuation F (g : Matrix (Fin 2) (Fin 2) F).det = valuation F (ϖ ^ (a + b)) := by
    intro a b hab h
    obtain ⟨h1, h2⟩ := invariants_of_mem h
    rw [entrySpan] at h1
    exact ⟨h1.trans (entrySpan_cartanElement hab), h2.trans (by rw [det_cartanElement])⟩
  change _ ↔ 𝓘(g) = _ ∧ _
  rw [exists_unit_iff_v_eq _ _ (hϖ _)]
  refine ⟨fwd a b hab, fun ⟨h1, h2⟩ => ?_⟩
  obtain ⟨a', b', hab', h'⟩ := cartan_exists F g
  obtain ⟨h1', h2'⟩ := fwd a' b' hab' h'
  obtain ⟨rfl, rfl⟩ := eq_of_invariants (h1'.symm.trans h1) (h2'.symm.trans h2)
  exact h'

/-- Uniqueness of the Cartan decomposition: `K_F t_{a,b} K_F = K_F t_{a',b'} K_F` with `a ≥ b`, `a' ≥ b'` implies
`(a, b) = (a', b')`. -/
@[tf_id "I.cartan.lem:cartan-unique"]
theorem cartan_unique (a b a' b' : ℤ) (hab : b ≤ a) (hab' : b' ≤ a')
    (h : DoubleCoset.doubleCoset (cartanElement F a b) 𝐊[F] 𝐊[F] =
      DoubleCoset.doubleCoset (cartanElement F a' b') 𝐊[F] 𝐊[F]) :
    (a, b) = (a', b') := by
  have hmem : cartanElement F a' b' ∈ DoubleCoset.doubleCoset (cartanElement F a b) 𝐊[F] 𝐊[F] :=
    h ▸ DoubleCoset.mem_doubleCoset_self _ _ _
  obtain ⟨h1, h2⟩ := invariants_of_mem hmem
  rw [entrySpan_cartanElement hab, entrySpan_cartanElement hab', det_cartanElement,
    det_cartanElement] at *
  obtain ⟨rfl, rfl⟩ := eq_of_invariants h1.symm h2.symm
  rfl

/-- Cartan decomposition: every `g ∈ GL₂(F)` lies in `K_F t_{a,b} K_F` for exactly one pair `(a, b)` with
`a ≥ b`. -/
@[tf_id "I.cartan.thm:cartan-decomposition"]
theorem cartan_decomposition (g : GL (Fin 2) F) :
    ∃! p : ℤ × ℤ, p.2 ≤ p.1 ∧ g ∈ DoubleCoset.doubleCoset (cartanElement F p.1 p.2) 𝐊[F] 𝐊[F] := by
  obtain ⟨a, b, hab, hg⟩ := cartan_exists F g
  refine ⟨(a, b), ⟨hab, hg⟩, ?_⟩
  rintro ⟨a', b'⟩ ⟨hab', hg'⟩
  exact cartan_unique F a' b' a b hab' hab
    (by rw [← DoubleCoset.doubleCoset_eq_of_mem hg', DoubleCoset.doubleCoset_eq_of_mem hg])

section CosetCount

variable {F}

/-! ### Normal forms of left cosets (for the coset count) -/

theorem v_zpow_le_one_iff' {n : ℤ} : valuation F ϖ ^ n ≤ 1 ↔ 0 ≤ n := by
  rw [← map_zpow₀]; exact v_zpow_le_one_iff

theorem v_zpow_eq_one_iff' {n : ℤ} : valuation F ϖ ^ n = 1 ↔ n = 0 := by
  rw [← map_zpow₀]; exact v_zpow_eq_one_iff

/-- `h(α, β, x) = (ϖ^α x; 0 ϖ^β)`. -/
noncomputable def hmat (α β : ℤ) (x : F) : GL (Fin 2) F :=
  Matrix.GeneralLinearGroup.mkOfDetNeZero !![ϖ ^ α, x; 0, ϖ ^ β]
    (by simp [Matrix.det_fin_two_of, zpow_ne_zero _ (unif_ne_zero F)])

theorem hmat_val (α β : ℤ) (x : F) :
    ((hmat α β x : GL (Fin 2) F) : Matrix (Fin 2) (Fin 2) F) = !![ϖ ^ α, x; 0, ϖ ^ β] :=
  Matrix.GeneralLinearGroup.val_mkOfDetNeZero _ _

/-- Step 1: every left coset `gK` is `h(α, β, x) K`. -/
theorem exists_hmat (g : GL (Fin 2) F) :
    ∃ α β : ℤ, ∃ x : F, (g : GL (Fin 2) F ⧸ 𝐊[F]) = (hmat α β x : GL (Fin 2) F ⧸ 𝐊[F]) := by
  obtain ⟨b, k, hk, hb, rfl⟩ := iwasawa_local F g
  obtain ⟨e, x, d, hbm⟩ : ∃ e x d : F, (b : Matrix (Fin 2) (Fin 2) F) = !![e, x; 0, d] :=
    ⟨_, _, _, by rw [← hb]; exact Matrix.eta_fin_two _⟩
  have hdet := det_ne_zero b
  rw [hbm, Matrix.det_fin_two_of, mul_zero, sub_zero] at hdet
  obtain ⟨⟨u₁, α⟩, hu₁, -⟩ := unit_uniformizer_decomposition F e (left_ne_zero_of_mul hdet)
  obtain ⟨⟨u₂, β⟩, hu₂, -⟩ := unit_uniformizer_decomposition F d (right_ne_zero_of_mul hdet)
  simp only at hu₁ hu₂
  subst hu₁ hu₂
  have hu₁0 : ((u₁ : 𝒪[F]) : F) ≠ 0 := by simp
  have hu₂0 : ((u₂ : 𝒪[F]) : F) ≠ 0 := by simp
  refine ⟨α, β, x * ((u₂ : 𝒪[F]) : F)⁻¹, ?_⟩
  set D : GL (Fin 2) F := Matrix.GeneralLinearGroup.mkOfDetNeZero
    !![((u₁ : 𝒪[F]) : F)⁻¹, 0; 0, ((u₂ : 𝒪[F]) : F)⁻¹] (by simp [Matrix.det_fin_two_of])
  have hD : D ∈ 𝐊[F] := mkOfDetNeZero_mem_K _ _ (by simp [Fin.forall_fin_two, v_unit])
    (by simp [Matrix.det_fin_two_of, v_unit])
  have hbD : hmat α β (x * ((u₂ : 𝒪[F]) : F)⁻¹) = b * D := by
    apply Units.ext
    rw [Units.val_mul, hmat_val, hbm, Matrix.GeneralLinearGroup.val_mkOfDetNeZero, Matrix.mul_fin_two]
    ext i j
    fin_cases i <;> fin_cases j <;> simp <;> field_simp
  rw [QuotientGroup.mk_mul_of_mem _ hk, hbD, QuotientGroup.mk_mul_of_mem _ hD]

/-- Step 2: equality of normal forms. -/
theorem hmat_mk_eq_iff (α β α' β' : ℤ) (x x' : F) :
    (hmat α β x : GL (Fin 2) F ⧸ 𝐊[F]) = (hmat α' β' x' : GL (Fin 2) F ⧸ 𝐊[F]) ↔
      α = α' ∧ β = β' ∧ valuation F (x' - x) ≤ valuation F (ϖ ^ α) := by
  have hϖ : ∀ n : ℤ, ϖ ^ n ≠ 0 := fun n => zpow_ne_zero _ (unif_ne_zero F)
  rw [QuotientGroup.eq]
  constructor
  · intro hk
    set k := (hmat α β x)⁻¹ * hmat α' β' x' with hkdef
    have hkeq : hmat α' β' x' = hmat α β x * k := by rw [hkdef]; group
    obtain ⟨hent, hdet⟩ := (mem_K_iff k).mp hk
    obtain ⟨k₀₀, k₀₁, k₁₀, k₁₁, hkm⟩ : ∃ a b c d : F, (k : Matrix (Fin 2) (Fin 2) F) = !![a, b; c, d] :=
      ⟨_, _, _, _, Matrix.eta_fin_two _⟩
    have hM := congrArg Units.val hkeq
    rw [Units.val_mul, hmat_val, hmat_val, hkm, Matrix.mul_fin_two] at hM
    have e00 := congrFun (congrFun hM 0) 0
    have e01 := congrFun (congrFun hM 0) 1
    have e10 := congrFun (congrFun hM 1) 0
    have e11 := congrFun (congrFun hM 1) 1
    simp only [Matrix.of_apply, Matrix.cons_val', Matrix.cons_val_zero, Matrix.cons_val_one,
      Matrix.empty_val', Matrix.cons_val_fin_one, Fin.isValue, zero_mul, zero_add] at e00 e01 e10 e11
    have hk10 : k₁₀ = 0 := by
      rcases mul_eq_zero.mp e10.symm with h | h
      · exact absurd h (hϖ β)
      · exact h
    subst hk10
    simp only [mul_zero, add_zero] at e00 e01
    rw [hkm] at hent hdet
    simp only [Fin.forall_fin_two, Matrix.of_apply, Matrix.cons_val', Matrix.cons_val_zero,
      Matrix.cons_val_one, Matrix.empty_val', Matrix.cons_val_fin_one, Fin.isValue] at hent
    rw [Matrix.det_fin_two_of, mul_zero, sub_zero, map_mul] at hdet
    have hα : α ≤ α' := by
      rw [← v_zpow_le_iff (F := F), e00, map_mul]
      exact mul_le_of_le_one_right' hent.1.1
    have hβ : β ≤ β' := by
      rw [← v_zpow_le_iff (F := F), e11, map_mul]
      exact mul_le_of_le_one_right' hent.2.2
    have hsum : α' + β' = α + β := by
      rw [← v_zpow_inj (F := F), zpow_add₀ (unif_ne_zero F), zpow_add₀ (unif_ne_zero F), e00, e11]
      calc valuation F (ϖ ^ α * k₀₀ * (ϖ ^ β * k₁₁))
          = valuation F (ϖ ^ α * ϖ ^ β) * (valuation F k₀₀ * valuation F k₁₁) := by
            simp only [map_mul]; exact mul_mul_mul_comm _ _ _ _
        _ = _ := by rw [hdet, mul_one]
    obtain rfl : α = α' := by omega
    obtain rfl : β = β' := by omega
    refine ⟨rfl, rfl, ?_⟩
    have hk11 : k₁₁ = 1 := by
      have := e11
      field_simp [hϖ β] at this
      exact this.symm
    subst hk11
    rw [e01, mul_one, add_sub_cancel_right, map_mul]
    exact mul_le_of_le_one_right' hent.1.2
  · rintro ⟨rfl, rfl, hx⟩
    have hk : (!![1, (x' - x) / ϖ ^ α; 0, 1] : Matrix (Fin 2) (Fin 2) F).det ≠ 0 := by
      simp [Matrix.det_fin_two_of]
    have hkK : Matrix.GeneralLinearGroup.mkOfDetNeZero _ hk ∈ 𝐊[F] := by
      refine mkOfDetNeZero_mem_K _ _ ?_ (by simp [Matrix.det_fin_two_of])
      have : valuation F (x' - x) / valuation F ϖ ^ α ≤ 1 := by
        rw [div_le_one₀ (zero_lt_iff.mpr (by simpa using v_ne_zero (hϖ α)))]
        simpa using hx
      simp [Fin.forall_fin_two, this]
    have heq : hmat α β x' = hmat α β x * Matrix.GeneralLinearGroup.mkOfDetNeZero _ hk := by
      apply Units.ext
      rw [Units.val_mul, hmat_val, hmat_val, Matrix.GeneralLinearGroup.val_mkOfDetNeZero,
        Matrix.mul_fin_two]
      ext i j
      fin_cases i <;> fin_cases j <;> simp
      field_simp [hϖ α]
      ring
    rw [heq, ← mul_assoc, inv_mul_cancel, one_mul]
    exact hkK

/-- `𝓘(g) = ϖ^b 𝒪` iff every entry has valuation `≤ v(ϖ^b)` and one entry has valuation `v(ϖ^b)`. -/
theorem entrySpan_eq_iff (g : GL (Fin 2) F) (b : ℤ) :
    𝓘(g) = Submodule.span 𝒪[F] {ϖ ^ b} ↔
      (∀ i j, valuation F ((g : Matrix (Fin 2) (Fin 2) F) i j) ≤ valuation F (ϖ ^ b)) ∧
        ∃ i j, valuation F ((g : Matrix (Fin 2) (Fin 2) F) i j) = valuation F (ϖ ^ b) := by
  have hϖ : ∀ n : ℤ, ϖ ^ n ≠ 0 := fun n => zpow_ne_zero _ (unif_ne_zero F)
  have hle : ∀ b : ℤ, 𝓘(g) ≤ Submodule.span 𝒪[F] {ϖ ^ b} ↔
      ∀ i j, valuation F ((g : Matrix (Fin 2) (Fin 2) F) i j) ≤ valuation F (ϖ ^ b) := by
    intro b
    rw [entrySpan, Submodule.span_le, Set.range_subset_iff, Prod.forall]
    simp only [SetLike.mem_coe, mem_span_singleton_iff_v (hϖ b)]
  constructor
  · intro h
    have hall := (hle b).mp h.le
    refine ⟨hall, ?_⟩
    by_contra hne
    simp only [not_exists] at hne
    have hlt : ∀ i j, valuation F ((g : Matrix (Fin 2) (Fin 2) F) i j) ≤ valuation F (ϖ ^ (b + 1)) := by
      intro i j
      have hl := lt_of_le_of_ne (hall i j) (hne i j)
      by_cases h0 : (g : Matrix (Fin 2) (Fin 2) F) i j = 0
      · rw [h0, map_zero]; exact zero_le
      obtain ⟨m, hm⟩ := exists_v_eq_zpow _ h0
      rw [hm] at hl ⊢
      have : b < m := by
        by_contra hc
        exact absurd hl (not_lt.mpr (v_zpow_le_iff.mpr (not_lt.mp hc)))
      exact v_zpow_le_iff.mpr (by omega)
    have h2 : Submodule.span 𝒪[F] {ϖ ^ b} ≤ Submodule.span 𝒪[F] {ϖ ^ (b + 1)} :=
      h ▸ (hle (b + 1)).mpr hlt
    have h3 := h2 (Submodule.mem_span_singleton_self _)
    rw [mem_span_singleton_iff_v (hϖ _), v_zpow_le_iff] at h3
    omega
  · rintro ⟨hall, i, j, hij⟩
    refine le_antisymm ((hle b).mpr hall) ?_
    have h0 : (g : Matrix (Fin 2) (Fin 2) F) i j ≠ 0 := by
      intro h0; rw [h0, map_zero] at hij; exact v_ne_zero (hϖ b) hij.symm
    rw [Submodule.span_le, Set.singleton_subset_iff]
    have : ϖ ^ b ∈ Submodule.span 𝒪[F] {(g : Matrix (Fin 2) (Fin 2) F) i j} := by
      rw [mem_span_singleton_iff_v h0, hij]
    have hmem : (g : Matrix (Fin 2) (Fin 2) F) i j ∈ 𝓘(g) := Submodule.subset_span ⟨(i, j), rfl⟩
    exact Submodule.span_le.mpr (Set.singleton_subset_iff.mpr hmem) this

theorem v_zpow_inj' {m n : ℤ} : valuation F ϖ ^ m = valuation F ϖ ^ n ↔ m = n := by
  rw [← map_zpow₀, ← map_zpow₀]; exact v_zpow_inj

/-- Step 3: the normal forms lying in `K t_{n,0} K`. -/
theorem hmat_mem_iff (n : ℕ) (α β : ℤ) (x : F) :
    hmat α β x ∈ DoubleCoset.doubleCoset (cartanElement F n 0) 𝐊[F] 𝐊[F] ↔
      0 ≤ α ∧ 0 ≤ β ∧ α + β = n ∧ valuation F x ≤ 1 ∧ (α = 0 ∨ β = 0 ∨ valuation F x = 1) := by
  rw [cartan_invariants F (n : ℤ) 0 (by positivity),
    exists_unit_iff_v_eq _ _ (zpow_ne_zero _ (unif_ne_zero F))]
  change 𝓘(hmat α β x) = _ ∧ _ ↔ _
  rw [entrySpan_eq_iff, hmat_val, Matrix.det_fin_two_of, ← zpow_add₀ (unif_ne_zero F)]
  simp only [Fin.forall_fin_two, Fin.exists_fin_two, Matrix.of_apply, Matrix.cons_val',
    Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.empty_val', Matrix.cons_val_fin_one,
    Fin.isValue, zpow_zero, map_one, map_zero, mul_zero, sub_zero, add_zero, map_zpow₀,
    v_zpow_le_one_iff', v_zpow_eq_one_iff', v_zpow_inj', zero_le_one, zero_ne_one, true_and,
    false_or]
  tauto

theorem mem_doubleCoset_of_mk_eq {g h t : GL (Fin 2) F}
    (hg : g ∈ DoubleCoset.doubleCoset t 𝐊[F] 𝐊[F])
    (hgh : (g : GL (Fin 2) F ⧸ 𝐊[F]) = (h : GL (Fin 2) F ⧸ 𝐊[F])) :
    h ∈ DoubleCoset.doubleCoset t 𝐊[F] 𝐊[F] := by
  obtain ⟨x, hx, y, hy, rfl⟩ := DoubleCoset.mem_doubleCoset.mp hg
  have hk := QuotientGroup.eq.mp hgh
  exact DoubleCoset.mem_doubleCoset.mpr ⟨x, hx, y * ((x * t * y)⁻¹ * h), mul_mem hy hk, by group⟩

/-! ### Counting residue classes (Step 5) -/

theorem residue_card_pos : 0 < q F := Nat.card_pos

theorem mem_span_pow_iff (r : 𝒪[F]) (k : ℕ) :
    r ∈ Ideal.span {unif F ^ k} ↔ valuation F (r : F) ≤ valuation F (ϖ ^ (k : ℤ)) := by
  have hϖ : ϖ ^ (k : ℤ) ≠ 0 := zpow_ne_zero _ (unif_ne_zero F)
  rw [Ideal.mem_span_singleton']
  constructor
  · rintro ⟨c, rfl⟩
    push_cast
    rw [map_mul, zpow_natCast]
    exact mul_le_of_le_one_left' ((Valuation.mem_integer_iff _ _).mp c.2)
  · intro h
    refine ⟨⟨(r : F) / ϖ ^ (k : ℤ), (Valuation.mem_integer_iff _ _).mpr ?_⟩, Subtype.ext ?_⟩
    · rw [map_div₀, div_le_one₀ (zero_lt_iff.mpr (v_ne_zero hϖ))]; exact h
    · push_cast
      rw [← zpow_natCast]
      field_simp

theorem out_sub_mem (I : Ideal 𝒪[F]) (r : 𝒪[F]) :
    Quotient.out (Ideal.Quotient.mk I r) - r ∈ I :=
  Ideal.Quotient.eq.mp (Quotient.out_eq _)

theorem span_pow_toAddSubgroup_map (j k : ℕ) :
    (Ideal.span {unif F ^ j}).toAddSubgroup.map (AddMonoidHom.mulLeft (unif F ^ k)) =
      (Ideal.span {unif F ^ (j + k)}).toAddSubgroup := by
  ext x
  simp only [AddSubgroup.mem_map, Submodule.mem_toAddSubgroup, Ideal.mem_span_singleton',
    AddMonoidHom.coe_mulLeft]
  constructor
  · rintro ⟨_, ⟨c, rfl⟩, rfl⟩
    exact ⟨c, by ring⟩
  · rintro ⟨c, rfl⟩
    exact ⟨c * unif F ^ j, ⟨c, rfl⟩, by ring⟩

theorem card_quot_span_pow (k : ℕ) : Nat.card (𝒪[F] ⧸ Ideal.span {unif F ^ k}) = q F ^ k := by
  induction k with
  | zero =>
    simp only [pow_zero, Ideal.span_singleton_one]
    exact Nat.card_unique
  | succ k ih =>
    have hle : (Ideal.span {unif F ^ (k + 1)}).toAddSubgroup ≤ (Ideal.span {unif F ^ k}).toAddSubgroup :=
      fun x hx => Ideal.span_singleton_le_span_singleton.mpr (pow_dvd_pow _ k.le_succ) hx
    have hinj : Function.Injective (AddMonoidHom.mulLeft (unif F ^ k)) :=
      mul_right_injective₀ (pow_ne_zero _ (irreducible_unif F).ne_zero)
    have hrel : (Ideal.span {unif F ^ (k + 1)}).toAddSubgroup.relIndex
        (Ideal.span {unif F ^ k}).toAddSubgroup = q F := by
      have e1 := span_pow_toAddSubgroup_map (F := F) 1 k
      have e0 := span_pow_toAddSubgroup_map (F := F) 0 k
      rw [add_comm 1 k] at e1
      rw [zero_add] at e0
      rw [← e1, ← e0, AddSubgroup.relIndex_map_map_of_injective _ _ hinj, pow_zero, Ideal.span_singleton_one,
        Submodule.top_toAddSubgroup, AddSubgroup.relIndex_top_right, pow_one,
        ← maximalIdeal_eq_span_unif]
      rfl
    have := AddSubgroup.relIndex_mul_index hle
    change (Ideal.span {unif F ^ (k + 1)}).toAddSubgroup.index = _
    rw [← this, hrel, show (Ideal.span {unif F ^ k}).toAddSubgroup.index = q F ^ k from ih, pow_succ, mul_comm]

theorem finite_quot_span_pow (k : ℕ) : Finite (𝒪[F] ⧸ Ideal.span {unif F ^ k}) :=
  Nat.finite_of_card_ne_zero (by rw [card_quot_span_pow]; exact pow_ne_zero _ residue_card_pos.ne')

/-- The classes of non-units in `𝒪/ϖ^{k+1}𝒪` are `ϖ · (𝒪/ϖ^k 𝒪)`. -/
theorem card_nonunit (k : ℕ) :
    Nat.card {ξ : 𝒪[F] ⧸ Ideal.span {unif F ^ (k + 1)} // ¬ IsUnit (Quotient.out ξ)} = q F ^ k := by
  have hϖ0 : unif F ≠ 0 := (irreducible_unif F).ne_zero
  have hmax : ∀ r : 𝒪[F], ¬ IsUnit r ↔ r ∈ Ideal.span {unif F} := by
    intro r
    rw [← maximalIdeal_eq_span_unif, IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
  have hsub : Ideal.span {unif F ^ (k + 1)} ≤ Ideal.span {unif F} :=
    Ideal.span_singleton_le_span_singleton.mpr (dvd_pow_self _ (Nat.succ_ne_zero k))
  have hshift : ∀ r : 𝒪[F], unif F * r ∈ Ideal.span {unif F ^ (k + 1)} ↔ r ∈ Ideal.span {unif F ^ k} := by
    intro r
    rw [Ideal.mem_span_singleton, Ideal.mem_span_singleton, pow_succ', mul_dvd_mul_iff_left hϖ0]
  let ψ : 𝒪[F] ⧸ Ideal.span {unif F ^ k} →
      {ξ : 𝒪[F] ⧸ Ideal.span {unif F ^ (k + 1)} // ¬ IsUnit (Quotient.out ξ)} := fun η =>
    ⟨Ideal.Quotient.mk _ (unif F * Quotient.out η), by
      rw [hmax]
      have h1 := hsub (out_sub_mem (Ideal.span {unif F ^ (k + 1)}) (unif F * Quotient.out η))
      have h2 : unif F * Quotient.out η ∈ Ideal.span {unif F} :=
        Ideal.mul_mem_right _ _ (Ideal.mem_span_singleton_self _)
      simpa using Ideal.add_mem _ h1 h2⟩
  have hψ : Function.Bijective ψ := by
    constructor
    · intro η η' h
      have h' := Ideal.Quotient.eq.mp (congrArg Subtype.val h)
      rw [← mul_sub, hshift] at h'
      rw [← Quotient.out_eq η, ← Quotient.out_eq η']
      exact Ideal.Quotient.eq.mpr h'
    · rintro ⟨ξ, hξ⟩
      obtain ⟨c, hc⟩ := Ideal.mem_span_singleton'.mp ((hmax _).mp hξ)
      refine ⟨Ideal.Quotient.mk _ c, Subtype.ext ?_⟩
      change Ideal.Quotient.mk _ (unif F * Quotient.out (Ideal.Quotient.mk _ c)) = ξ
      conv_rhs => rw [← Quotient.out_eq ξ]
      refine Ideal.Quotient.eq.mpr ?_
      change _ - Quotient.out ξ ∈ _
      rw [← hc, mul_comm c, ← mul_sub, hshift]
      exact out_sub_mem _ c
  rw [← Nat.card_congr (Equiv.ofBijective ψ hψ), card_quot_span_pow]

theorem card_unit (k : ℕ) :
    Nat.card {ξ : 𝒪[F] ⧸ Ideal.span {unif F ^ (k + 1)} // IsUnit (Quotient.out ξ)} =
      q F ^ (k + 1) - q F ^ k := by
  classical
  have := finite_quot_span_pow (F := F) (k + 1)
  have h := Nat.card_congr (Equiv.sumCompl fun ξ : 𝒪[F] ⧸ Ideal.span {unif F ^ (k + 1)} =>
    IsUnit (Quotient.out ξ))
  rw [Nat.card_sum, card_nonunit, card_quot_span_pow] at h
  omega

theorem card_unit' (m : ℕ) (hm : m ≠ 0) :
    Nat.card {ξ : 𝒪[F] ⧸ Ideal.span {unif F ^ m} // IsUnit (Quotient.out ξ)} =
      q F ^ m - q F ^ (m - 1) := by
  obtain ⟨k, rfl⟩ := Nat.exists_eq_succ_of_ne_zero hm
  exact card_unit k

/-! ### The parametrization (Step 4) -/

variable (F) in
/-- The parameter set `M` of Step 4: pairs `(α, ξ)` with `0 ≤ α ≤ n`, `ξ ∈ 𝒪/ϖ^α 𝒪`, and `α ∈ {0, n}` or
`ξ` the class of a unit (its chosen representative is a unit). Proof helper. -/
abbrev CosetParam (n : ℕ) : Type _ :=
  Σ α : Fin (n + 1), {ξ : 𝒪[F] ⧸ Ideal.span {unif F ^ (α : ℕ)} //
    (α : ℕ) = 0 ∨ (α : ℕ) = n ∨ IsUnit (Quotient.out ξ)}

/-- `Φ(α, ξ) = h(α, n - α, x) K_F` for the chosen representative `x` of `ξ` (proof helper). -/
noncomputable def cosetParamMap (n : ℕ) (p : CosetParam F n) : GL (Fin 2) F ⧸ 𝐊[F] :=
  ((hmat ((p.1 : ℕ) : ℤ) ((n : ℤ) - (p.1 : ℕ)) ((Quotient.out p.2.1 : 𝒪[F]) : F) : GL (Fin 2) F) :
    GL (Fin 2) F ⧸ 𝐊[F])

theorem cosetParamMap_injective (n : ℕ) : Function.Injective (cosetParamMap (F := F) n) := by
  rintro ⟨α, ξ, hξ⟩ ⟨α', ξ', hξ'⟩ h
  obtain ⟨h1, -, h3⟩ := (hmat_mk_eq_iff _ _ _ _ _ _).mp h
  have hα : α = α' := Fin.ext (by exact_mod_cast h1)
  subst hα
  have : ξ = ξ' := by
    rw [← Quotient.out_eq ξ, ← Quotient.out_eq ξ']
    refine Ideal.Quotient.eq.mpr ((mem_span_pow_iff _ _).mpr ?_)
    push_cast
    rw [Valuation.map_sub_swap]
    exact h3
  subst this
  rfl

theorem range_cosetParamMap (n : ℕ) :
    Set.range (cosetParamMap (F := F) n) =
      QuotientGroup.mk '' DoubleCoset.doubleCoset (cartanElement F n 0) 𝐊[F] 𝐊[F] := by
  ext c
  constructor
  · rintro ⟨⟨α, ξ, hξ⟩, rfl⟩
    have hαn := α.isLt
    refine ⟨_, (hmat_mem_iff n _ _ _).mpr ⟨by positivity, by omega, by ring,
      (Valuation.mem_integer_iff _ _).mp (Quotient.out ξ).2, ?_⟩, rfl⟩
    rcases hξ with h | h | h
    · left; exact_mod_cast h
    · right; left; rw [h]; ring
    · right; right; exact (Valuation.integer.integers _).isUnit_iff_valuation_eq_one.mp h
  · rintro ⟨g, hg, rfl⟩
    obtain ⟨α, β, x, hgx⟩ := exists_hmat g
    have hmem := mem_doubleCoset_of_mk_eq hg hgx
    obtain ⟨hα, hβ, hαβ, hx, hcond⟩ := (hmat_mem_iff n α β x).mp hmem
    obtain ⟨a, rfl⟩ : ∃ a : ℕ, (a : ℤ) = α := ⟨α.toNat, Int.toNat_of_nonneg hα⟩
    have ha : a < n + 1 := by omega
    let x₀ : 𝒪[F] := ⟨x, (Valuation.mem_integer_iff _ _).mpr hx⟩
    let ξ : 𝒪[F] ⧸ Ideal.span {unif F ^ a} := Ideal.Quotient.mk _ x₀
    have hsub : valuation F (((Quotient.out ξ : 𝒪[F]) : F) - x) ≤ valuation F (ϖ ^ (a : ℤ)) := by
      have := (mem_span_pow_iff _ _).mp (out_sub_mem (Ideal.span {unif F ^ a}) x₀)
      push_cast at this
      exact this
    have hP : a = 0 ∨ a = n ∨ IsUnit (Quotient.out ξ) := by
      rcases hcond with h | h | h
      · left; omega
      · right; left; omega
      · by_cases ha0 : a = 0
        · exact Or.inl ha0
        refine Or.inr (Or.inr ((Valuation.integer.integers _).isUnit_iff_valuation_eq_one.mpr ?_))
        change valuation F ((Quotient.out ξ : 𝒪[F]) : F) = 1
        rw [← h]
        apply Valuation.map_eq_of_sub_lt
        rw [h]
        refine lt_of_le_of_lt hsub (lt_of_le_of_lt (v_zpow_le_iff.mpr (show (1 : ℤ) ≤ a by omega)) ?_)
        rw [zpow_one]
        exact v_unif_lt_one
    refine ⟨⟨⟨a, ha⟩, ξ, hP⟩, ?_⟩
    change (hmat (a : ℤ) ((n : ℤ) - a) ((Quotient.out ξ : 𝒪[F]) : F) : GL (Fin 2) F ⧸ 𝐊[F]) = _
    rw [hgx, hmat_mk_eq_iff]
    refine ⟨rfl, by omega, ?_⟩
    rw [Valuation.map_sub_swap]
    exact hsub

theorem sum_range_count (n : ℕ) :
    ∀ m, 1 ≤ m → m ≤ n → ∑ a ∈ Finset.range m,
      (if a = 0 ∨ a = n then q F ^ a else q F ^ a - q F ^ (a - 1)) = q F ^ (m - 1) := by
  intro m hm
  induction m, hm using Nat.le_induction with
  | base => intro _; simp
  | succ m hm ih =>
    intro hmn
    rw [Finset.sum_range_succ, ih (by omega), ite_eq_right (by omega)]
    have : q F ^ (m - 1) ≤ q F ^ m := Nat.pow_le_pow_right residue_card_pos (by omega)
    rw [show m + 1 - 1 = m by omega]
    omega

theorem card_cosetParam (n : ℕ) :
    Nat.card (CosetParam F n) = if n = 0 then 1 else q F ^ n + q F ^ (n - 1) := by
  classical
  have : ∀ k : ℕ, Finite (𝒪[F] ⧸ Ideal.span {unif F ^ k}) := finite_quot_span_pow
  rw [Nat.card_sigma]
  have hterm : ∀ α : Fin (n + 1), Nat.card {ξ : 𝒪[F] ⧸ Ideal.span {unif F ^ (α : ℕ)} //
      (α : ℕ) = 0 ∨ (α : ℕ) = n ∨ IsUnit (Quotient.out ξ)} =
      if (α : ℕ) = 0 ∨ (α : ℕ) = n then q F ^ (α : ℕ) else q F ^ (α : ℕ) - q F ^ ((α : ℕ) - 1) := by
    intro α
    split_ifs with h
    · rw [← card_quot_span_pow]
      exact Nat.card_congr (Equiv.subtypeUnivEquiv fun ξ => by tauto)
    · rw [← card_unit' _ (by tauto)]
      exact Nat.card_congr (Equiv.subtypeEquivRight fun ξ => by tauto)
  simp only [hterm]
  rw [Fin.sum_univ_eq_sum_range (fun a => if a = 0 ∨ a = n then q F ^ a else q F ^ a - q F ^ (a - 1))]
  split_ifs with hn
  · subst hn; simp
  · rw [Finset.sum_range_succ, sum_range_count n n (by omega) le_rfl, ite_eq_left (Or.inr rfl)]
    ring

/-! ### Reduction to `b = 0` (Step 0) and the count -/

theorem cartanElement_mul (b n : ℤ) :
    cartanElement F (b + n) b = cartanElement F b b * cartanElement F n 0 := by
  apply Units.ext
  rw [Units.val_mul, cartanElement_val, cartanElement_val, cartanElement_val, Matrix.mul_fin_two,
    zpow_add₀ (unif_ne_zero F)]
  simp

theorem cartanElement_comm (b : ℤ) (g : GL (Fin 2) F) :
    cartanElement F b b * g = g * cartanElement F b b := by
  apply Units.ext
  rw [Units.val_mul, Units.val_mul, cartanElement_val]
  ext i j
  fin_cases i <;> fin_cases j <;> simp [Matrix.mul_apply, Fin.sum_univ_two, mul_comm]

theorem doubleCoset_cartanElement_shift (b n : ℤ) :
    DoubleCoset.doubleCoset (cartanElement F (b + n) b) 𝐊[F] 𝐊[F] =
      (cartanElement F b b * ·) '' DoubleCoset.doubleCoset (cartanElement F n 0) 𝐊[F] 𝐊[F] := by
  ext g
  simp only [Set.mem_image, DoubleCoset.mem_doubleCoset, cartanElement_mul]
  constructor
  · rintro ⟨x, hx, y, hy, rfl⟩
    exact ⟨x * cartanElement F n 0 * y, ⟨x, hx, y, hy, rfl⟩, by
      rw [← mul_assoc, ← mul_assoc, cartanElement_comm, mul_assoc x]⟩
  · rintro ⟨_, ⟨x, hx, y, hy, rfl⟩, rfl⟩
    exact ⟨x, hx, y, hy, by rw [← mul_assoc, ← mul_assoc, cartanElement_comm, mul_assoc x]⟩

end CosetCount

/-- Index of the Cartan double cosets: for `a ≥ b` and `n = a - b`, the set of left cosets `hK_F` with
`h ∈ K_F t_{a,b} K_F` is finite, with `1` element if `n = 0` and `q^n + q^{n-1}` elements if `n ≥ 1`. -/
@[tf_id "I.cartan.thm:double-coset-index"]
theorem double_coset_index (a b : ℤ) (hab : b ≤ a) :
    (QuotientGroup.mk '' DoubleCoset.doubleCoset (cartanElement F a b) 𝐊[F] 𝐊[F] :
        Set (GL (Fin 2) F ⧸ 𝐊[F])).Finite ∧
      Nat.card (QuotientGroup.mk '' DoubleCoset.doubleCoset (cartanElement F a b) 𝐊[F] 𝐊[F] :
          Set (GL (Fin 2) F ⧸ 𝐊[F])) =
        if a = b then 1 else q F ^ (a - b).toNat + q F ^ (a - b - 1).toNat := by
  obtain ⟨n, hn⟩ : ∃ n : ℕ, a = b + n := ⟨(a - b).toNat, by omega⟩
  subst hn
  have : ∀ k : ℕ, Finite (𝒪[F] ⧸ Ideal.span {unif F ^ k}) := finite_quot_span_pow
  have hS : (QuotientGroup.mk '' DoubleCoset.doubleCoset (cartanElement F (b + n) b) 𝐊[F] 𝐊[F] :
      Set (GL (Fin 2) F ⧸ 𝐊[F])) =
      (cartanElement F b b • ·) '' Set.range (cosetParamMap (F := F) n) := by
    rw [doubleCoset_cartanElement_shift, range_cosetParamMap, Set.image_image, Set.image_image]
    rfl
  rw [hS]
  refine ⟨(Set.finite_range _).image _, ?_⟩
  rw [Nat.card_image_of_injective (MulAction.injective _), Nat.card_range_of_injective
    (cosetParamMap_injective n), card_cosetParam]
  simp only [add_sub_cancel_left, add_eq_left, Nat.cast_eq_zero, Int.toNat_natCast]
  split_ifs <;> first | rfl | (congr 2; omega)

end GL2TF.Local

namespace GL2TF

open Matrix Matrix.GeneralLinearGroup
open scoped ContDiff

/-! The Iwasawa coordinates on `{det ≠ 0}` (untagged plumbing for `I.decomp.thm:iwasawa-real` and
`I.decomp.thm:iwasawa-real-smooth`). -/

namespace Iwasawa

/-- `t₂(X) = (c² + d²)^{1/2}`. -/
noncomputable def t₂ (X : MatPi) : ℝ := (X 1 0 ^ 2 + X 1 1 ^ 2) ^ (1 / 2 : ℝ)
/-- `t₁(X) = det X / t₂(X)`. -/
noncomputable def t₁ (X : MatPi) : ℝ := (Matrix.of X).det / t₂ X
/-- `x(X) = (ac + bd)/(c² + d²)`. -/
noncomputable def xc (X : MatPi) : ℝ := (X 0 0 * X 1 0 + X 0 1 * X 1 1) / (X 1 0 ^ 2 + X 1 1 ^ 2)
/-- `k(X) = t₂(X)⁻¹ (d −c; c d)`. -/
noncomputable def kc (X : MatPi) : MatPi := fun i j => (t₂ X)⁻¹ * !![X 1 1, -X 1 0; X 1 0, X 1 1] i j

theorem det_of (X : MatPi) : (Matrix.of X).det = X 0 0 * X 1 1 - X 0 1 * X 1 0 := by
  rw [Matrix.det_fin_two]; rfl

theorem sumsq_pos {X : MatPi} (hX : X ∈ detNeZeroSet) : 0 < X 1 0 ^ 2 + X 1 1 ^ 2 := by
  have h : X 0 0 * X 1 1 - X 0 1 * X 1 0 ≠ 0 := by rw [← det_of]; exact hX
  by_contra hle
  have h1 : X 1 0 = 0 := by nlinarith [sq_nonneg (X 1 0), sq_nonneg (X 1 1)]
  have h2 : X 1 1 = 0 := by nlinarith [sq_nonneg (X 1 0), sq_nonneg (X 1 1)]
  exact h (by rw [h1, h2]; ring)

theorem t₂_eq_sqrt (X : MatPi) : t₂ X = √(X 1 0 ^ 2 + X 1 1 ^ 2) := by
  rw [t₂, Real.sqrt_eq_rpow]

theorem t₂_pos {X : MatPi} (hX : X ∈ detNeZeroSet) : 0 < t₂ X := by
  rw [t₂_eq_sqrt]; exact Real.sqrt_pos.mpr (sumsq_pos hX)

theorem t₁_ne_zero {X : MatPi} (hX : X ∈ detNeZeroSet) : t₁ X ≠ 0 :=
  div_ne_zero hX (t₂_pos hX).ne'

theorem t₂_sq {X : MatPi} (hX : X ∈ detNeZeroSet) : t₂ X ^ 2 = X 1 0 ^ 2 + X 1 1 ^ 2 := by
  rw [t₂_eq_sqrt, Real.sq_sqrt (sumsq_pos hX).le]

/-- The matrix identity `X = n(x) diag(t₁, t₂) k`. -/
theorem decomp_matrix {X : MatPi} (hX : X ∈ detNeZeroSet) :
    Matrix.of X = !![1, xc X; 0, 1] * !![t₁ X, 0; 0, t₂ X] * Matrix.of (kc X) := by
  have h2 := t₂_pos hX
  have hS := t₂_sq hX
  have hS0 := sumsq_pos hX
  ext i j; fin_cases i <;> fin_cases j <;>
    simp [Matrix.mul_apply, Fin.sum_univ_two, kc, t₁, xc, det_of] <;> field_simp <;>
    (try rw [hS]) <;> ring

/-- `k(X) ∈ SO(2)`: `kᵀk = 1` and `det k = 1`. -/
theorem kc_orth {X : MatPi} (hX : X ∈ detNeZeroSet) :
    (Matrix.of (kc X))ᵀ * Matrix.of (kc X) = 1 ∧ (Matrix.of (kc X)).det = 1 := by
  have h2 := t₂_pos hX
  have hS := t₂_sq hX
  constructor
  · ext i j; fin_cases i <;> fin_cases j <;>
      simp [Matrix.mul_apply, Fin.sum_univ_two, kc] <;> field_simp <;> nlinarith [hS]
  · rw [det_of]; simp [kc]; field_simp; nlinarith [hS]

/-- The Iwasawa coordinates are determined by the product. -/
theorem coords_of_decomp (x t₁' t₂' : ℝ) (k : Matrix (Fin 2) (Fin 2) ℝ) (ht : 0 < t₂')
    (hk : kᵀ * k = 1) (hdet : k.det = 1) :
    let G : MatPi := !![1, x; 0, 1] * !![t₁', 0; 0, t₂'] * k
    t₂' = t₂ G ∧ t₁' = t₁ G ∧ x = xc G ∧ k = Matrix.of (kc G) := by
  intro G
  obtain ⟨h11, h01, hn⟩ := so2_normal_form hk hdet
  have hG : ∀ i j, G i j = (!![1, x; 0, 1] * !![t₁', 0; 0, t₂'] * k) i j := fun _ _ => rfl
  have g10 : G 1 0 = t₂' * k 1 0 := by rw [hG]; simp [Matrix.mul_apply, Fin.sum_univ_two]
  have g11 : G 1 1 = t₂' * k 0 0 := by rw [hG]; simp [Matrix.mul_apply, Fin.sum_univ_two, h11]
  have g00 : G 0 0 = t₁' * k 0 0 + x * t₂' * k 1 0 := by
    rw [hG]; simp [Matrix.mul_apply, Fin.sum_univ_two]
  have g01 : G 0 1 = -t₁' * k 1 0 + x * t₂' * k 0 0 := by
    rw [hG]; simp [Matrix.mul_apply, Fin.sum_univ_two, h01, h11]
  have hS : G 1 0 ^ 2 + G 1 1 ^ 2 = t₂' ^ 2 := by rw [g10, g11]; nlinarith [hn]
  have ht₂ : t₂ G = t₂' := by
    rw [t₂_eq_sqrt, hS, Real.sqrt_sq ht.le]
  have hdetG : (Matrix.of G).det = t₁' * t₂' := by
    rw [det_of, g00, g01, g10, g11]; linear_combination (t₁' * t₂') * hn
  refine ⟨ht₂.symm, ?_, ?_, ?_⟩
  · rw [t₁, hdetG, ht₂]; field_simp
  · rw [xc, hS, g00, g01, g10, g11]; field_simp; linear_combination (-(x * t₂')) * hn
  · ext i j; fin_cases i <;> fin_cases j <;> simp [kc, ht₂, g10, g11, h11, h01] <;> field_simp

theorem mem_detNeZeroSet (g : GL (Fin 2) ℝ) : matToPi (g : Matrix (Fin 2) (Fin 2) ℝ) ∈ detNeZeroSet :=
  (Matrix.isUnit_iff_isUnit_det _).mp g.isUnit |>.ne_zero

/-- `k(g) ∈ GL₂(ℝ)`. -/
noncomputable def kGL (g : GL (Fin 2) ℝ) : GL (Fin 2) ℝ :=
  mkOfDetNeZero (Matrix.of (kc (matToPi (g : Matrix (Fin 2) (Fin 2) ℝ))))
    (by rw [(kc_orth (mem_detNeZeroSet g)).2]; exact one_ne_zero)

theorem kGL_val (g : GL (Fin 2) ℝ) :
    ((kGL g : GL (Fin 2) ℝ) : Matrix (Fin 2) (Fin 2) ℝ) = Matrix.of (kc (matToPi (g : Matrix (Fin 2) (Fin 2) ℝ))) :=
  val_mkOfDetNeZero _ _

theorem kGL_mem (g : GL (Fin 2) ℝ) : kGL g ∈ specialOrthogonalReal := by
  rw [mem_specialOrthogonalReal_iff, kGL_val]
  exact kc_orth (mem_detNeZeroSet g)

theorem exists_decomp (g : GL (Fin 2) ℝ) :
    let X := matToPi (g : Matrix (Fin 2) (Fin 2) ℝ)
    g = upperRightHom (xc X) * diagElt (Units.mk0 (t₁ X) (t₁_ne_zero (mem_detNeZeroSet g)))
      (Units.mk0 (t₂ X) (t₂_pos (mem_detNeZeroSet g)).ne') * kGL g := by
  intro X
  apply Units.ext
  have h := decomp_matrix (mem_detNeZeroSet g)
  simp only [Units.val_mul, kGL, val_mkOfDetNeZero, upperRightHom_apply, diagElt, Units.val_mk0]
  exact h

/-- The coordinates of any Iwasawa decomposition of `g`. -/
theorem coords_of_eq (g : GL (Fin 2) ℝ) (p : ℝ × ℝˣ × ℝˣ × specialOrthogonalReal)
    (hp : 0 < (p.2.2.1 : ℝ)) (hg : g = upperRightHom p.1 * diagElt p.2.1 p.2.2.1 * p.2.2.2) :
    let X := matToPi (g : Matrix (Fin 2) (Fin 2) ℝ)
    p.1 = xc X ∧ (p.2.1 : ℝ) = t₁ X ∧ (p.2.2.1 : ℝ) = t₂ X ∧
      ((p.2.2.2 : GL (Fin 2) ℝ) : Matrix (Fin 2) (Fin 2) ℝ) = Matrix.of (kc X) := by
  intro X
  obtain ⟨hk, hdet⟩ := (mem_specialOrthogonalReal_iff _).mp p.2.2.2.2
  have hX : X = !![1, p.1; 0, 1] * !![(p.2.1 : ℝ), 0; 0, (p.2.2.1 : ℝ)] *
      ((p.2.2.2 : GL (Fin 2) ℝ) : Matrix (Fin 2) (Fin 2) ℝ) := by
    show (g : Matrix (Fin 2) (Fin 2) ℝ) = _
    rw [hg]
    simp only [Units.val_mul, upperRightHom_apply, diagElt]
  obtain ⟨e2, e1, ex, ek⟩ := coords_of_decomp p.1 p.2.1 p.2.2.1 _ hp hk hdet
  rw [← hX] at e2 e1 ex ek
  exact ⟨ex, e1, e2, ek⟩

end Iwasawa

open Iwasawa

/-- Iwasawa decomposition of `GL₂(ℝ)`: every `g` is uniquely `n(x) diag(t₁, t₂) k` with `x ∈ ℝ`, `t₁ ∈ ℝˣ`,
`t₂ > 0` and `k ∈ SO(2)`; for `g = (a b; c d)`: `t₂ = (c² + d²)^{1/2}`, `t₁ = det g / t₂`, `x = (ac + bd)/(c² + d²)`,
`k = t₂⁻¹ (d −c; c d)`. -/
@[tf_id "I.decomp.thm:iwasawa-real"]
theorem iwasawa_real (g : GL (Fin 2) ℝ) :
    (∃! p : ℝ × ℝˣ × ℝˣ × specialOrthogonalReal,
        0 < (p.2.2.1 : ℝ) ∧ g = upperRightHom p.1 * diagElt p.2.1 p.2.2.1 * p.2.2.2) ∧
    ∀ p : ℝ × ℝˣ × ℝˣ × specialOrthogonalReal,
      0 < (p.2.2.1 : ℝ) → g = upperRightHom p.1 * diagElt p.2.1 p.2.2.1 * p.2.2.2 →
      let a := (g : Matrix (Fin 2) (Fin 2) ℝ) 0 0
      let b := (g : Matrix (Fin 2) (Fin 2) ℝ) 0 1
      let c := (g : Matrix (Fin 2) (Fin 2) ℝ) 1 0
      let d := (g : Matrix (Fin 2) (Fin 2) ℝ) 1 1
      (p.2.2.1 : ℝ) = (c ^ 2 + d ^ 2) ^ (1 / 2 : ℝ) ∧
      (p.2.1 : ℝ) = (g : Matrix (Fin 2) (Fin 2) ℝ).det / (p.2.2.1 : ℝ) ∧
      p.1 = (a * c + b * d) / (c ^ 2 + d ^ 2) ∧
      ((p.2.2.2 : GL (Fin 2) ℝ) : Matrix (Fin 2) (Fin 2) ℝ) = (p.2.2.1 : ℝ)⁻¹ • !![d, -c; c, d] := by
  have hX := mem_detNeZeroSet g
  refine ⟨⟨(xc (matToPi (g : Matrix (Fin 2) (Fin 2) ℝ)), Units.mk0 _ (t₁_ne_zero hX),
    Units.mk0 _ (t₂_pos hX).ne', ⟨kGL g, kGL_mem g⟩), ⟨t₂_pos hX, exists_decomp g⟩, ?_⟩, ?_⟩
  · rintro p ⟨hp, hg⟩
    obtain ⟨ex, e1, e2, ek⟩ := coords_of_eq g p hp hg
    refine Prod.ext ex (Prod.ext (Units.ext e1) (Prod.ext (Units.ext e2) (Subtype.ext (Units.ext ?_))))
    rw [ek]; exact (kGL_val g).symm
  · intro p hp hg
    obtain ⟨ex, e1, e2, ek⟩ := coords_of_eq g p hp hg
    refine ⟨e2, ?_, ex, ?_⟩
    · rw [e1, e2]; rfl
    · rw [ek, e2]; ext i j; fin_cases i <;> fin_cases j <;> rfl

section Bruhat

/-! ### Bruhat decomposition (M3, unit U7) -/

theorem bwn_bottom {k : Type*} [Field k] (b : GL (Fin 2) k) (hb : (b : Matrix (Fin 2) (Fin 2) k) 1 0 = 0) (x : k) :
    ((b * weylElement k * upperRightHom x : GL (Fin 2) k) : Matrix (Fin 2) (Fin 2) k) 1 0 =
        -(b : Matrix (Fin 2) (Fin 2) k) 1 1 ∧
      ((b * weylElement k * upperRightHom x : GL (Fin 2) k) : Matrix (Fin 2) (Fin 2) k) 1 1 =
        -(b : Matrix (Fin 2) (Fin 2) k) 1 1 * x := by
  constructor <;> simp [weylElement, Matrix.mul_apply, Fin.sum_univ_two, hb]

/-- Existence on the big cell, with `x = g₂₂ / g₂₁`. -/
theorem big_cell_exists {k : Type*} [Field k] (g : GL (Fin 2) k) (hg : (g : Matrix (Fin 2) (Fin 2) k) 1 0 ≠ 0) :
    g * upperRightHom (-((g : Matrix (Fin 2) (Fin 2) k) 1 1 / (g : Matrix (Fin 2) (Fin 2) k) 1 0)) *
        (weylElement k)⁻¹ ∈ borel k ∧
      g = (g * upperRightHom (-((g : Matrix (Fin 2) (Fin 2) k) 1 1 / (g : Matrix (Fin 2) (Fin 2) k) 1 0)) *
        (weylElement k)⁻¹) * weylElement k *
          upperRightHom ((g : Matrix (Fin 2) (Fin 2) k) 1 1 / (g : Matrix (Fin 2) (Fin 2) k) 1 0) := by
  refine ⟨?_, ?_⟩
  · show ((g * upperRightHom _ * (weylElement k)⁻¹ : GL (Fin 2) k) : Matrix (Fin 2) (Fin 2) k) 1 0 = 0
    simp [weylElement, Units.inv_mk, Matrix.mul_apply, Fin.sum_univ_two]
    field_simp
    ring
  · rw [inv_mul_cancel_right, mul_assoc, ← AddChar.map_add_eq_mul, neg_add_cancel, AddChar.map_zero_eq_one,
      mul_one]

/-- Bruhat decomposition: over a field `k`, `GL₂(k) = B(k) ⊔ B(k) w N(k)`; `g ∈ B(k) ↔ g₂₁ = 0`, and every `g` with
`g₂₁ ≠ 0` lies in `B(k) w N(k)`. -/
@[tf_id "I.decomp.thm:bruhat-decomposition"]
theorem bruhat_decomposition (k : Type*) [Field k] :
    (∀ g : GL (Fin 2) k, g ∈ borel k ↔ (g : Matrix (Fin 2) (Fin 2) k) 1 0 = 0) ∧
      (∀ g : GL (Fin 2) k, (g : Matrix (Fin 2) (Fin 2) k) 1 0 ≠ 0 →
        ∃ b ∈ borel k, ∃ n ∈ unipotent k, g = b * weylElement k * n) ∧
      Disjoint (borel k : Set (GL (Fin 2) k))
        {g | ∃ b ∈ borel k, ∃ n ∈ unipotent k, g = b * weylElement k * n} ∧
      (borel k : Set (GL (Fin 2) k)) ∪ {g | ∃ b ∈ borel k, ∃ n ∈ unipotent k, g = b * weylElement k * n} =
        Set.univ := by
  have hex : ∀ g : GL (Fin 2) k, (g : Matrix (Fin 2) (Fin 2) k) 1 0 ≠ 0 →
      ∃ b ∈ borel k, ∃ n ∈ unipotent k, g = b * weylElement k * n := fun g hg ↦
    ⟨_, (big_cell_exists g hg).1, _, ⟨_, rfl⟩, (big_cell_exists g hg).2⟩
  refine ⟨fun g ↦ Iff.rfl, hex, ?_, ?_⟩
  · rw [Set.disjoint_left]
    rintro g hgB ⟨b, hb, _, ⟨x, rfl⟩, rfl⟩
    have h1 := (bwn_bottom b hb x).1
    have h2 : (b : Matrix (Fin 2) (Fin 2) k) 1 1 ≠ 0 := by
      intro h0
      have := (Matrix.isUnit_iff_isUnit_det _).mp b.isUnit
      rw [Matrix.det_fin_two, show (b : Matrix (Fin 2) (Fin 2) k) 1 0 = 0 from hb, h0] at this
      simp at this
    exact h2 (by have : _ = (0 : k) := hgB; rw [h1] at this; exact neg_eq_zero.mp this)
  · refine Set.eq_univ_of_forall fun g ↦ ?_
    by_cases hg : (g : Matrix (Fin 2) (Fin 2) k) 1 0 = 0
    · exact Or.inl hg
    · exact Or.inr (hex g hg)

/-- Uniqueness on the big cell: if `g₂₁ ≠ 0`, then `g = b w n(x)` for unique `b ∈ B(k)`, `x ∈ k`, and
`x = g₂₂ / g₂₁`. -/
@[tf_id "I.decomp.thm:bruhat-big-cell-unique"]
theorem bruhat_big_cell_unique (k : Type*) [Field k] (g : GL (Fin 2) k)
    (hg : (g : Matrix (Fin 2) (Fin 2) k) 1 0 ≠ 0) :
    (∃! p : GL (Fin 2) k × k, p.1 ∈ borel k ∧ g = p.1 * weylElement k * upperRightHom p.2) ∧
      ∀ (b : GL (Fin 2) k) (x : k), b ∈ borel k → g = b * weylElement k * upperRightHom x →
        x = (g : Matrix (Fin 2) (Fin 2) k) 1 1 / (g : Matrix (Fin 2) (Fin 2) k) 1 0 := by
  have hx : ∀ (b : GL (Fin 2) k) (x : k), b ∈ borel k → g = b * weylElement k * upperRightHom x →
      x = (g : Matrix (Fin 2) (Fin 2) k) 1 1 / (g : Matrix (Fin 2) (Fin 2) k) 1 0 := by
    rintro b x hb rfl
    obtain ⟨h1, h2⟩ := bwn_bottom b hb x
    rw [h1] at hg ⊢
    rw [h2]
    field_simp [neg_ne_zero.mp hg]
  refine ⟨⟨(_, _), ⟨(big_cell_exists g hg).1, (big_cell_exists g hg).2⟩, ?_⟩, hx⟩
  rintro ⟨b, x⟩ ⟨hb, hgb⟩
  have hx' := hx b x hb hgb
  refine Prod.ext ?_ hx'
  show b = g * upperRightHom (-((g : Matrix (Fin 2) (Fin 2) k) 1 1 / (g : Matrix (Fin 2) (Fin 2) k) 1 0)) *
    (weylElement k)⁻¹
  rw [← hx', hgb, mul_assoc b, mul_assoc b, mul_assoc (weylElement k), ← AddChar.map_add_eq_mul, add_neg_cancel,
    AddChar.map_zero_eq_one, mul_one, mul_inv_cancel_right]

end Bruhat

section IwasawaAdelic

/-! ### Adelic Iwasawa decomposition (M3, unit U7) -/

open scoped RestrictedProduct in
open Classical in
theorem iwasawa_fin (g : GL (Fin 2) FinAdele) : ∃ b ∈ borel FinAdele, ∃ k ∈ maxCompactFin, g = b * k := by
  have hloc := fun p : Nat.Primes ↦ Local.iwasawa_local ℚ_[p] (compFinPlace p g)
  let bp : ∀ p : Nat.Primes, GL (Fin 2) ℚ_[p] := fun p ↦
    if compFinPlace p g ∈ 𝐊[ℚ_[p]] then 1 else (hloc p).choose
  let kp : ∀ p : Nat.Primes, GL (Fin 2) ℚ_[p] := fun p ↦
    if compFinPlace p g ∈ 𝐊[ℚ_[p]] then compFinPlace p g else (hloc p).choose_spec.choose
  have hk : ∀ p : Nat.Primes, kp p ∈ 𝐊[ℚ_[p]] := fun p ↦ by
    simp only [kp]; split_ifs with h
    · exact h
    · exact (hloc p).choose_spec.choose_spec.1
  have hb10 : ∀ p : Nat.Primes, (bp p : Matrix (Fin 2) (Fin 2) ℚ_[p]) 1 0 = 0 := fun p ↦ by
    simp only [bp]; split_ifs with h
    · simp
    · exact (hloc p).choose_spec.choose_spec.2.1
  have hbk : ∀ p : Nat.Primes, bp p * kp p = compFinPlace p g := fun p ↦ by
    simp only [bp, kp]; split_ifs with h
    · exact one_mul _
    · exact (hloc p).choose_spec.choose_spec.2.2.symm
  let xb : Πʳ p : Nat.Primes, [GL (Fin 2) ℚ_[p], 𝐊[ℚ_[p]]] := ⟨bp, by
    filter_upwards [gl2Fin_eventually_mem g] with p hp
    simp only [bp, ite_eq_left hp]; exact (𝐊[ℚ_[p]]).one_mem⟩
  let xk : Πʳ p : Nat.Primes, [GL (Fin 2) ℚ_[p], 𝐊[ℚ_[p]]] := ⟨kp, Filter.Eventually.of_forall hk⟩
  refine ⟨finResEquiv.symm xb, ?_, finResEquiv.symm xk, ?_, ?_⟩
  · show ((finResEquiv.symm xb : GL (Fin 2) FinAdele) : Matrix (Fin 2) (Fin 2) FinAdele) 1 0 = 0
    ext p
    exact hb10 p
  · rw [mem_maxCompactFin_iff]
    intro p
    have : compFinPlace p (finResEquiv.symm xk) = kp p := rfl
    rw [this]; exact hk p
  · apply finResEquiv.injective
    rw [map_mul, finResEquiv.apply_symm_apply, finResEquiv.apply_symm_apply]
    ext p : 1
    exact (hbk p).symm

/-- `G(𝔸) = B(𝔸) K` and `G(𝔸_f) = B(𝔸_f) K_f`. -/
@[tf_id "I.decomp.thm:iwasawa-adelic"]
theorem iwasawa_adelic :
    (∀ g : GL (Fin 2) Adele, ∃ b ∈ borel Adele, ∃ k ∈ maxCompactAdelic, g = b * k) ∧
      ∀ g : GL (Fin 2) FinAdele, ∃ b ∈ borel FinAdele, ∃ k ∈ maxCompactFin, g = b * k := by
  refine ⟨fun g ↦ ?_, iwasawa_fin⟩
  obtain ⟨bf, hbf, kf, hkf, hgf⟩ := iwasawa_fin (compFin g)
  obtain ⟨⟨p, ⟨hp, hgi⟩, -⟩, -⟩ := iwasawa_real (compInf g)
  set bi := upperRightHom p.1 * diagElt p.2.1 p.2.2.1
  have hbi : (bi : Matrix (Fin 2) (Fin 2) ℝ) 1 0 = 0 := by
    simp [bi, diagElt, Matrix.mul_apply, Fin.sum_univ_two]
  let b : GL (Fin 2) Adele := glProdEquiv.symm (bi, bf)
  let k : GL (Fin 2) Adele := glProdEquiv.symm ((p.2.2.2 : GL (Fin 2) ℝ), kf)
  have hcb : compInf b = bi ∧ compFin b = bf :=
    Prod.ext_iff.mp ((glProdEquiv (R := ℝ) (S := FinAdele)).apply_symm_apply (bi, bf))
  have hck : compInf k = p.2.2.2 ∧ compFin k = kf :=
    Prod.ext_iff.mp ((glProdEquiv (R := ℝ) (S := FinAdele)).apply_symm_apply (_, kf))
  refine ⟨b, ?_, k, ?_, ?_⟩
  · show ((b : GL (Fin 2) Adele) : Matrix (Fin 2) (Fin 2) Adele) 1 0 = 0
    have e1 : ((b : Matrix (Fin 2) (Fin 2) Adele) 1 0).1 = 0 := by
      rw [← hbi, ← hcb.1]; rfl
    have e2 : ((b : Matrix (Fin 2) (Fin 2) Adele) 1 0).2 = 0 := by
      have : (bf : Matrix (Fin 2) (Fin 2) FinAdele) 1 0 = 0 := hbf
      rw [← this, ← hcb.2]; rfl
    exact Prod.ext e1 e2
  · rw [mem_maxCompactAdelic_iff, hck.1, hck.2]
    exact ⟨p.2.2.2.2.1, hkf⟩
  · apply gl_adele_ext
    · rw [map_mul, hcb.1, hck.1]; exact hgi
    · rw [map_mul, hcb.2, hck.2]; exact hgf

end IwasawaAdelic

section HeightMap

/-! ### The height map (M3, unit U7) -/

/-- `‖e₂ g‖_𝔸 = (c_∞² + d_∞²)^{1/2} ∏_p max(|c_p|_p, |d_p|_p)` for the bottom row `(c, d)` of `g` (a finite
product). -/
@[tf_aux "I.decomp.def:bottom-row-norm"]
noncomputable def bottomRowNorm (g : GL (Fin 2) Adele) : ℝ :=
  Real.sqrt (((g : Matrix (Fin 2) (Fin 2) Adele) 1 0).1 ^ 2 + ((g : Matrix (Fin 2) (Fin 2) Adele) 1 1).1 ^ 2) *
    ∏ᶠ p : Nat.Primes, max (Local.normAbs ℚ_[p] (((g : Matrix (Fin 2) (Fin 2) Adele) 1 0).2 p))
      (Local.normAbs ℚ_[p] (((g : Matrix (Fin 2) (Fin 2) Adele) 1 1).2 p))

theorem Kp_det_norm (p : Nat.Primes) (k : GL (Fin 2) ℚ_[p]) (hk : k ∈ 𝐊[ℚ_[p]]) :
    ‖(k : Matrix (Fin 2) (Fin 2) ℚ_[p]).det‖ = 1 := by
  have he := (mem_Kp_iff p k).mp hk
  have hint : ∀ A : Matrix (Fin 2) (Fin 2) ℚ_[p], (∀ i j, ‖A i j‖ ≤ 1) → ‖A.det‖ ≤ 1 := by
    intro A hA
    rw [Matrix.det_fin_two, sub_eq_add_neg]
    refine (Padic.nonarchimedean _ _).trans (max_le ?_ ?_)
    · rw [norm_mul]; exact mul_le_one₀ (hA 0 0) (norm_nonneg _) (hA 1 1)
    · rw [norm_neg, norm_mul]; exact mul_le_one₀ (hA 0 1) (norm_nonneg _) (hA 1 0)
  have h1 := hint _ fun i j ↦ (PadicInt.mem_subring_iff (p : ℕ)).mp (he i j).1
  have h2 := hint _ fun i j ↦ (PadicInt.mem_subring_iff (p : ℕ)).mp (he i j).2
  have hprod : (k : Matrix (Fin 2) (Fin 2) ℚ_[p]).det * ((k⁻¹ : GL (Fin 2) ℚ_[p]) : Matrix (Fin 2) (Fin 2) ℚ_[p]).det = 1 := by
    rw [← Matrix.det_mul, ← Units.val_mul, mul_inv_cancel, Units.val_one, Matrix.det_one]
  have hn := congrArg (fun x : ℚ_[p] ↦ ‖x‖) hprod
  rw [norm_mul, norm_one] at hn
  refine le_antisymm h1 ?_
  by_contra hlt
  push Not at hlt
  have : ‖(k : Matrix (Fin 2) (Fin 2) ℚ_[p]).det‖ * ‖((k⁻¹ : GL (Fin 2) ℚ_[p]) : Matrix (Fin 2) (Fin 2) ℚ_[p]).det‖ < 1 :=
    calc _ < 1 * ‖((k⁻¹ : GL (Fin 2) ℚ_[p]) : Matrix (Fin 2) (Fin 2) ℚ_[p]).det‖ :=
          mul_lt_mul_of_pos_right hlt (by
            rcases (norm_nonneg (((k⁻¹ : GL (Fin 2) ℚ_[p]) : Matrix (Fin 2) (Fin 2) ℚ_[p]).det)).lt_or_eq with h | h
            · exact h
            · rw [← h, mul_zero] at hn; exact absurd hn zero_ne_one)
      _ ≤ 1 := by rw [one_mul]; exact h2
  linarith

theorem Kp_bottom_max (p : Nat.Primes) (k : GL (Fin 2) ℚ_[p]) (hk : k ∈ 𝐊[ℚ_[p]]) :
    max ‖(k : Matrix (Fin 2) (Fin 2) ℚ_[p]) 1 0‖ ‖(k : Matrix (Fin 2) (Fin 2) ℚ_[p]) 1 1‖ = 1 := by
  have he := (mem_Kp_iff p k).mp hk
  have hle : ∀ i j, ‖(k : Matrix (Fin 2) (Fin 2) ℚ_[p]) i j‖ ≤ 1 := fun i j ↦
    (PadicInt.mem_subring_iff (p : ℕ)).mp (he i j).1
  refine le_antisymm (max_le (hle 1 0) (hle 1 1)) ?_
  have hd := Kp_det_norm p k hk
  rw [Matrix.det_fin_two, sub_eq_add_neg] at hd
  have := Padic.nonarchimedean ((k : Matrix (Fin 2) (Fin 2) ℚ_[p]) 0 0 * (k : Matrix (Fin 2) (Fin 2) ℚ_[p]) 1 1)
    (-((k : Matrix (Fin 2) (Fin 2) ℚ_[p]) 0 1 * (k : Matrix (Fin 2) (Fin 2) ℚ_[p]) 1 0))
  rw [hd, norm_neg, norm_mul, norm_mul] at this
  refine this.trans (max_le ?_ ?_)
  · exact (mul_le_of_le_one_left (norm_nonneg _) (hle 0 0)).trans (le_max_right _ _)
  · exact (mul_le_of_le_one_left (norm_nonneg _) (hle 0 1)).trans (le_max_left _ _)

/-- All factors of `‖e₂ g‖_𝔸` are positive and all but finitely many equal `1` (the claims of
`I.decomp.def:height-map`). -/
@[tf_aux "I.decomp.lem:bottom-row-norm-spec"]
theorem bottomRowNorm_spec (g : GL (Fin 2) Adele) :
    0 < ((g : Matrix (Fin 2) (Fin 2) Adele) 1 0).1 ^ 2 + ((g : Matrix (Fin 2) (Fin 2) Adele) 1 1).1 ^ 2 ∧
      (∀ p : Nat.Primes, 0 < max (Local.normAbs ℚ_[p] (((g : Matrix (Fin 2) (Fin 2) Adele) 1 0).2 p))
        (Local.normAbs ℚ_[p] (((g : Matrix (Fin 2) (Fin 2) Adele) 1 1).2 p))) ∧
      {p : Nat.Primes | max (Local.normAbs ℚ_[p] (((g : Matrix (Fin 2) (Fin 2) Adele) 1 0).2 p))
        (Local.normAbs ℚ_[p] (((g : Matrix (Fin 2) (Fin 2) Adele) 1 1).2 p)) ≠ 1}.Finite := by
  refine ⟨?_, fun p ↦ ?_, ?_⟩
  · have hd : (compInf g : Matrix (Fin 2) (Fin 2) ℝ).det ≠ 0 :=
      ((Matrix.isUnit_iff_isUnit_det _).mp (compInf g).isUnit).ne_zero
    rw [Matrix.det_fin_two] at hd
    by_contra h
    push Not at h
    have h1 : ((g : Matrix (Fin 2) (Fin 2) Adele) 1 0).1 = 0 := by nlinarith [sq_nonneg ((g : Matrix (Fin 2) (Fin 2) Adele) 1 0).1, sq_nonneg ((g : Matrix (Fin 2) (Fin 2) Adele) 1 1).1]
    have h2 : ((g : Matrix (Fin 2) (Fin 2) Adele) 1 1).1 = 0 := by nlinarith [sq_nonneg ((g : Matrix (Fin 2) (Fin 2) Adele) 1 0).1, sq_nonneg ((g : Matrix (Fin 2) (Fin 2) Adele) 1 1).1]
    apply hd
    show ((g : Matrix (Fin 2) (Fin 2) Adele) 0 0).1 * ((g : Matrix (Fin 2) (Fin 2) Adele) 1 1).1 -
      ((g : Matrix (Fin 2) (Fin 2) Adele) 0 1).1 * ((g : Matrix (Fin 2) (Fin 2) Adele) 1 0).1 = 0
    rw [h1, h2]; ring
  · rw [Local.normAbs_padic, Local.normAbs_padic]
    have hd : (compFinPlace p (compFin g) : Matrix (Fin 2) (Fin 2) ℚ_[p]).det ≠ 0 :=
      ((Matrix.isUnit_iff_isUnit_det _).mp (compFinPlace p (compFin g)).isUnit).ne_zero
    rw [Matrix.det_fin_two] at hd
    by_contra h
    push Not at h
    have h1 : ((g : Matrix (Fin 2) (Fin 2) Adele) 1 0).2 p = 0 :=
      norm_eq_zero.mp (le_antisymm ((le_max_left _ _).trans h) (norm_nonneg _))
    have h2 : ((g : Matrix (Fin 2) (Fin 2) Adele) 1 1).2 p = 0 :=
      norm_eq_zero.mp (le_antisymm ((le_max_right _ _).trans h) (norm_nonneg _))
    apply hd
    show ((g : Matrix (Fin 2) (Fin 2) Adele) 0 0).2 p * ((g : Matrix (Fin 2) (Fin 2) Adele) 1 1).2 p -
      ((g : Matrix (Fin 2) (Fin 2) Adele) 0 1).2 p * ((g : Matrix (Fin 2) (Fin 2) Adele) 1 0).2 p = 0
    rw [h1, h2]; ring
  · refine (Filter.eventually_cofinite.mp (gl2Fin_eventually_mem (compFin g))).subset fun p hp ↦ ?_
    intro hK
    apply hp
    rw [Local.normAbs_padic, Local.normAbs_padic]
    exact Kp_bottom_max p _ hK

/-- The height map `H_B(g) = (log|det g|_𝔸 − log‖e₂ g‖_𝔸, log‖e₂ g‖_𝔸) ∈ 𝔞_B`. -/
@[tf_id "I.decomp.def:height-map"]
noncomputable def heightMap (g : GL (Fin 2) Adele) : SpaceAB :=
  ![Real.log (ideleNorm (Matrix.GeneralLinearGroup.det g)) - Real.log (bottomRowNorm g),
    Real.log (bottomRowNorm g)]

theorem orth_row_one (k : GL (Fin 2) ℝ) (hk : k ∈ maxCompactReal) :
    (k : Matrix (Fin 2) (Fin 2) ℝ) 1 0 ^ 2 + (k : Matrix (Fin 2) (Fin 2) ℝ) 1 1 ^ 2 = 1 ∧
      |(k : Matrix (Fin 2) (Fin 2) ℝ).det| = 1 := by
  have h1 : (k : Matrix (Fin 2) (Fin 2) ℝ)ᵀ * k = 1 := hk
  have h2 : (k : Matrix (Fin 2) (Fin 2) ℝ) * (k : Matrix (Fin 2) (Fin 2) ℝ)ᵀ = 1 := mul_eq_one_comm.mp h1
  refine ⟨?_, ?_⟩
  · have := congrFun (congrFun h2 1) 1
    simp [Matrix.mul_apply, Fin.sum_univ_two] at this
    linarith [this]
  · have := congrArg Matrix.det h1
    rw [Matrix.det_mul, Matrix.det_transpose, Matrix.det_one] at this
    have h3 : |(k : Matrix (Fin 2) (Fin 2) ℝ).det| ^ 2 = 1 := by rw [sq_abs, sq]; exact this
    nlinarith [abs_nonneg (k : Matrix (Fin 2) (Fin 2) ℝ).det]

theorem ideleNorm_det_K (k : GL (Fin 2) Adele) (hk : k ∈ maxCompactAdelic) :
    ideleNorm (Matrix.GeneralLinearGroup.det k) = 1 := by
  obtain ⟨hki, hkf⟩ := (mem_maxCompactAdelic_iff k).mp hk
  show ideleNormFun _ = 1
  have hv : ∀ p : Nat.Primes, Local.normAbs ℚ_[p] (((Matrix.GeneralLinearGroup.det k : Idele) : Adele).2 p) = 1 := by
    intro p
    rw [Local.normAbs_padic, det_adele_val]
    have : ((Matrix.GeneralLinearGroup.det (compFin k) : FinAdeleˣ) : FinAdele) p =
        (compFinPlace p (compFin k) : Matrix (Fin 2) (Fin 2) ℚ_[p]).det :=
      RingHom.map_det (RestrictedProduct.evalRingHom (fun p : Nat.Primes ↦ ℚ_[p]) p)
        ((compFin k : GL (Fin 2) FinAdele) : Matrix (Fin 2) (Fin 2) FinAdele)
    rw [this]
    exact Kp_det_norm p _ ((mem_maxCompactFin_iff _).mp hkf p)
  rw [ideleNormFun, finprod_congr hv, finprod_one, mul_one, det_adele_val]
  exact (orth_row_one _ hki).2

/-- `H_B(n(x) diag(t₁, t₂) k) = (log|t₁|_𝔸, log|t₂|_𝔸)` for `k ∈ K`. -/
@[tf_id "I.decomp.thm:height-map-iwasawa"]
theorem heightMap_iwasawa (x : Adele) (t₁ t₂ : Idele) (k : GL (Fin 2) Adele) (hk : k ∈ maxCompactAdelic) :
    heightMap (upperRightHom x * diagElt t₁ t₂ * k) = ![Real.log (ideleNorm t₁), Real.log (ideleNorm t₂)] := by
  obtain ⟨hki, hkf⟩ := (mem_maxCompactAdelic_iff k).mp hk
  set g := upperRightHom x * diagElt t₁ t₂ * k
  have he10 : (g : Matrix (Fin 2) (Fin 2) Adele) 1 0 = (t₂ : Adele) * (k : Matrix (Fin 2) (Fin 2) Adele) 1 0 := by
    simp [g, diagElt, Matrix.mul_apply, Fin.sum_univ_two]
  have he11 : (g : Matrix (Fin 2) (Fin 2) Adele) 1 1 = (t₂ : Adele) * (k : Matrix (Fin 2) (Fin 2) Adele) 1 1 := by
    simp [g, diagElt, Matrix.mul_apply, Fin.sum_univ_two]
  have hbot : bottomRowNorm g = ideleNorm t₂ := by
    have hrow := (orth_row_one _ hki).1
    have hv : ∀ p : Nat.Primes, max (Local.normAbs ℚ_[p] (((g : Matrix (Fin 2) (Fin 2) Adele) 1 0).2 p))
        (Local.normAbs ℚ_[p] (((g : Matrix (Fin 2) (Fin 2) Adele) 1 1).2 p)) =
          Local.normAbs ℚ_[p] ((t₂ : Adele).2 p) := by
      intro p
      rw [he10, he11, Local.normAbs_padic, Local.normAbs_padic, Local.normAbs_padic]
      simp only [Prod.snd_mul, RestrictedProduct.mul_apply, norm_mul]
      rw [← mul_max_of_nonneg _ _ (norm_nonneg _)]
      have := Kp_bottom_max p _ ((mem_maxCompactFin_iff _).mp hkf p)
      erw [this, mul_one]
    show _ = ideleNormFun t₂
    rw [bottomRowNorm, finprod_congr hv, ideleNormFun, he10, he11]
    congr 1
    simp only [Prod.fst_mul]
    have : ((t₂ : Adele).1 * ((k : Matrix (Fin 2) (Fin 2) Adele) 1 0).1) ^ 2 +
        ((t₂ : Adele).1 * ((k : Matrix (Fin 2) (Fin 2) Adele) 1 1).1) ^ 2 = (t₂ : Adele).1 ^ 2 := by
      have hrow' : ((k : Matrix (Fin 2) (Fin 2) Adele) 1 0).1 ^ 2 + ((k : Matrix (Fin 2) (Fin 2) Adele) 1 1).1 ^ 2 = 1 :=
        hrow
      linear_combination (t₂ : Adele).1 ^ 2 * hrow'
    rw [this, Real.sqrt_sq_eq_abs]
  have hdet : ideleNorm (Matrix.GeneralLinearGroup.det g) = ideleNorm t₁ * ideleNorm t₂ := by
    have hn : Matrix.GeneralLinearGroup.det (upperRightHom x) = 1 := by
      apply Units.ext; simp [Matrix.GeneralLinearGroup.det]
    have hd : Matrix.GeneralLinearGroup.det (diagElt t₁ t₂) = t₁ * t₂ := by
      apply Units.ext; simp [Matrix.GeneralLinearGroup.det, diagElt, Matrix.det_fin_two]
    simp only [g, map_mul, hn, hd, one_mul, ideleNorm_det_K k hk, mul_one]
  have h1 := ideleNorm_spec.2.1 t₁
  have h2 := ideleNorm_spec.2.1 t₂
  rw [heightMap, hdet, hbot, Real.log_mul h1.ne' h2.ne', add_sub_cancel_right]

theorem borel_eq_n_t {R : Type*} [CommRing R] (b : GL (Fin 2) R) (hb : b ∈ borel R) :
    ∃ (y : R) (t₁ t₂ : Rˣ), b = upperRightHom y * diagElt t₁ t₂ := by
  have h10 : (b : Matrix (Fin 2) (Fin 2) R) 1 0 = 0 := hb
  have hd := (Matrix.isUnit_iff_isUnit_det _).mp b.isUnit
  rw [Matrix.det_fin_two, h10, mul_zero, sub_zero] at hd
  set t₂ := (isUnit_of_mul_isUnit_right hd).unit
  refine ⟨(b : Matrix (Fin 2) (Fin 2) R) 0 1 * ((t₂⁻¹ : Rˣ) : R), (isUnit_of_mul_isUnit_left hd).unit, t₂, ?_⟩
  have hu : ((t₂⁻¹ : Rˣ) : R) * (b : Matrix (Fin 2) (Fin 2) R) 1 1 = 1 := by
    rw [← (isUnit_of_mul_isUnit_right hd).unit_spec]; exact Units.inv_mul _
  apply Units.ext; refine Matrix.ext fun i j ↦ ?_
  fin_cases i <;> fin_cases j <;> simp [diagElt, Matrix.mul_apply, Fin.sum_univ_two, h10, t₂]
  rw [mul_assoc, hu, mul_one]

theorem heightMap_diag (t₁ t₂ : Idele) :
    heightMap (diagElt t₁ t₂) = ![Real.log (ideleNorm t₁), Real.log (ideleNorm t₂)] := by
  have := heightMap_iwasawa 0 t₁ t₂ 1 maxCompactAdelic.one_mem
  rwa [AddChar.map_zero_eq_one, one_mul, mul_one] at this

/-- `H_B(n t x k) = H_B(t) + H_B(x)` for `n ∈ N(𝔸)`, `t ∈ T(𝔸)`, `k ∈ K`; `H_B(γ x) = H_B(x)` and `H_B(γ) = 0`
for `γ ∈ B(ℚ)`. -/
@[tf_id "I.decomp.thm:height-map-equivariance"]
theorem heightMap_equivariance :
    (∀ n ∈ unipotent Adele, ∀ t ∈ torus Adele, ∀ (x : GL (Fin 2) Adele), ∀ k ∈ maxCompactAdelic,
      heightMap (n * t * x * k) = heightMap t + heightMap x) ∧
      ∀ γ ∈ (borel ℚ).map (gl2Map (algebraMap ℚ Adele)), ∀ x : GL (Fin 2) Adele,
        heightMap (γ * x) = heightMap x ∧ heightMap γ = 0 := by
  have hmain : ∀ n ∈ unipotent Adele, ∀ t ∈ torus Adele, ∀ (x : GL (Fin 2) Adele), ∀ k ∈ maxCompactAdelic,
      heightMap (n * t * x * k) = heightMap t + heightMap x := by
    rintro _ ⟨y, rfl⟩ t ht x k hk
    obtain ⟨t₁, t₂, rfl⟩ := exists_diagElt_of_mem_torus' ht
    obtain ⟨b, hb, k', hk', rfl⟩ := iwasawa_adelic.1 x
    obtain ⟨y', s₁, s₂, rfl⟩ := borel_eq_n_t b hb
    have hcomm : diagElt t₁ t₂ * upperRightHom y' =
        upperRightHom (((t₁ * t₂⁻¹ : Adeleˣ) : Adele) * y') * diagElt t₁ t₂ := by
      rw [← (torus_normalizes_unipotent Adele).1 t₁ t₂ y', inv_mul_cancel_right]
    have hrw : upperRightHom y * diagElt t₁ t₂ * (upperRightHom y' * diagElt s₁ s₂ * k') * k =
        upperRightHom (y + ((t₁ * t₂⁻¹ : Adeleˣ) : Adele) * y') * diagElt (t₁ * s₁) (t₂ * s₂) * (k' * k) := by
      rw [AddChar.map_add_eq_mul, (diagElt_hom.2 t₁ t₂ s₁ s₂), ← mul_assoc, ← mul_assoc, ← mul_assoc,
        mul_assoc (upperRightHom y) (diagElt t₁ t₂), hcomm]
      group
    rw [hrw, heightMap_iwasawa _ _ _ _ (maxCompactAdelic.mul_mem hk' hk), heightMap_diag,
      heightMap_iwasawa _ _ _ _ hk', map_mul, map_mul,
      Real.log_mul (ideleNorm_spec.2.1 _).ne' (ideleNorm_spec.2.1 _).ne',
      Real.log_mul (ideleNorm_spec.2.1 _).ne' (ideleNorm_spec.2.1 _).ne']
    funext i; fin_cases i <;> simp
  refine ⟨hmain, ?_⟩
  rintro _ ⟨b, hb, rfl⟩ x
  obtain ⟨y, q₁, q₂, rfl⟩ := borel_eq_n_t b hb
  have hγ : gl2Map (algebraMap ℚ Adele) (upperRightHom y * diagElt q₁ q₂) =
      upperRightHom (algebraMap ℚ Adele y) * diagElt (ratIdele q₁) (ratIdele q₂) := by
    rw [map_mul, (subgroups_functorial (algebraMap ℚ Adele)).2.2.2.2.2.2.1,
      (subgroups_functorial (algebraMap ℚ Adele)).2.2.2.2.2.2.2.2]
    rfl
  have h0 : heightMap (diagElt (ratIdele q₁) (ratIdele q₂)) = 0 := by
    rw [heightMap_diag, product_formula, product_formula, Real.log_one]
    funext i; fin_cases i <;> simp
  have hx : ∀ x, heightMap (gl2Map (algebraMap ℚ Adele) (upperRightHom y * diagElt q₁ q₂) * x) = heightMap x := by
    intro x
    have := hmain (upperRightHom (algebraMap ℚ Adele y)) ⟨_, rfl⟩ (diagElt (ratIdele q₁) (ratIdele q₂))
      ⟨rfl, rfl⟩ x 1 maxCompactAdelic.one_mem
    rw [mul_one, h0, zero_add] at this
    rw [hγ, this]
  refine ⟨hx x, ?_⟩
  have := hx 1
  rw [mul_one] at this
  rw [this, show (1 : GL (Fin 2) Adele) = diagElt 1 1 from diagElt_hom.1.symm, heightMap_diag, map_one,
    Real.log_one]
  funext i; fin_cases i <;> simp

end HeightMap

end GL2TF
