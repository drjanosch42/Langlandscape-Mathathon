/-!
# Gorenstein algebras, annihilators, congruence ideals, new/old data (S06-L1)

`mathematics/chapters/s06/s06-m1.tex`: `def:s06-gor`, `lem:s06-cyclic`, `lem:s06-S`, `lem:s06-D`,
`lem:s06-split`, `if:s06-lemD`
(fixed signature); `def:s06-rings` is in `s06-m2.tex`. Secondary reference:
`plan/staged/stage-06-integral-defect.tex` (`ss:s06-ca`), `plan/implementation/stage-06.md` §0.

Mathlib v4.35 has no Gorenstein algebras or congruence ideals; this file defines them.

* `IsGorensteinWith A S ℓ`: `S` is finite free over `A` and `s ↦ ℓ(s ·)` is a bijection
  `S ≃ Hom_A(S, A)`, i.e. `S^∨` is free of rank one over `S` with generator `ℓ` (a *trace*).
* `IsGorenstein A S`: some trace exists (tex: `S` is `A`-Gorenstein).
* `ann I`: the annihilator `Ann_S(I)` of an ideal.
* `congruenceIdeal μ`: `η(S, μ) = μ(Ann_S(ker μ))` for an `A`-algebra map `μ : S → A`.
* `NewOldData A S`: the hypotheses of `lem:s06-D` (`S` finite free, `S/𝔞`, `S/𝔟` torsion-free,
  `𝔞 ∩ 𝔟 = 0`, and the field-free splitting `c ∈ 𝔞 + 𝔟` for some `c ≠ 0`); `NewOldData.split_iff`
  shows that the last field is the splitting `S_K = (S/𝔞)_K × (S/𝔟)_K` of the tex.
* `IsGorensteinWith.of_surjective`, `isGorenstein_iff_cyclic` (`lem:s06-cyclic`): `S` is Gorenstein
  iff `S^∨` is a cyclic `S`-module (Orzech property); a generator is a trace.

Not formalized: `NewOldData.split_iff` is the second equivalence of `lem:s06-split` only; the CRT
equivalence `S_K ≅ (S/𝔞)_K × (S/𝔟)_K` iff `(𝔞 + 𝔟) S_K = S_K` (using `𝔞 ⊓ 𝔟 = ⊥` and flatness)
is not formalized.
-/

@[expose] public section

set_option autoImplicit false

namespace Langlandscape.CommAlg

open scoped TensorProduct

variable {A S : Type*} [CommRing A] [CommRing S] [Algebra A S]

variable (A S) in
/-- `ss:s06-ca` (`s06-ca`): `S` is `A`-Gorenstein with trace `ℓ`: `S` is finite free over `A` and
`s ↦ ℓ ∘ (s ·)` is a bijection `S → Hom_A(S, A)`, i.e. `S^∨` is free of rank one over `S`,
generated by `ℓ`. -/
def IsGorensteinWith (ℓ : Module.Dual A S) : Prop :=
  Module.Free A S ∧ Module.Finite A S ∧ Function.Bijective (fun s : S => ℓ ∘ₗ LinearMap.mulLeft A s)

variable (A S) in
/-- `ss:s06-ca` (`s06-ca`): `S` is `A`-Gorenstein: finite free with `S^∨` free of rank one over
`S`. -/
def IsGorenstein : Prop := ∃ ℓ : Module.Dual A S, IsGorensteinWith A S ℓ

/-- `ss:s06-ca` (`s06-ca`): the annihilator `Ann_S(I)` of an ideal `I` of `S`. -/
def ann (I : Ideal S) : Ideal S := (⊥ : Ideal S).colon (I : Set S)

/-- `ss:s06-ca`, `lem:s06-S` (`s06-S`): the congruence ideal `η(S, μ) = μ(Ann_S(ker μ)) ⊆ A`. -/
def congruenceIdeal (μ : S →ₐ[A] A) : Ideal A := (ann (RingHom.ker μ)).map μ

variable (A S) in
/-- `lem:s06-D` (`s06-D`), `def:s06-rings`: the hypotheses of the new/old duality lemma. `S` is
finite
free over `A`, `𝔞` (new kernel) and `𝔟` (old kernel) are ideals with `A`-torsion-free quotients,
`𝔞 ⊓ 𝔟 = ⊥`, and `split` is the field-free form of `S_K = (S/𝔞)_K × (S/𝔟)_K`
(see `NewOldData.split_iff`). -/
structure NewOldData where
  /-- the new kernel `𝔞` (`S/𝔞` is the new quotient) -/
  𝔞 : Ideal S
  /-- the old kernel `𝔟` -/
  𝔟 : Ideal S
  /-- `S` is free over `A` -/
  free : Module.Free A S
  /-- `S` is finite over `A` -/
  finite : Module.Finite A S
  /-- `S/𝔞` is `A`-torsion-free -/
  tf_a : Module.IsTorsionFree A (S ⧸ 𝔞)
  /-- `S/𝔟` is `A`-torsion-free -/
  tf_b : Module.IsTorsionFree A (S ⧸ 𝔟)
  /-- `𝔞 ∩ 𝔟 = 0` -/
  inf_eq_bot : 𝔞 ⊓ 𝔟 = ⊥
  /-- field-free form of `S_K = (S/𝔞)_K × (S/𝔟)_K` -/
  split : ∃ c : A, c ≠ 0 ∧ algebraMap A S c ∈ 𝔞 ⊔ 𝔟

/-- `ss:s06-ca` (`s06-ca`): membership in the annihilator `ann I`. -/
theorem mem_ann {I : Ideal S} {x : S} : x ∈ ann I ↔ ∀ y ∈ I, x * y = 0 := by
  unfold ann
  rw [Submodule.mem_colon]
  simp [smul_eq_mul]

/-- `ss:s06-ca` (`s06-ca`): `ann` is antitone. -/
theorem ann_anti {I J : Ideal S} (h : I ≤ J) : ann J ≤ ann I := fun _ hx =>
  mem_ann.2 fun y hy => mem_ann.1 hx y (h hy)

/-- `ss:s06-ca` (`s06-ca`): the `A`-linear map `s ↦ ℓ ∘ (s ·)`, `S → S^∨`, whose bijectivity is
`IsGorensteinWith`. -/
def mulDual (ℓ : Module.Dual A S) : S →ₗ[A] Module.Dual A S :=
  (LinearMap.mul A S).compr₂ ℓ

/-- `ss:s06-ca` (`s06-ca`): `mulDual ℓ s = ℓ ∘ (s ·)`. -/
theorem mulDual_apply (ℓ : Module.Dual A S) (s : S) :
    mulDual ℓ s = ℓ ∘ₗ LinearMap.mulLeft A s := rfl

/-- `ss:s06-ca` (`s06-ca`): `mulDual ℓ s x = ℓ (s * x)`. -/
theorem mulDual_apply_apply (ℓ : Module.Dual A S) (s x : S) :
    mulDual ℓ s x = ℓ (s * x) := rfl

/-- `ss:s06-ca` (`s06-ca`): the bijectivity in `IsGorensteinWith` is that of `mulDual ℓ`. -/
theorem IsGorensteinWith.bijective {ℓ : Module.Dual A S} (h : IsGorensteinWith A S ℓ) :
    Function.Bijective (mulDual ℓ) := h.2.2

/-- `ss:s06-ca` (`s06-ca`): a trace is nondegenerate: `ℓ (s * x) = 0` for all `x` forces `s = 0`. -/
theorem IsGorensteinWith.eq_zero_of_forall {ℓ : Module.Dual A S} (h : IsGorensteinWith A S ℓ)
    {s : S} (hs : ∀ x, ℓ (s * x) = 0) : s = 0 := by
  apply h.bijective.1
  rw [map_zero]
  exact LinearMap.ext fun x => hs x

/-- `ss:s06-ca` (`s06-ca`): every `φ ∈ S^∨` is `ℓ (s ·)` for some `s`. -/
theorem IsGorensteinWith.exists_eq {ℓ : Module.Dual A S} (h : IsGorensteinWith A S ℓ)
    (φ : Module.Dual A S) : ∃ s : S, ∀ x, φ x = ℓ (s * x) := by
  obtain ⟨s, hs⟩ := h.bijective.2 φ
  exact ⟨s, fun x => by rw [← hs, mulDual_apply_apply]⟩

/-- `lem:s06-split` (`s06-D`): the field `split` of `NewOldData` is the splitting
`S_K = (S/𝔞)_K × (S/𝔟)_K` of the tex: some nonzero `c ∈ A` lies in `𝔞 + 𝔟` iff `𝔞 + 𝔟` generates
the unit ideal of `K ⊗_A S`, `K = Frac A`. This is the second equivalence of `lem:s06-split`; the
CRT equivalence is not formalized. -/
theorem NewOldData.split_iff [IsDomain A] (𝔞 𝔟 : Ideal S) :
    (∃ c : A, c ≠ 0 ∧ algebraMap A S c ∈ 𝔞 ⊔ 𝔟) ↔
      (𝔞 ⊔ 𝔟).map (Algebra.TensorProduct.includeRight : S →ₐ[A] FractionRing A ⊗[A] S) = ⊤ := by
  set J : Ideal S := 𝔞 ⊔ 𝔟 with hJ
  let f : S →ₐ[A] FractionRing A ⊗[A] S := Algebra.TensorProduct.includeRight
  let g : S →ₗ[A] FractionRing A ⊗[A] S := TensorProduct.mk A (FractionRing A) S 1
  have hfg : ∀ s, f s = g s := fun s => rfl
  have hsmul1 : ∀ a : A, a • (1 : FractionRing A ⊗[A] S) = f (algebraMap A S a) := fun a => by
    rw [AlgHom.commutes, Algebra.algebraMap_eq_smul_one]
  constructor
  · rintro ⟨c, hc, hcJ⟩
    have hmem : f (algebraMap A S c) ∈ J.map f := Ideal.mem_map_of_mem f hcJ
    refine Ideal.eq_top_of_isUnit_mem _ hmem ?_
    rw [← hsmul1, ← algebraMap_smul (FractionRing A) c (1 : FractionRing A ⊗[A] S),
      ← Algebra.algebraMap_eq_smul_one]
    refine IsUnit.map _ (IsUnit.mk0 _ ?_)
    exact (map_ne_zero_iff _ (IsFractionRing.injective A (FractionRing A))).2 hc
  · intro h
    have key : ∀ x ∈ J.map f, ∃ d : nonZeroDivisors A, ∃ j ∈ J, (d : A) • x = f j := by
      intro x hx
      induction hx using Submodule.span_induction with
      | mem x hx =>
        obtain ⟨j, hj, rfl⟩ := hx
        exact ⟨1, j, hj, by simp⟩
      | zero => exact ⟨1, 0, J.zero_mem, by simp⟩
      | add x y _ _ hx hy =>
        obtain ⟨d₁, j₁, hj₁, e₁⟩ := hx
        obtain ⟨d₂, j₂, hj₂, e₂⟩ := hy
        refine ⟨d₁ * d₂, (d₂ : A) • j₁ + (d₁ : A) • j₂,
          J.add_mem (Submodule.smul_of_tower_mem J _ hj₁) (Submodule.smul_of_tower_mem J _ hj₂), ?_⟩
        rw [map_add, map_smul, map_smul, ← e₁, ← e₂, smul_add, Submonoid.coe_mul, mul_smul,
          mul_smul, smul_comm (d₁ : A) (d₂ : A) x]
      | smul a x _ hx =>
        obtain ⟨d, j, hj, e⟩ := hx
        obtain ⟨⟨s, e'⟩, he⟩ := IsLocalizedModule.surj (nonZeroDivisors A) g a
        refine ⟨e' * d, s * j, J.mul_mem_left s hj, ?_⟩
        rw [smul_eq_mul, Submonoid.coe_mul, ← smul_mul_smul_comm, e, map_mul, hfg s]
        congr 1
    obtain ⟨d, j, hj, e⟩ := key 1 (by rw [h]; exact Submodule.mem_top)
    rw [hsmul1, hfg, hfg] at e
    obtain ⟨c, hc⟩ := IsLocalizedModule.exists_of_eq (S := nonZeroDivisors A) (f := g) e
    refine ⟨((c * d : nonZeroDivisors A) : A), nonZeroDivisors.coe_ne_zero _, ?_⟩
    rw [Submonoid.coe_mul, map_mul, ← Algebra.smul_def]
    rw [Submonoid.smul_def, Submonoid.smul_def] at hc
    rw [hc]
    exact Submodule.smul_of_tower_mem J _ hj

/-- `ss:s06-ca` (`s06-ca`): transport of a trace along an `A`-algebra isomorphism. -/
theorem IsGorensteinWith.of_algEquiv {S' : Type*} [CommRing S'] [Algebra A S']
    {ℓ : Module.Dual A S} (h : IsGorensteinWith A S ℓ) (e : S ≃ₐ[A] S') :
    IsGorensteinWith A S' (ℓ ∘ₗ e.symm.toLinearMap) := by
  obtain ⟨hfree, hfin, hbij⟩ := h
  refine ⟨Module.Free.of_equiv e.toLinearEquiv, Module.Finite.equiv e.toLinearEquiv, ?_⟩
  let P : Module.Dual A S → Module.Dual A S' := fun φ => φ ∘ₗ e.symm.toLinearMap
  have hP : Function.Bijective P := by
    refine Function.bijective_iff_has_inverse.2 ⟨fun ψ => ψ ∘ₗ e.toLinearMap, ?_, ?_⟩
    · intro φ; ext x; simp [P]
    · intro ψ; ext x; simp [P]
  have hfun : (fun s' : S' => (ℓ ∘ₗ e.symm.toLinearMap) ∘ₗ LinearMap.mulLeft A s') =
      P ∘ (fun s : S => ℓ ∘ₗ LinearMap.mulLeft A s) ∘ e.symm := by
    funext s'
    ext x
    simp [P, map_mul]
  rw [hfun]
  exact (hP.comp hbij).comp e.symm.bijective

/-- `ss:s06-ca` (`s06-ca`): the Gorenstein property is invariant under `A`-algebra isomorphisms. -/
theorem IsGorenstein.of_algEquiv {S' : Type*} [CommRing S'] [Algebra A S']
    (h : IsGorenstein A S) (e : S ≃ₐ[A] S') : IsGorenstein A S' :=
  let ⟨_, hℓ⟩ := h
  ⟨_, hℓ.of_algEquiv e⟩

/-- `lem:s06-cyclic` (`s06-ca`): if `S` is finite free over `A` and `s ↦ ℓ (s ·)` is surjective onto
`S^∨`, then `ℓ` is a trace: a surjective endomorphism of a finite free module is injective
(Orzech property of commutative rings). -/
theorem IsGorensteinWith.of_surjective {ℓ : Module.Dual A S} [Module.Free A S] [Module.Finite A S]
    (hsurj : Function.Surjective (mulDual ℓ)) : IsGorensteinWith A S ℓ := by
  let e : S ≃ₗ[A] Module.Dual A S := (Module.Free.chooseBasis A S).toDualEquiv
  have hinj : Function.Injective (e.symm.toLinearMap ∘ₗ mulDual ℓ) :=
    OrzechProperty.injective_of_surjective_endomorphism _ (e.symm.surjective.comp hsurj)
  refine ⟨inferInstance, inferInstance, ?_, hsurj⟩
  intro s t hst
  apply hinj
  simp only [LinearMap.coe_comp, Function.comp_apply]
  exact congrArg _ hst

/-- `ss:s06-ca` (`s06-ca`): `S` is `A`-Gorenstein iff it is finite free and `S^∨` is a cyclic
`S`-module (generated by some `ℓ`). The surjection `S → S^∨` between free modules of the same finite
rank is then bijective by the Orzech property of commutative rings. -/
theorem isGorenstein_iff_cyclic :
    IsGorenstein A S ↔ Module.Free A S ∧ Module.Finite A S ∧
      ∃ ℓ : Module.Dual A S, ∀ φ : Module.Dual A S, ∃ s : S, φ = ℓ ∘ₗ LinearMap.mulLeft A s := by
  constructor
  · rintro ⟨ℓ, hfree, hfin, hbij⟩
    exact ⟨hfree, hfin, ℓ, fun φ => (hbij.2 φ).imp fun s hs => hs.symm⟩
  · rintro ⟨hfree, hfin, ℓ, hℓ⟩
    have hsurj : Function.Surjective (mulDual ℓ) := fun φ =>
      (hℓ φ).imp fun s hs => (mulDual_apply ℓ s).trans hs.symm
    have := hfree
    have := hfin
    exact ⟨ℓ, IsGorensteinWith.of_surjective hsurj⟩

end Langlandscape.CommAlg
