import Langlandscape.Brandt.ImportDictionary

/-!
# `BrandtStabFree` part B, piece E (tex steps (i)–(ii)): the ring `A = ℤ[γ]` is a PID

This file proves `principality`.
Everything is in the global definite quaternion algebra `B = QuatAlg ℚ a b`, no adeles.

Math (tex `lem:s03-stabfree` steps (i)–(ii)): for `γ ∈ B` with `γ² = tγ - 1`, `t ∈ {-1,0,1}`
(e.g. from the import's `unit_cases`), the ring `A := ℤ[X]/(X² - tX + 1)` (a model of `ℤ[γ]`)
is a Euclidean domain for the norm `N(a + bX) = a² + t a b + b²` (positive definite since
`t² < 4`): for `α β⁻¹ = u + v γ ∈ ℚ(γ)`, round `u, v` to nearest integers `m, n`
(`|u - m|, |v - n| ≤ 1/2`), then `N(α/β - (m + nγ)) ≤ 3/4 < 1`, so
`N(α - β(m+nγ)) = N(β) · N(...) < N(β)`. Hence every ideal is generated by a norm-minimal
nonzero element (PID), and `[A : βA] = |det(mult by β)| = N(β)`. Applied to an ideal
`I ⊇ ℓA` of prime index `ℓ`: `I = πA` and `nrd(π(γ)) = N(π) = [A:I] = ℓ`.

Provenance: draft by mistral-large-4-0 via opencode (external, user-run; branch `abhijit/brandtstabfree`,
c170335d), integrated and audited by the Langlandscape agents.
-/

set_option autoImplicit false

namespace Langlandscape.StabFree.Principal

open GL2TF Polynomial

variable {a b : ℤ}

/-- `A t := ℤ[X]/(X² - tX + 1)`, a model of the ring `A = ℤ[γ]` of tex step (ii). -/
abbrev Zgam (t : ℤ) : Type :=
  AdjoinRoot (Polynomial.X ^ 2 - Polynomial.C t * Polynomial.X + 1)

/-- `X² - tX + 1` evaluates to `0` at `γ` when `γ² = tγ - 1`. (`s03-stabfree`) -/
theorem Zgam.aeval_of_sq {t : ℤ} {γ : GL2TF.Quat.QuatAlg ℚ a b}
    (hg : γ ^ 2 = (t : ℚ) • γ - 1) :
    Polynomial.aeval γ (Polynomial.X ^ 2 - Polynomial.C t * Polynomial.X + 1) = 0 := by
  have hg' : γ ^ 2 = algebraMap ℚ (GL2TF.Quat.QuatAlg ℚ a b) (t : ℚ) * γ - 1 := by
    rw [Algebra.smul_def] at hg
    exact hg
  simp only [map_sub, map_add, map_pow, aeval_X, aeval_C, map_one, map_mul]
  have hcast : algebraMap ℤ (GL2TF.Quat.QuatAlg ℚ a b) t =
      algebraMap ℚ (GL2TF.Quat.QuatAlg ℚ a b) (t : ℚ) := by
    push_cast
    rfl
  rw [hcast, hg']
  abel

/-- Evaluation `A t → B`, `X ↦ γ` (well-defined since `γ² = tγ - 1`; `B` is not commutative, so
this is `Ideal.Quotient.lift` on the presentation `A t = ℤ[X] ⧸ (X² - tX + 1)`). -/
noncomputable def Zgam.toB (t : ℤ) (γ : GL2TF.Quat.QuatAlg ℚ a b)
    (h : Polynomial.aeval γ (Polynomial.X ^ 2 - Polynomial.C t * Polynomial.X + 1) = 0) :
    Zgam t →+* GL2TF.Quat.QuatAlg ℚ a b :=
  Ideal.Quotient.lift (Ideal.span {Polynomial.X ^ 2 - Polynomial.C t * Polynomial.X + 1})
    (Polynomial.aeval γ).toRingHom (by
      intro x hx
      rw [Ideal.mem_span_singleton] at hx
      obtain ⟨q, rfl⟩ := hx
      rw [map_mul, AlgHom.toRingHom_eq_coe, AlgHom.coe_toRingHom, h, zero_mul])

section Aux

variable (t : ℤ)

/-- `s03-stabfree`: auxiliary lemma `monic_f` (`lem:s03-stabfree`). -/
private theorem monic_f : (X ^ 2 - C t * X + 1 : ℤ[X]).Monic := by monicity!

/-- `s03-stabfree`: auxiliary lemma `natDegree_f` (`lem:s03-stabfree`). -/
private theorem natDegree_f : (X ^ 2 - C t * X + 1 : ℤ[X]).natDegree = 2 := by compute_degree!

/-- The power basis of `Zgam t` over `ℤ`. -/
private noncomputable def pb : PowerBasis ℤ (Zgam t) := AdjoinRoot.powerBasis' (monic_f t)

/-- `s03-stabfree`: auxiliary lemma `pb_gen` (`lem:s03-stabfree`). -/
private theorem pb_gen : (pb t).gen = AdjoinRoot.root (X ^ 2 - C t * X + 1) :=
  AdjoinRoot.powerBasis'_gen (monic_f t)

/-- `s03-stabfree`: auxiliary lemma `pb_dim` (`lem:s03-stabfree`). -/
private theorem pb_dim : (pb t).dim = 2 :=
  (AdjoinRoot.powerBasis'_dim (monic_f t)).trans (natDegree_f t)

/-- The `ℤ`-basis `{1, X}` of `Zgam t`, indexed by `Fin 2`. -/
private noncomputable def bas : Module.Basis (Fin 2) ℤ (Zgam t) :=
  (pb t).basis.reindex (finCongr (pb_dim t))

/-- `s03-stabfree`: auxiliary lemma `bas_zero` (`lem:s03-stabfree`). -/
private theorem bas_zero : bas t 0 = 1 := by
  have h0 : (((finCongr (pb_dim t)).symm (0 : Fin 2) : Fin (pb t).dim) : ℕ) = 0 := by simp
  show ((pb t).basis.reindex (finCongr (pb_dim t))) 0 = 1
  rw [Module.Basis.reindex_apply, PowerBasis.basis_eq_pow, pb_gen, h0, pow_zero]

/-- `s03-stabfree`: auxiliary lemma `bas_one` (`lem:s03-stabfree`). -/
private theorem bas_one : bas t 1 = AdjoinRoot.root (X ^ 2 - C t * X + 1) := by
  have h1 : (((finCongr (pb_dim t)).symm (1 : Fin 2) : Fin (pb t).dim) : ℕ) = 1 := by simp
  show ((pb t).basis.reindex (finCongr (pb_dim t))) 1 = AdjoinRoot.root (X ^ 2 - C t * X + 1)
  rw [Module.Basis.reindex_apply, PowerBasis.basis_eq_pow, pb_gen, h1, pow_one]

/-- Shorthand for the root `X` of `Zgam t`. -/
private noncomputable abbrev rt (t : ℤ) : Zgam t := AdjoinRoot.root (X ^ 2 - C t * X + 1)

/-- The defining relation `X² = tX - 1` in `Zgam t`. (`s03-stabfree`) -/
private theorem rt_sq : rt t ^ 2 = algebraMap ℤ (Zgam t) t * rt t - 1 := by
  have h : AdjoinRoot.mk (X ^ 2 - C t * X + 1 : ℤ[X]) (X ^ 2 - C t * X + 1) = 0 :=
    AdjoinRoot.mk_self
  simp only [map_sub, map_add, map_pow, map_mul, map_one, AdjoinRoot.mk_X] at h
  rw [show AdjoinRoot.mk (X ^ 2 - C t * X + 1 : ℤ[X]) (C t) = algebraMap ℤ (Zgam t) t by
    rw [AdjoinRoot.algebraMap_eq]; rfl] at h
  have h2 : rt t ^ 2 - algebraMap ℤ (Zgam t) t * rt t + 1 = 0 := h
  linear_combination h2

/-- Coordinates of `x : Zgam t` in the basis `{1, X}`. -/
private noncomputable def crd0 (x : Zgam t) : ℤ := (bas t).repr x 0
private noncomputable def crd1 (x : Zgam t) : ℤ := (bas t).repr x 1

/-- Every element of `Zgam t` is `c0 + c1 * X` in the basis. (`s03-stabfree`) -/
private theorem eq_crd (x : Zgam t) :
    x = algebraMap ℤ (Zgam t) (crd0 t x) + algebraMap ℤ (Zgam t) (crd1 t x) * rt t := by
  have h := (bas t).sum_repr x
  rw [Fin.sum_univ_two, bas_zero, bas_one] at h
  have e : algebraMap ℤ (Zgam t) (crd0 t x) + algebraMap ℤ (Zgam t) (crd1 t x) * rt t
      = ((bas t).repr x) 0 • (1 : Zgam t) + ((bas t).repr x) 1 • rt t := by
    show algebraMap ℤ (Zgam t) (((bas t).repr x) 0) + algebraMap ℤ (Zgam t) (((bas t).repr x) 1) * rt t
        = ((bas t).repr x) 0 • (1 : Zgam t) + ((bas t).repr x) 1 • rt t
    rw [Algebra.smul_def, Algebra.smul_def, mul_one]
  rw [e, h]

/-- If `x = c0 + c1 * X`, its coordinates are `(c0, c1)`. (`s03-stabfree`) -/
private theorem crd_of_eq {x : Zgam t} {c0 c1 : ℤ}
    (hx : x = algebraMap ℤ (Zgam t) c0 + algebraMap ℤ (Zgam t) c1 * rt t) :
    crd0 t x = c0 ∧ crd1 t x = c1 := by
  have h1 : algebraMap ℤ (Zgam t) c0 = c0 • (bas t) 0 := by
    rw [bas_zero, Algebra.smul_def, mul_one]
  have h2 : algebraMap ℤ (Zgam t) c1 * rt t = c1 • (bas t) 1 := by
    rw [bas_one, Algebra.smul_def]
  have hr : (bas t).repr (c0 • (bas t) 0 + c1 • (bas t) 1) =
      Finsupp.single 0 c0 + Finsupp.single 1 c1 := by
    rw [map_add, map_smul, map_smul, Module.Basis.repr_self, Module.Basis.repr_self]
    simp [Finsupp.smul_single]
  rw [hx, h1, h2]
  show ((bas t).repr (c0 • (bas t) 0 + c1 • (bas t) 1)) 0 = c0 ∧
      ((bas t).repr (c0 • (bas t) 0 + c1 • (bas t) 1)) 1 = c1
  rw [hr]
  simp

/-- The norm `N(a + bX) = a² + t a b + b²` on `Zgam t`. -/
private noncomputable def N (x : Zgam t) : ℤ :=
  (crd0 t x) ^ 2 + t * (crd0 t x) * (crd1 t x) + (crd1 t x) ^ 2

/-- Multiplication in coordinates: `(a + bX)(c + dX) = (ac - bd) + (ad + bc + tbd)X`. (`s03-stabfree`) -/
private theorem mul_eq (a b c d : ℤ) :
    (algebraMap ℤ (Zgam t) a + algebraMap ℤ (Zgam t) b * rt t) *
      (algebraMap ℤ (Zgam t) c + algebraMap ℤ (Zgam t) d * rt t)
    = algebraMap ℤ (Zgam t) (a * c - b * d)
      + algebraMap ℤ (Zgam t) (a * d + b * c + t * b * d) * rt t := by
  simp only [map_sub, map_add, map_mul]
  linear_combination (algebraMap ℤ (Zgam t) b * algebraMap ℤ (Zgam t) d) * rt_sq t

/-- `s03-stabfree`: auxiliary lemma `N_mul` (`lem:s03-stabfree`). -/
private theorem N_mul (x y : Zgam t) : N t (x * y) = N t x * N t y := by
  have hx := eq_crd t x
  have hy := eq_crd t y
  have hxy := mul_eq t (crd0 t x) (crd1 t x) (crd0 t y) (crd1 t y)
  rw [← hx, ← hy] at hxy
  obtain ⟨h0, h1⟩ := crd_of_eq t hxy
  show (crd0 t (x * y)) ^ 2 + t * (crd0 t (x * y)) * (crd1 t (x * y)) + (crd1 t (x * y)) ^ 2
      = ((crd0 t x) ^ 2 + t * (crd0 t x) * (crd1 t x) + (crd1 t x) ^ 2) *
        ((crd0 t y) ^ 2 + t * (crd0 t y) * (crd1 t y) + (crd1 t y) ^ 2)
  rw [h0, h1]
  ring

/-- `s03-stabfree`: auxiliary lemma `N_algebraMap` (`lem:s03-stabfree`). -/
private theorem N_algebraMap (c : ℤ) : N t (algebraMap ℤ (Zgam t) c) = c ^ 2 := by
  obtain ⟨h0, h1⟩ := crd_of_eq t (x := algebraMap ℤ (Zgam t) c) (c0 := c) (c1 := 0) (by simp)
  show (crd0 t (algebraMap ℤ (Zgam t) c)) ^ 2 + t * (crd0 t (algebraMap ℤ (Zgam t) c)) *
      (crd1 t (algebraMap ℤ (Zgam t) c)) + (crd1 t (algebraMap ℤ (Zgam t) c)) ^ 2 = c ^ 2
  rw [h0, h1]
  ring

/-- `s03-stabfree`: auxiliary lemma `N_zero` (`lem:s03-stabfree`). -/
private theorem N_zero : N t 0 = 0 := by
  obtain ⟨h0, h1⟩ := crd_of_eq t (x := 0) (c0 := 0) (c1 := 0) (by simp)
  show (crd0 t 0) ^ 2 + t * (crd0 t 0) * (crd1 t 0) + (crd1 t 0) ^ 2 = 0
  rw [h0, h1]
  norm_num

/-- The norm is nonnegative (positive definite since `t² < 4`). (`s03-stabfree`) -/
private theorem N_nonneg (ht : t = -1 ∨ t = 0 ∨ t = 1) (x : Zgam t) : 0 ≤ N t x := by
  have ht2 : t ^ 2 ≤ 1 := by rcases ht with rfl | rfl | rfl <;> norm_num
  have h4 : 4 * N t x = (2 * crd0 t x + t * crd1 t x) ^ 2 + (4 - t ^ 2) * (crd1 t x) ^ 2 := by
    show 4 * ((crd0 t x) ^ 2 + t * (crd0 t x) * (crd1 t x) + (crd1 t x) ^ 2)
        = (2 * crd0 t x + t * crd1 t x) ^ 2 + (4 - t ^ 2) * (crd1 t x) ^ 2
    ring
  nlinarith [sq_nonneg (2 * crd0 t x + t * crd1 t x), sq_nonneg (crd1 t x), h4, ht2]

/-- The norm is positive definite: `N x = 0 ↔ x = 0`. (`s03-stabfree`) -/
private theorem N_eq_zero (ht : t = -1 ∨ t = 0 ∨ t = 1) {x : Zgam t} (h : N t x = 0) : x = 0 := by
  have ht2 : t ^ 2 ≤ 1 := by rcases ht with rfl | rfl | rfl <;> norm_num
  have h4 : 4 * N t x = (2 * crd0 t x + t * crd1 t x) ^ 2 + (4 - t ^ 2) * (crd1 t x) ^ 2 := by
    show 4 * ((crd0 t x) ^ 2 + t * (crd0 t x) * (crd1 t x) + (crd1 t x) ^ 2)
        = (2 * crd0 t x + t * crd1 t x) ^ 2 + (4 - t ^ 2) * (crd1 t x) ^ 2
    ring
  rw [h] at h4
  have hb2 : (crd1 t x) ^ 2 = 0 := by
    nlinarith [sq_nonneg (crd1 t x), sq_nonneg (2 * crd0 t x + t * crd1 t x), h4, ht2]
  have hb : crd1 t x = 0 := sq_eq_zero_iff.mp hb2
  have ha : crd0 t x = 0 := by
    rw [hb] at h4
    have h2 : (2 * crd0 t x) ^ 2 = 0 := by linarith [h4]
    have := sq_eq_zero_iff.mp h2
    linarith
  have hx := eq_crd t x
  rw [ha, hb] at hx
  simp at hx
  exact hx

/-- `s03-stabfree`: auxiliary lemma `N_pos` (`lem:s03-stabfree`). -/
private theorem N_pos (ht : t = -1 ∨ t = 0 ∨ t = 1) {x : Zgam t} (hx : x ≠ 0) : 0 < N t x := by
  have h1 := N_nonneg t ht x
  rcases eq_or_ne (N t x) 0 with h | h
  · exact absurd (N_eq_zero t ht h) hx
  · exact lt_of_le_of_ne h1 h.symm

end Aux

section ToB

variable {t : ℤ} {γ : GL2TF.Quat.QuatAlg ℚ a b}

/-- `toB` sends the adjoined root `X` to `γ`. (`s03-stabfree`) -/
private theorem toB_rt (hg : γ ^ 2 = (t : ℚ) • γ - 1) :
    Zgam.toB t γ (Zgam.aeval_of_sq hg) (rt t) = γ := by
  show Ideal.Quotient.lift (Ideal.span {X ^ 2 - C t * X + 1}) (Polynomial.aeval γ).toRingHom _
      (Ideal.Quotient.mk (Ideal.span {X ^ 2 - C t * X + 1}) X) = γ
  rw [Ideal.Quotient.lift_mk]
  simp

/-- `toB` commutes with the structure maps `ℤ → A → B`. (`s03-stabfree`) -/
private theorem toB_algebraMap (hg : γ ^ 2 = (t : ℚ) • γ - 1) (c : ℤ) :
    Zgam.toB t γ (Zgam.aeval_of_sq hg) (algebraMap ℤ (Zgam t) c)
      = algebraMap ℤ (GL2TF.Quat.QuatAlg ℚ a b) c := by
  have h1 : algebraMap ℤ (Zgam t) c = AdjoinRoot.mk (X ^ 2 - C t * X + 1) (C c) := by
    rw [AdjoinRoot.algebraMap_eq]; rfl
  rw [h1]
  show Ideal.Quotient.lift (Ideal.span {X ^ 2 - C t * X + 1}) (Polynomial.aeval γ).toRingHom _
      (Ideal.Quotient.mk _ (C c)) = algebraMap ℤ (GL2TF.Quat.QuatAlg ℚ a b) c
  rw [Ideal.Quotient.lift_mk]
  simp

/-- `toB` in coordinates: `toB x = (crd0 x) • 1 + (crd1 x) • γ`. (`s03-stabfree`) -/
private theorem toB_crd (hg : γ ^ 2 = (t : ℚ) • γ - 1) (x : Zgam t) :
    Zgam.toB t γ (Zgam.aeval_of_sq hg) x
      = (crd0 t x : ℚ) • (1 : GL2TF.Quat.QuatAlg ℚ a b) + (crd1 t x : ℚ) • γ := by
  conv_lhs => rw [eq_crd t x, map_add, map_mul, toB_algebraMap hg, toB_algebraMap hg, toB_rt hg]
  have hc : ∀ c : ℤ, algebraMap ℤ (GL2TF.Quat.QuatAlg ℚ a b) c
      = (c : ℚ) • (1 : GL2TF.Quat.QuatAlg ℚ a b) := by
    intro c
    have h1 : algebraMap ℤ (GL2TF.Quat.QuatAlg ℚ a b) c
        = algebraMap ℚ (GL2TF.Quat.QuatAlg ℚ a b) (c : ℚ) := by push_cast; rfl
    rw [h1, Algebra.smul_def, mul_one]
  rw [hc, hc, smul_mul_assoc, one_mul]

/-- A scalar `r : ℚ` cannot satisfy `r² = tr - 1` since `t² < 4`. (`s03-stabfree`) -/
private theorem not_scalar (ht : t = -1 ∨ t = 0 ∨ t = 1) (hg : γ ^ 2 = (t : ℚ) • γ - 1)
    (r : ℚ) : γ ≠ algebraMap ℚ (GL2TF.Quat.QuatAlg ℚ a b) r := by
  intro hr
  have h1 : γ ^ 2 = algebraMap ℚ (GL2TF.Quat.QuatAlg ℚ a b) (r ^ 2) := by rw [hr]; simp
  have h2 : (t : ℚ) • γ - 1 = algebraMap ℚ (GL2TF.Quat.QuatAlg ℚ a b) ((t : ℚ) * r - 1) := by
    rw [hr, Algebra.smul_def, ← map_mul, map_sub, map_one]
  rw [h1, h2] at hg
  have hre : r ^ 2 = (t : ℚ) * r - 1 := by
    have h := congrArg QuaternionAlgebra.re hg
    rw [QuaternionAlgebra.algebraMap_eq, QuaternionAlgebra.algebraMap_eq] at h
    exact h
  have ht2 : (t : ℚ) ^ 2 ≤ 1 := by rcases ht with rfl | rfl | rfl <;> norm_num
  have hpos : 0 < r ^ 2 - (t : ℚ) * r + 1 := by
    nlinarith [sq_nonneg (2 * r - (t : ℚ)), ht2]
  linarith

/-- `star` fixes the image of `algebraMap ℚ B`. (`s03-stabfree`) -/
private theorem star_am (q : ℚ) :
    star (algebraMap ℚ (GL2TF.Quat.QuatAlg ℚ a b) q)
      = algebraMap ℚ (GL2TF.Quat.QuatAlg ℚ a b) q := by
  simp [QuaternionAlgebra.algebraMap_eq, QuaternionAlgebra.star_mk]

/-- The reduced trace of `γ` is `t`. (`s03-stabfree`) -/
private theorem trd_gamma (ht : t = -1 ∨ t = 0 ∨ t = 1) (hg : γ ^ 2 = (t : ℚ) • γ - 1) :
    GL2TF.Quat.trd γ = (t : ℚ) := by
  have hquad := GL2TF.Quat.quad_rel γ
  rw [hg] at hquad
  have hE : ((t : ℚ) - GL2TF.Quat.trd γ) • γ
      = algebraMap ℚ (GL2TF.Quat.QuatAlg ℚ a b) (1 - GL2TF.Quat.nrd γ) := by
    rw [sub_smul, map_sub, map_one, ← sub_eq_zero]
    abel_nf at hquad ⊢
    exact hquad
  have hEstar : ((t : ℚ) - GL2TF.Quat.trd γ) • star γ
      = algebraMap ℚ (GL2TF.Quat.QuatAlg ℚ a b) (1 - GL2TF.Quat.nrd γ) := by
    have h1 := congrArg star hE
    rwa [QuaternionAlgebra.star_smul', star_am] at h1
  by_contra hs
  have hs0 : ((t : ℚ) - GL2TF.Quat.trd γ) ≠ 0 := sub_ne_zero.mpr (Ne.symm hs)
  have hsub : ((t : ℚ) - GL2TF.Quat.trd γ) • (γ - star γ) = 0 := by
    rw [smul_sub, hE, hEstar, sub_self]
  have hγstar : γ - star γ = 0 := by
    have h2 := congrArg (fun z => (((t : ℚ) - GL2TF.Quat.trd γ)⁻¹ : ℚ) • z) hsub
    rwa [smul_smul, inv_mul_cancel₀ hs0, one_smul, smul_zero] at h2
  have hstar : star γ = γ := (sub_eq_zero.mp hγstar).symm
  have hγscalar : γ = algebraMap ℚ (GL2TF.Quat.QuatAlg ℚ a b) γ.re :=
    (QuaternionAlgebra.star_eq_self (a := γ)).mp hstar
  exact not_scalar ht hg γ.re hγscalar

/-- The reduced norm of `γ` is `1`. (`s03-stabfree`) -/
private theorem nrd_gamma (ht : t = -1 ∨ t = 0 ∨ t = 1) (hg : γ ^ 2 = (t : ℚ) • γ - 1) :
    GL2TF.Quat.nrd γ = 1 := by
  have hquad := GL2TF.Quat.quad_rel γ
  rw [hg, trd_gamma ht hg] at hquad
  have h1 : algebraMap ℚ (GL2TF.Quat.QuatAlg ℚ a b) (GL2TF.Quat.nrd γ) = 1 := by
    rw [← sub_eq_zero]
    abel_nf at hquad ⊢
    exact hquad
  have h2 := congrArg QuaternionAlgebra.re h1
  rw [QuaternionAlgebra.algebraMap_eq] at h2
  exact h2

/-- The norm of a linear combination `u • 1 + v • γ` in coordinates of `γ`. (`s03-stabfree`) -/
private theorem nrd_lin (u v : ℚ) (δ : GL2TF.Quat.QuatAlg ℚ a b) :
    GL2TF.Quat.nrd (u • (1 : GL2TF.Quat.QuatAlg ℚ a b) + v • δ)
      = u ^ 2 + u * v * GL2TF.Quat.trd δ + v ^ 2 * GL2TF.Quat.nrd δ := by
  have hre : (u • (1 : GL2TF.Quat.QuatAlg ℚ a b) + v • δ).re = u + v * δ.re := by
    show u • (1 : ℚ) + v • δ.re = u + v * δ.re; simp
  have himI : (u • (1 : GL2TF.Quat.QuatAlg ℚ a b) + v • δ).imI = v * δ.imI := by
    show u • (0 : ℚ) + v • δ.imI = v * δ.imI; simp
  have himJ : (u • (1 : GL2TF.Quat.QuatAlg ℚ a b) + v • δ).imJ = v * δ.imJ := by
    show u • (0 : ℚ) + v • δ.imJ = v * δ.imJ; simp
  have himK : (u • (1 : GL2TF.Quat.QuatAlg ℚ a b) + v • δ).imK = v * δ.imK := by
    show u • (0 : ℚ) + v • δ.imK = v * δ.imK; simp
  simp only [GL2TF.Quat.nrd, GL2TF.Quat.trd]
  rw [hre, himI, himJ, himK]
  ring

/-- The norm on `A` computes the reduced norm of the image in `B`. (`s03-stabfree`) -/
private theorem nrd_toB (ht : t = -1 ∨ t = 0 ∨ t = 1) (hg : γ ^ 2 = (t : ℚ) • γ - 1)
    (x : Zgam t) :
    GL2TF.Quat.nrd (Zgam.toB t γ (Zgam.aeval_of_sq hg) x) = (N t x : ℚ) := by
  rw [toB_crd hg x, nrd_lin, trd_gamma ht hg, nrd_gamma ht hg]
  have hN : (N t x : ℚ)
      = (crd0 t x : ℚ) ^ 2 + (t : ℚ) * (crd0 t x : ℚ) * (crd1 t x : ℚ) + (crd1 t x : ℚ) ^ 2 := by
    show (((crd0 t x) ^ 2 + t * (crd0 t x) * (crd1 t x) + (crd1 t x) ^ 2 : ℤ) : ℚ)
        = (crd0 t x : ℚ) ^ 2 + (t : ℚ) * (crd0 t x : ℚ) * (crd1 t x : ℚ) + (crd1 t x : ℚ) ^ 2
    push_cast
    ring
  rw [hN]
  ring

end ToB

section Euclid

variable (t : ℤ)

/-- Conjugation `a + bX ↦ (a + tb) - bX` on `Zgam t`. -/
private noncomputable def conj (x : Zgam t) : Zgam t :=
  algebraMap ℤ (Zgam t) (crd0 t x + t * crd1 t x) - algebraMap ℤ (Zgam t) (crd1 t x) * rt t

/-- `s03-stabfree`: auxiliary lemma `crd_conj` (`lem:s03-stabfree`). -/
private theorem crd_conj (x : Zgam t) :
    crd0 t (conj t x) = crd0 t x + t * crd1 t x ∧ crd1 t (conj t x) = -crd1 t x := by
  have h : conj t x = algebraMap ℤ (Zgam t) (crd0 t x + t * crd1 t x)
      + algebraMap ℤ (Zgam t) (-crd1 t x) * rt t := by
    show algebraMap ℤ (Zgam t) (crd0 t x + t * crd1 t x)
        - algebraMap ℤ (Zgam t) (crd1 t x) * rt t
      = algebraMap ℤ (Zgam t) (crd0 t x + t * crd1 t x)
        + algebraMap ℤ (Zgam t) (-crd1 t x) * rt t
    simp only [sub_eq_add_neg, neg_mul, map_neg]
  exact crd_of_eq t h

/-- `s03-stabfree`: auxiliary lemma `N_conj` (`lem:s03-stabfree`). -/
private theorem N_conj (x : Zgam t) : N t (conj t x) = N t x := by
  obtain ⟨h0, h1⟩ := crd_conj t x
  show (crd0 t (conj t x)) ^ 2 + t * (crd0 t (conj t x)) * (crd1 t (conj t x))
      + (crd1 t (conj t x)) ^ 2 = (crd0 t x) ^ 2 + t * (crd0 t x) * (crd1 t x) + (crd1 t x) ^ 2
  rw [h0, h1]
  ring

/-- `s03-stabfree`: auxiliary lemma `crd_mul` (`lem:s03-stabfree`). -/
private theorem crd_mul (x y : Zgam t) :
    crd0 t (x * y) = crd0 t x * crd0 t y - crd1 t x * crd1 t y ∧
    crd1 t (x * y) = crd0 t x * crd1 t y + crd1 t x * crd0 t y + t * crd1 t x * crd1 t y := by
  have h := mul_eq t (crd0 t x) (crd1 t x) (crd0 t y) (crd1 t y)
  rw [← eq_crd t x, ← eq_crd t y] at h
  exact crd_of_eq t h

/-- `s03-stabfree`: auxiliary lemma `mul_conj` (`lem:s03-stabfree`). -/
private theorem mul_conj (x : Zgam t) : x * conj t x = algebraMap ℤ (Zgam t) (N t x) := by
  obtain ⟨h0, h1⟩ := crd_mul t x (conj t x)
  obtain ⟨hc0, hc1⟩ := crd_conj t x
  have hkey : x * conj t x
      = algebraMap ℤ (Zgam t) (N t x) + algebraMap ℤ (Zgam t) 0 * rt t := by
    rw [eq_crd t (x * conj t x), h0, h1, hc0, hc1]
    have e0 : crd0 t x * (crd0 t x + t * crd1 t x) - crd1 t x * (-crd1 t x) = N t x := by
      show crd0 t x * (crd0 t x + t * crd1 t x) - crd1 t x * (-crd1 t x)
          = (crd0 t x) ^ 2 + t * (crd0 t x) * (crd1 t x) + (crd1 t x) ^ 2
      ring
    have e1 : crd0 t x * (-crd1 t x) + crd1 t x * (crd0 t x + t * crd1 t x)
        + t * crd1 t x * (-crd1 t x) = 0 := by ring
    rw [e0, e1]
  obtain ⟨k0, k1⟩ := crd_of_eq t hkey
  have h := eq_crd t (x * conj t x)
  rw [k0, k1, map_zero, zero_mul, add_zero] at h
  exact h

/-- `s03-stabfree`: auxiliary lemma `N_of_eq` (`lem:s03-stabfree`). -/
private theorem N_of_eq {x : Zgam t} {c0 c1 : ℤ}
    (h : x = algebraMap ℤ (Zgam t) c0 + algebraMap ℤ (Zgam t) c1 * rt t) :
    N t x = c0 ^ 2 + t * c0 * c1 + c1 ^ 2 := by
  obtain ⟨k0, k1⟩ := crd_of_eq t h
  show (crd0 t x) ^ 2 + t * (crd0 t x) * (crd1 t x) + (crd1 t x) ^ 2 = _
  rw [k0, k1]

/-- `s03-stabfree`: auxiliary lemma `repr_mul_rt` (`lem:s03-stabfree`). -/
private theorem repr_mul_rt (x : Zgam t) :
    crd0 t (rt t * x) = -crd1 t x ∧ crd1 t (rt t * x) = crd0 t x + t * crd1 t x := by
  have hrt : rt t * x = algebraMap ℤ (Zgam t) (-crd1 t x)
      + algebraMap ℤ (Zgam t) (crd0 t x + t * crd1 t x) * rt t := by
    conv_lhs => rw [eq_crd t x]
    simp only [map_neg, map_add, map_mul]
    linear_combination (algebraMap ℤ (Zgam t) (crd1 t x)) * rt_sq t
  exact crd_of_eq t hrt

/-- `s03-stabfree`: auxiliary lemma `quad_bound` (`lem:s03-stabfree`). -/
private theorem quad_bound (ht : t = -1 ∨ t = 0 ∨ t = 1) {s a b : ℚ}
    (hs : 0 < s) (ha : -(1 / 2) ≤ a ∧ a ≤ 1 / 2) (hb : -(1 / 2) ≤ b ∧ b ≤ 1 / 2) :
    (s * a) ^ 2 + (t : ℚ) * (s * a) * (s * b) + (s * b) ^ 2 < s * s := by
  have ha2 : a ^ 2 ≤ 1 / 4 := by nlinarith [ha.1, ha.2, sq_nonneg a]
  have hb2 : b ^ 2 ≤ 1 / 4 := by nlinarith [hb.1, hb.2, sq_nonneg b]
  have hab : a * b ≤ 1 / 4 := by nlinarith [sq_nonneg (a - b), ha2, hb2]
  have hab' : -1 / 4 ≤ a * b := by nlinarith [sq_nonneg (a + b), ha2, hb2]
  have hq : a ^ 2 + (t : ℚ) * a * b + b ^ 2 < 1 := by
    rcases ht with rfl | rfl | rfl
    · push_cast; linarith [ha2, hb2, hab']
    · push_cast; linarith [ha2, hb2]
    · push_cast; linarith [ha2, hb2, hab]
  have heq : (s * a) ^ 2 + (t : ℚ) * (s * a) * (s * b) + (s * b) ^ 2
      = s * s * (a ^ 2 + (t : ℚ) * a * b + b ^ 2) := by ring
  rw [heq]
  linarith [mul_lt_mul_of_pos_left hq (mul_pos hs hs)]

/-- Euclidean division in `Zgam t` by a nonzero element, via rounding coordinates. (`s03-stabfree`) -/
private theorem euclid (ht : t = -1 ∨ t = 0 ∨ t = 1) (α β : Zgam t) (hβ : β ≠ 0) :
    ∃ q r : Zgam t, α = q * β + r ∧ (N t r : ℚ) < N t β := by
  have hs' : 0 < N t β := N_pos t ht hβ
  have hne : (N t β : ℚ) ≠ 0 := by exact_mod_cast hs'.ne'
  have hbc : β * conj t β = algebraMap ℤ (Zgam t) (N t β) := mul_conj t β
  set w := α * conj t β with hwdef
  set q0 := round ((crd0 t w : ℚ) / (N t β : ℚ)) with hq0def
  set q1 := round ((crd1 t w : ℚ) / (N t β : ℚ)) with hq1def
  have ha0 : -(1 / 2) ≤ (crd0 t w : ℚ) / (N t β : ℚ) - q0
      ∧ (crd0 t w : ℚ) / (N t β : ℚ) - q0 ≤ 1 / 2 := by
    have h := abs_sub_round ((crd0 t w : ℚ) / (N t β : ℚ))
    rw [← hq0def] at h
    exact abs_le.mp h
  have ha1 : -(1 / 2) ≤ (crd1 t w : ℚ) / (N t β : ℚ) - q1
      ∧ (crd1 t w : ℚ) / (N t β : ℚ) - q1 ≤ 1 / 2 := by
    have h := abs_sub_round ((crd1 t w : ℚ) / (N t β : ℚ))
    rw [← hq1def] at h
    exact abs_le.mp h
  set q : Zgam t := algebraMap ℤ (Zgam t) q0 + algebraMap ℤ (Zgam t) q1 * rt t with hqdef
  refine ⟨q, α - q * β, by ring, ?_⟩
  have hqam : q * algebraMap ℤ (Zgam t) (N t β)
      = algebraMap ℤ (Zgam t) (N t β) * algebraMap ℤ (Zgam t) q0
        + algebraMap ℤ (Zgam t) (N t β) * algebraMap ℤ (Zgam t) q1 * rt t := by
    rw [hqdef]
    ring
  have hkey : (α - q * β) * conj t β
      = (algebraMap ℤ (Zgam t) (crd0 t w) - algebraMap ℤ (Zgam t) (N t β) * algebraMap ℤ (Zgam t) q0)
        + (algebraMap ℤ (Zgam t) (crd1 t w)
            - algebraMap ℤ (Zgam t) (N t β) * algebraMap ℤ (Zgam t) q1) * rt t := by
    linear_combination eq_crd t w - hwdef - hbc * q - hqam
  have hNkey : N t (α - q * β) * N t β
      = (crd0 t w - N t β * q0) ^ 2 + t * (crd0 t w - N t β * q0) * (crd1 t w - N t β * q1)
        + (crd1 t w - N t β * q1) ^ 2 := by
    have h1 : N t ((α - q * β) * conj t β) = N t (α - q * β) * N t (conj t β) := N_mul t _ _
    rw [N_conj t β] at h1
    have hX : (algebraMap ℤ (Zgam t) (crd0 t w) - algebraMap ℤ (Zgam t) (N t β) * algebraMap ℤ (Zgam t) q0)
          + (algebraMap ℤ (Zgam t) (crd1 t w)
              - algebraMap ℤ (Zgam t) (N t β) * algebraMap ℤ (Zgam t) q1) * rt t
        = algebraMap ℤ (Zgam t) (crd0 t w - N t β * q0)
          + algebraMap ℤ (Zgam t) (crd1 t w - N t β * q1) * rt t := by
      rw [map_sub, map_sub, ← map_mul, ← map_mul]
    rw [← h1, hkey, hX]
    exact N_of_eq t rfl
  have hcast : ((N t (α - q * β) * N t β : ℤ) : ℚ)
      = ((crd0 t w - N t β * q0 : ℤ) : ℚ) ^ 2
        + (t : ℚ) * ((crd0 t w - N t β * q0 : ℤ) : ℚ) * ((crd1 t w - N t β * q1 : ℤ) : ℚ)
        + ((crd1 t w - N t β * q1 : ℤ) : ℚ) ^ 2 := by
    exact_mod_cast hNkey
  have e0 : ((crd0 t w - N t β * q0 : ℤ) : ℚ)
      = (N t β : ℚ) * ((crd0 t w : ℚ) / (N t β : ℚ) - q0) := by
    push_cast
    field_simp
  have e1 : ((crd1 t w - N t β * q1 : ℤ) : ℚ)
      = (N t β : ℚ) * ((crd1 t w : ℚ) / (N t β : ℚ) - q1) := by
    push_cast
    field_simp
  rw [e0, e1] at hcast
  have hfin : (N t (α - q * β) : ℚ) * (N t β : ℚ) < (N t β : ℚ) * (N t β : ℚ) := by
    rw [← Int.cast_mul, hcast]
    exact quad_bound t ht (by exact_mod_cast hs') ha0 ha1
  have hfin' : (N t β : ℚ) * (N t (α - q * β) : ℚ) < (N t β : ℚ) * (N t β : ℚ) := by
    rw [mul_comm (N t β : ℚ) (N t (α - q * β) : ℚ)]
    exact hfin
  exact lt_of_mul_lt_mul_left hfin' (by exact_mod_cast hs'.le)

end Euclid

section PID

variable (t : ℤ)

/-- Every nonzero ideal of `Zgam t` is generated by a norm-minimal nonzero element. (`s03-stabfree`) -/
private theorem ideal_span_min (ht : t = -1 ∨ t = 0 ∨ t = 1) (I : Ideal (Zgam t))
    (hne : ∃ x ∈ I, x ≠ 0) : ∃ π ∈ I, I = Ideal.span {π} := by
  classical
  obtain ⟨x, hxI, hx0⟩ := hne
  have hset : ∃ n : ℕ, ∃ y ∈ I, y ≠ 0 ∧ N t y = (n : ℤ) :=
    ⟨(N t x).toNat, x, hxI, hx0, (Int.toNat_of_nonneg (N_nonneg t ht x)).symm⟩
  obtain ⟨π, hπI, hπ0, hπN⟩ := Nat.find_spec hset
  refine ⟨π, hπI, le_antisymm ?_ (Ideal.span_le.mpr (Set.singleton_subset_iff.mpr hπI))⟩
  intro y hy
  obtain ⟨q, r, hyr, hrN⟩ := euclid t ht y π hπ0
  have hqI : q * π ∈ I := Ideal.mul_mem_left I q hπI
  have hrI : r ∈ I := by
    have h : r = y - q * π := by rw [hyr]; abel
    rw [h]
    exact I.sub_mem hy hqI
  by_cases hr0 : r = 0
  · refine Ideal.mem_span_singleton.mpr ⟨q, ?_⟩
    rw [hyr, hr0, add_zero, mul_comm]
  · exfalso
    have hlt : N t r < (Nat.find hset : ℤ) := by
      have h1 : (N t r : ℚ) < (Nat.find hset : ℤ) := by rw [← hπN]; exact hrN
      exact_mod_cast h1
    have hpos : 0 < (Nat.find hset : ℤ) := by
      have h0 := N_nonneg t ht r
      linarith [hlt, h0]
    have hlt2 : (N t r).toNat < Nat.find hset := by
      rw [← Int.toNat_natCast (Nat.find hset)]
      exact (Int.toNat_lt_toNat hpos).mpr hlt
    exact Nat.find_min hset hlt2 ⟨r, hrI, hr0, (Int.toNat_of_nonneg (N_nonneg t ht r)).symm⟩

end PID

section Index

variable (t : ℤ)

/-- The determinant of `(x, X * x)` in the basis `{1, X}` is the norm `N x`. (`s03-stabfree`) -/
private theorem det_pair (x : Zgam t) :
    (bas t).det ![x, rt t * x] = N t x := by
  rw [Module.Basis.det_apply, Matrix.det_fin_two]
  simp only [Module.Basis.toMatrix_apply, Matrix.cons_val_zero, Matrix.cons_val_one,
    Matrix.head_cons]
  obtain ⟨h0, h1⟩ := repr_mul_rt t x
  show crd0 t x * crd1 t (rt t * x) - crd0 t (rt t * x) * crd1 t x = N t x
  rw [h0, h1]
  have hN : N t x = (crd0 t x) ^ 2 + t * (crd0 t x) * (crd1 t x) + (crd1 t x) ^ 2 := rfl
  rw [hN]
  ring

/-- The quotient of `Zgam t` by a principal ideal `span {π}` has cardinal `|N π|`. (`s03-stabfree`) -/
private theorem card_span_eq (ht : t = -1 ∨ t = 0 ∨ t = 1) (π : Zgam t) (hπ : π ≠ 0) :
    Nat.card (Zgam t ⧸ (Ideal.span {π} : Ideal (Zgam t))) = (N t π).natAbs := by
  classical
  have hmem : ∀ q : Zgam t, q * π ∈ (Ideal.span {π} : Ideal (Zgam t)) := fun q =>
    Ideal.mem_span_singleton.mpr ⟨q, mul_comm q π⟩
  let Nsub : Submodule ℤ (Zgam t) := (Ideal.span {π} : Ideal (Zgam t)).toAddSubgroup.toIntSubmodule
  have hmem' : ∀ q : Zgam t, (LinearMap.mulRight ℤ π) q ∈ Nsub := fun q => hmem q
  let f : Zgam t →ₗ[ℤ] ↥Nsub := LinearMap.codRestrict Nsub (LinearMap.mulRight ℤ π) hmem'
  have hfe : ∀ x : Zgam t, (f x : Zgam t) = x * π := fun _ => rfl
  have hf_inj : Function.Injective f := by
    intro x y hxy
    have h2 : x * π = y * π := by
      rw [← hfe x, ← hfe y]
      exact congrArg Subtype.val hxy
    have h3 : (x - y) * π = 0 := by rw [sub_mul, h2, sub_self]
    have h4 : N t (x - y) * N t π = 0 := by
      have h5 := N_mul t (x - y) π
      rw [h3, N_zero t] at h5
      exact h5.symm
    rcases eq_zero_or_eq_zero_of_mul_eq_zero h4 with h | h
    · exact sub_eq_zero.mp (N_eq_zero t ht h)
    · exact absurd (N_eq_zero t ht h) hπ
  have hf_surj : Function.Surjective f := by
    intro z
    have hz : (z : Zgam t) ∈ (Ideal.span {π} : Ideal (Zgam t)) := z.2
    obtain ⟨q, hq⟩ := Ideal.mem_span_singleton.mp hz
    exact ⟨q, Subtype.ext (by rw [hfe q, hq]; exact mul_comm q π)⟩
  let e : Zgam t ≃ₗ[ℤ] ↥Nsub := LinearEquiv.ofBijective f ⟨hf_inj, hf_surj⟩
  have hfree : Module.Free ℤ (Zgam t) := Module.Free.of_basis (bas t)
  have hfin' : Module.Finite ℤ (Zgam t) := Module.Finite.of_basis (bas t)
  have h2 := Submodule.natAbs_det_basis_change (bas t) Nsub ((bas t).map e)
  have hfe2 : ∀ x : Zgam t, (e x : Zgam t) = x * π := fun x => hfe x
  have hdet : (bas t).det (Subtype.val ∘ ((bas t).map e)) = N t π := by
    have hv : Subtype.val ∘ ((bas t).map e) = ![π, rt t * π] := by
      funext i
      fin_cases i
      · show (((bas t).map e) 0 : Zgam t) = π
        rw [Module.Basis.map_apply, bas_zero, hfe2, one_mul]
      · show (((bas t).map e) 1 : Zgam t) = rt t * π
        rw [Module.Basis.map_apply, bas_one, hfe2]
    rw [hv]
    exact det_pair t π
  have hcard : Nat.card (Zgam t ⧸ Nsub)
      = Nat.card (Zgam t ⧸ (Ideal.span {π} : Ideal (Zgam t))) := rfl
  rw [← hcard, ← h2, hdet]

end Index

/-- **Piece E, tex steps (i)–(ii) (PID core).** For `γ ∈ B` definite with `γ² = tγ - 1`,
`t ∈ {-1,0,1}`: every ideal `I` of `A t` containing `ℓA` with `Nat.card (A ⧸ I) = ℓ` (prime)
has a generator `π ∈ I` whose image in `B` has reduced norm `ℓ`.

Proof route: `A t` is a free `ℤ`-module of rank 2 (`AdjoinRoot.powerBasis'`), the norm
`N(a + bX) = a² + t a b + b²` equals `nrd (toB π)` (compute via `conj γ = t - γ`,
`nrd z = z * conj z`), is positive definite (`t² ≤ 1 < 4`, use `ha hb` for `nrd x = 0 → x = 0`),
and gives a Euclidean division (round the two coordinates of `α β⁻¹ ∈ ℚ(γ) ⊆ B` to nearest
integers; `|t| ≤ 1` gives remainder norm `≤ (3/4) N β < N β`). Norm-minimal nonzero element of
`I` generates `I` (PID); then `[A : πA] = N π` via the determinant of multiplication by `π`
in the basis `{1, X}` (matrix `[[a, -b], [b, a + t b]]`, det `= a² + t a b + b²`), and
`Nat.card (A ⧸ I) = ℓ = N π = nrd (toB π)`. (`s03-stabfree`) -/
theorem principality (ha : a < 0) (hb : b < 0) {t : ℤ} (ht : t = -1 ∨ t = 0 ∨ t = 1)
    {γ : GL2TF.Quat.QuatAlg ℚ a b} (hg : γ ^ 2 = (t : ℚ) • γ - 1) (ℓ : ℕ) [Fact ℓ.Prime]
    (I : Ideal (Zgam t)) (hℓ : Ideal.span ({(ℓ : Zgam t)} : Set (Zgam t)) ≤ I)
    (hcard : Nat.card (Zgam t ⧸ I) = ℓ) :
    ∃ π ∈ I, GL2TF.Quat.nrd (Zgam.toB t γ (Zgam.aeval_of_sq hg) π) = (ℓ : ℚ) := by
  have hp : ℓ.Prime := Fact.out
  have hℓI : (ℓ : Zgam t) ∈ I := hℓ (Ideal.subset_span (Set.mem_singleton _))
  have hℓne : (ℓ : Zgam t) ≠ 0 := by
    intro h
    have e1 : crd0 t (ℓ : Zgam t) = (ℓ : ℤ) :=
      (crd_of_eq t (x := (ℓ : Zgam t)) (c0 := (ℓ : ℤ)) (c1 := 0)
        (by rw [map_natCast]; simp)).1
    have e0 : crd0 t 0 = 0 := (crd_of_eq t (x := 0) (c0 := 0) (c1 := 0) (by simp)).1
    have h1 : crd0 t (ℓ : Zgam t) = crd0 t 0 := by rw [h]
    rw [e1, e0] at h1
    exact hp.ne_zero (by exact_mod_cast h1)
  obtain ⟨π, hπI, hπspan⟩ := ideal_span_min t ht I ⟨(ℓ : Zgam t), hℓI, hℓne⟩
  have hπ0 : π ≠ 0 := by
    intro h
    have hI : I = ⊥ := by rw [hπspan, h, Ideal.span_singleton_eq_bot.mpr rfl]
    rw [hI, Submodule.mem_bot] at hℓI
    exact hℓne hℓI
  have hcard' : Nat.card (Zgam t ⧸ (Ideal.span {π} : Ideal (Zgam t))) = ℓ := by
    rw [← hπspan]
    exact hcard
  have hNπ := card_span_eq t ht π hπ0
  rw [hcard'] at hNπ
  have hNnonneg : 0 ≤ N t π := N_nonneg t ht π
  have hNπℓ : N t π = (ℓ : ℤ) := by
    rw [← Int.natAbs_of_nonneg hNnonneg, ← hNπ]
  refine ⟨π, hπI, ?_⟩
  rw [nrd_toB ht hg π, hNπℓ, Int.cast_natCast]

end Langlandscape.StabFree.Principal
