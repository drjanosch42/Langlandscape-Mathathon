import Langlandscape.Hyp.BrandtStabFree
import Langlandscape.Quat.StabFree.Orbit
import Langlandscape.Quat.StabFree.Principal
import Langlandscape.Quat.StabFree.LocalPi
import Langlandscape.Quat.StabFree.Core

/-!
# Discharge of `Hyp.BrandtStabFree`: `w_e ∣ B(ℓ)_{e e'}` for `e ≠ e'` at `Ô^×`

`mathematics/chapters/s03/2-eisenstein.tex`, `lem:s03-stabfree` (step (1) of `prop:s03-phieis`).

The proof follows the tex proof, in four pieces (`Langlandscape/Quat/StabFree/`):
* `StabFree.Orbit.brandtStabFree_of_core` (step (vii)): `Γ_x/{±1}` acts on the `ℓ`-neighbours counted by
  `B(ℓ)_{cc'}`, preserving classes; if no `γ ∈ Γ_x`, `γ ≠ ±1`, fixes a neighbour in another class, the action on
  the neighbours in `c' ≠ c` is free, whence `w_c ∣ B(ℓ)_{cc'}`;
* `StabFree.Principal.principality` (steps (i)–(ii)): `ℤ[γ] ≅ ℤ[X]/(X² − tX + 1)`, `t ∈ {−1, 0, 1}`, is Euclidean
  (a PID), and an ideal of prime index `ℓ` containing `ℓ` is generated by some `π` with `nrd π(γ) = ℓ`;
* `StabFree.LocalPi.local_pi` (steps (iii)–(v), the place `ℓ`): the `G`-stable index-`ℓ` lattice gives such a `π`
  with `y⁻¹ x⁻¹ π x` integral at `ℓ`;
* `StabFree.Core.stabFree_core` (step (vi)): globalisation, `[x y] = [x]` in `X_B(Ô^×)`.

The premises `ℓ` prime and `ℓ ∤ D` are used (the place `ℓ` is split, `localComponent d ℓ hℓD`); the premise `D`
prime is not used (as in the tex proof). The hypothesis file `Hyp/BrandtStabFree.lean` and the consumers
(`Ribet/PhiEis.lean`) are unchanged; a consumer gets the argument as `brandtStabFree_holds d ℓ`.

Provenance: draft by mistral-large-4-0 via opencode (external, user-run; branch `abhijit/brandtstabfree`,
c170335d), integrated and audited by the Langlandscape agents.

Status: *formalized* (`lem:s03-stabfree`, at `Ô^×`).
-/

set_option autoImplicit false

namespace Langlandscape.Hyp

open GL2TF Langlandscape.Quat

/-- `lem:s03-stabfree` (`s03-stabfree`), step (1) of `prop:s03-phieis`: the registered hypothesis
`Hyp.BrandtStabFree d ℓ` holds for every definite datum `d` and every `ℓ`: for `ℓ` prime, `ℓ ∤ D` (and `D` prime,
unused) and `c ≠ c'` in `X_B(Ô^×)`, `w_c ∣ B(ℓ)_{c c'}`. Assembled from `StabFree.Orbit.brandtStabFree_of_core`,
`StabFree.Core.stabFree_core`, `StabFree.LocalPi.local_pi` and `StabFree.Principal.principality`. Provenance: draft
by mistral-large-4-0 via opencode (external, user-run), integrated and audited by the Langlandscape agents. -/
theorem brandtStabFree_holds (d : DefiniteData) (ℓ : ℕ) : BrandtStabFree d ℓ := by
  intro hℓ hℓD hD
  haveI : Fact ℓ.Prime := ⟨hℓ⟩
  exact Langlandscape.StabFree.Orbit.brandtStabFree_of_core d ℓ (fun x y hy γ hγ hpm hγy =>
    Langlandscape.StabFree.Core.stabFree_core d hℓD
      (fun {x y} hy {γ} hγ hγy hpm =>
        Langlandscape.StabFree.LocalPi.local_pi d hℓD
          (Langlandscape.StabFree.Principal.principality d.ha d.hb) hy hγ hγy hpm)
      x y hy γ hγ hpm hγy) hℓ hℓD hD

end Langlandscape.Hyp
