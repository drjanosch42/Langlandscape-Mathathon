+/-- `lem:s01-stab` (a): for `U ≤ Ô^×`, every `γ ∈ Γ_x(U)` has `nrd γ = 1`. -/
+theorem nrd_eq_one_of_mem_Gam {d : DefiniteData}
+    {U : Subgroup (BHat d.a d.b)ˣ} {x : (BHat d.a d.b)ˣ}
+    {γ : (QuatAlg ℚ d.a d.b)ˣ} (hU : U ≤ d.Ohat) (hγ : γ ∈ Gam (a := d.a) (b := d.b) U x) :
+    nrd (γ : QuatAlg ℚ d.a d.b) = 1 := by
+  have ha : d.a < 0 := d.ha
+  have hb : d.b < 0 := d.hb
+  have hmem : (Units.map (finEmbed d.a d.b).toMonoidHom γ : (BHat d.a d.b)ˣ) ∈
+      U.map (MulAut.conj x).toMonoidHom := hγ
+  obtain ⟨u, huU, huEq⟩ := Subgroup.mem_map.mp hmem
+  have huO : u ∈ d.Ohat := hU huU
+  have hmem_u : (u : BHat d.a d.b) ∈ latticeCompletion (Subalgebra.toSubmodule d.O.1.toSubalgebra) :=
+    (show u ∈ orderCompletionUnits d.O.1 from huO).1
+  have hmem_uInv : ((u⁻¹ : (BHat d.a d.b)ˣ) : BHat d.a d.b) ∈
+      latticeCompletion (Subalgebra.toSubmodule d.O.1.toSubalgebra) :=
+    (show u ∈ orderCompletionUnits d.O.1 from huO).2
+  have hnrd_u : nrd (show QuatAlg FinAdele d.a d.b from (u : BHat d.a d.b)) ∈ Zhat :=
+    nrd_mem_zhat_of_mem_completion d.O.1 hmem_u
+  have hnrd_uInv : nrd (show QuatAlg FinAdele d.a d.b from ((u⁻¹ : (BHat d.a d.b)ˣ) : BHat d.a d.b)) ∈ Zhat :=
+    nrd_mem_zhat_of_mem_completion d.O.1 hmem_uInv
+  have h_nrd_mul : ∀ (p q : QuatAlg FinAdele d.a d.b), nrd (p * q) = nrd p * nrd q :=
+    fun p q => ((nrd_trd_basic (R := FinAdele) (a := d.a) (b := d.b)).2.1 p q)
+  have h_coe_eq : (x : BHat d.a d.b) * (u : BHat d.a d.b) * ((x⁻¹ : (BHat d.a d.b)ˣ) : BHat d.a d.b) =
+      (finEmbed d.a d.b (γ : QuatAlg ℚ d.a d.b) : BHat d.a d.b) := by
+    have h1 : (MulAut.conj x u : (BHat d.a d.b)ˣ) = Units.map (finEmbed d.a d.b).toMonoidHom γ := huEq
+    have h2 := congrArg (fun t : (BHat d.a d.b)ˣ => (t : BHat d.a d.b)) h1
+    simp only [MulAut.conj_apply, Units.val_mul] at h2
+    exact h2
+  have hx_nrd : nrd (show QuatAlg FinAdele d.a d.b from (x : BHat d.a d.b)) *
+      nrd (show QuatAlg FinAdele d.a d.b from ((x⁻¹ : (BHat d.a d.b)ˣ) : BHat d.a d.b)) = 1 :=
+    nrd_units_mul_inv (a := d.a) (b := d.b) x
+  have hnrd_conj : nrd (show QuatAlg FinAdele d.a d.b from (u : BHat d.a d.b)) =
+      nrd (show QuatAlg FinAdele d.a d.b from finEmbed d.a d.b (γ : QuatAlg ℚ d.a d.b)) := by
+    have h_nrd_conj_eq : nrd (show QuatAlg FinAdele d.a d.b from
+        (x : BHat d.a d.b) * (u : BHat d.a d.b) * ((x⁻¹ : (BHat d.a d.b)ˣ) : BHat d.a d.b)) =
+        nrd (show QuatAlg FinAdele d.a d.b from (u : BHat d.a d.b)) := by
+      calc nrd (show QuatAlg FinAdele d.a d.b from (x : BHat d.a d.b) * (u : BHat d.a d.b) * ((x⁻¹ : (BHat d.a d.b)ˣ) : BHat d.a d.b))
+          = nrd (show QuatAlg FinAdele d.a d.b from (x : BHat d.a d.b) * (u : BHat d.a d.b) * ((x⁻¹ : (BHat d.a d.b)ˣ) : BHat d.a d.b)) := rfl
+        _ = nrd ((show QuatAlg FinAdele d.a d.b from (x : BHat d.a d.b) * (u : BHat d.a d.b)) * (show QuatAlg FinAdele d.a d.b from ((x⁻¹ : (BHat d.a d.b)ˣ) : BHat d.a d.b))) := rfl
+        _ = nrd (show QuatAlg FinAdele d.a d.b from (x : BHat d.a d.b) * (u : BHat d.a d.b)) *
+            nrd (show QuatAlg FinAdele d.a d.b from ((x⁻¹ : (BHat d.a d.b)ˣ) : BHat d.a d.b)) := h_nrd_mul _ _
+        _ = (nrd (show QuatAlg FinAdele d.a d.b from (x : BHat d.a d.b)) *
+            nrd (show QuatAlg FinAdele d.a d.b from (u : BHat d.a d.b))) *
+            nrd (show QuatAlg FinAdele d.a d.b from ((x⁻¹ : (BHat d.a d.b)ˣ) : BHat d.a d.b)) := by
+            have h2 := h_nrd_mul (show QuatAlg FinAdele d.a d.b from (x : BHat d.a d.b))
+              (show QuatAlg FinAdele d.a d.b from (u : BHat d.a d.b))
+            have heq : (show QuatAlg FinAdele d.a d.b from (x : BHat d.a d.b) * (u : BHat d.a d.b)) =
+              (show QuatAlg FinAdele d.a d.b from (x : BHat d.a d.b)) * (show QuatAlg FinAdele d.a d.b from (u : BHat d.a d.b)) := rfl
+            rw [heq] at h2
+            exact congrArg (fun t => t * nrd (show QuatAlg FinAdele d.a d.b from ((x⁻¹ : (BHat d.a d.b)ˣ) : BHat d.a d.b))) h2
+        _ = nrd (show QuatAlg FinAdele d.a d.b from (u : BHat d.a d.b)) *
+            (nrd (show QuatAlg FinAdele d.a d.b from (x : BHat d.a d.b)) *
+            nrd (show QuatAlg FinAdele d.a d.b from ((x⁻¹ : (BHat d.a d.b)ˣ) : BHat d.a d.b))) := by ring
+        _ = nrd (show QuatAlg FinAdele d.a d.b from (u : BHat d.a d.b)) * 1 := by rw [hx_nrd]
+        _ = nrd (show QuatAlg FinAdele d.a d.b from (u : BHat d.a d.b)) := by rw [mul_one]
+    rw [h_coe_eq] at h_nrd_conj_eq
+    exact h_nrd_conj_eq.symm
+  have hnrd_emb : nrd (show QuatAlg FinAdele d.a d.b from finEmbed d.a d.b (γ : QuatAlg ℚ d.a d.b)) =
+      algebraMap ℚ FinAdele (nrd (γ : QuatAlg ℚ d.a d.b)) :=
+    ((nrd_trd_basic (R := ℚ) (a := d.a) (b := d.b)).2.2.2 FinAdele (algebraMap ℚ FinAdele) (γ : QuatAlg ℚ d.a d.b)).1
+  have h_alg_mem : algebraMap ℚ FinAdele (nrd (γ : QuatAlg ℚ d.a d.b)) ∈ Zhat := by
+    rw [← hnrd_emb, ← hnrd_conj]
+    exact hnrd_u
+  have h_alg_inv_mem : algebraMap ℚ FinAdele (nrd ((γ⁻¹ : (QuatAlg ℚ d.a d.b)ˣ) : QuatAlg ℚ d.a d.b)) ∈ Zhat := by
+    have huInvEq : (MulAut.conj x) (u⁻¹) = Units.map (finEmbed d.a d.b).toMonoidHom (γ⁻¹) := by
+      rw [map_inv, huEq]
+    have h_coe_inv : (x : BHat d.a d.b) * ((u⁻¹ : (BHat d.a d.b)ˣ) : BHat d.a d.b) *
+        ((x⁻¹ : (BHat d.a d.b)ˣ) : BHat d.a d.b) =
+        (finEmbed d.a d.b ((γ⁻¹ : (QuatAlg ℚ d.a d.b)ˣ) : QuatAlg ℚ d.a d.b) : BHat d.a d.b) := by
+      have h1 := congrArg (fun t : (BHat d.a d.b)ˣ => (t : BHat d.a d.b)) huInvEq
+      simp only [MulAut.conj_apply, Units.val_mul] at h1
+      exact h1
+    have hnrd_inv_conj : nrd (show QuatAlg FinAdele d.a d.b from ((u⁻¹ : (BHat d.a d.b)ˣ) : BHat d.a d.b)) =
+        nrd (show QuatAlg FinAdele d.a d.b from finEmbed d.a d.b ((γ⁻¹ : (QuatAlg ℚ d.a d.b)ˣ) : QuatAlg ℚ d.a d.b)) := by
+      have h_nrd_inv : nrd (show QuatAlg FinAdele d.a d.b from
+          (x : BHat d.a d.b) * ((u⁻¹ : (BHat d.a d.b)ˣ) : BHat d.a d.b) * ((x⁻¹ : (BHat d.a d.b)ˣ) : BHat d.a d.b)) =
+          nrd (show QuatAlg FinAdele d.a d.b from ((u⁻¹ : (BHat d.a d.b)ˣ) : BHat d.a d.b)) := by
+        calc nrd (show QuatAlg FinAdele d.a d.b from (x : BHat d.a d.b) * ((u⁻¹ : (BHat d.a d.b)ˣ) : BHat d.a d.b) * ((x⁻¹ : (BHat d.a d.b)ˣ) : BHat d.a d.b))
+            = nrd (show QuatAlg FinAdele d.a d.b from (x : BHat d.a d.b) * ((u⁻¹ : (BHat d.a d.b)ˣ) : BHat d.a d.b) * ((x⁻¹ : (BHat d.a d.b)ˣ) : BHat d.a d.b)) := rfl
+          _ = nrd ((show QuatAlg FinAdele d.a d.b from (x : BHat d.a d.b) * ((u⁻¹ : (BHat d.a d.b)ˣ) : BHat d.a d.b)) * (show QuatAlg FinAdele d.a d.b from ((x⁻¹ : (BHat d.a d.b)ˣ) : BHat d.a d.b))) := rfl
+          _ = nrd (show QuatAlg FinAdele d.a d.b from (x : BHat d.a d.b) * ((u⁻¹ : (BHat d.a d.b)ˣ) : BHat d.a d.b)) *
+              nrd (show QuatAlg FinAdele d.a d.b from ((x⁻¹ : (BHat d.a d.b)ˣ) : BHat d.a d.b)) := h_nrd_mul _ _
+          _ = (nrd (show QuatAlg FinAdele d.a d.b from (x : BHat d.a d.b)) *
+              nrd (show QuatAlg FinAdele d.a d.b from ((u⁻¹ : (BHat d.a d.b)ˣ) : BHat d.a d.b))) *
+              nrd (show QuatAlg FinAdele d.a d.b from ((x⁻¹ : (BHat d.a d.b)ˣ) : BHat d.a d.b)) := by
+              have h2 := h_nrd_mul (show QuatAlg FinAdele d.a d.b from (x : BHat d.a d.b))
+                (show QuatAlg FinAdele d.a d.b from ((u⁻¹ : (BHat d.a d.b)ˣ) : BHat d.a d.b))
+              have heq : (show QuatAlg FinAdele d.a d.b from (x : BHat d.a d.b) * ((u⁻¹ : (BHat d.a d.b)ˣ) : BHat d.a d.b)) =
+                (show QuatAlg FinAdele d.a d.b from (x : BHat d.a d.b)) * (show QuatAlg FinAdele d.a d.b from ((u⁻¹ : (BHat d.a d.b)ˣ) : BHat d.a d.b)) := rfl
+              rw [heq] at h2
+              exact congrArg (fun t => t * nrd (show QuatAlg FinAdele d.a d.b from ((x⁻¹ : (BHat d.a d.b)ˣ) : BHat d.a d.b))) h2
+          _ = nrd (show QuatAlg FinAdele d.a d.b from ((u⁻¹ : (BHat d.a d.b)ˣ) : BHat d.a d.b)) *
+              (nrd (show QuatAlg FinAdele d.a d.b from (x : BHat d.a d.b)) *
+              nrd (show QuatAlg FinAdele d.a d.b from ((x⁻¹ : (BHat d.a d.b)ˣ) : BHat d.a d.b))) := by ring
+          _ = nrd (show QuatAlg FinAdele d.a d.b from ((u⁻¹ : (BHat d.a d.b)ˣ) : BHat d.a d.b)) * 1 := by rw [hx_nrd]
+          _ = nrd (show QuatAlg FinAdele d.a d.b from ((u⁻¹ : (BHat d.a d.b)ˣ) : BHat d.a d.b)) := by rw [mul_one]
+      rw [h_coe_inv] at h_nrd_inv
+      exact h_nrd_inv.symm
+    have hnrd_emb_inv : nrd (show QuatAlg FinAdele d.a d.b from finEmbed d.a d.b ((γ⁻¹ : (QuatAlg ℚ d.a d.b)ˣ) : QuatAlg ℚ d.a d.b)) =
+        algebraMap ℚ FinAdele (nrd ((γ⁻¹ : (QuatAlg ℚ d.a d.b)ˣ) : QuatAlg ℚ d.a d.b)) :=
+      ((nrd_trd_basic (R := ℚ) (a := d.a) (b := d.b)).2.2.2 FinAdele (algebraMap ℚ FinAdele) ((γ⁻¹ : (QuatAlg ℚ d.a d.b)ˣ) : QuatAlg ℚ d.a d.b)).1
+    rw [← hnrd_emb_inv, ← hnrd_inv_conj]
+    exact hnrd_uInv
+  obtain ⟨n, hn⟩ := rat_isInt_of_mem_zhat _ h_alg_mem
+  obtain ⟨m, hm⟩ := rat_isInt_of_mem_zhat _ h_alg_inv_mem
+  have hQmul : nrd (γ : QuatAlg ℚ d.a d.b) * nrd ((γ⁻¹ : (QuatAlg ℚ d.a d.b)ˣ) : QuatAlg ℚ d.a d.b) = 1 := by
+    have hmul : nrd ((γ : QuatAlg ℚ d.a d.b) * ((γ⁻¹ : (QuatAlg ℚ d.a d.b)ˣ) : QuatAlg ℚ d.a d.b)) = 1 := by
+      rw [Units.mul_inv]
+      simp [nrd]
