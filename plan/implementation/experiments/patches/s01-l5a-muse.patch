+/-- `lem:s01-stab` monotonicity: `U ≤ U'` implies `Γ_x(U) ≤ Γ_x(U')`. -/
+theorem Gam_mono {a b : ℤ} {U U' : Subgroup (BHat a b)ˣ} {x : (BHat a b)ˣ}
+    (h : U ≤ U') : Gam (a := a) (b := b) U x ≤ Gam U' x := by
+  intro γ hγ
+  have hmem : (Units.map (finEmbed a b).toMonoidHom γ : (BHat a b)ˣ) ∈
+      U.map (MulAut.conj x).toMonoidHom := hγ
+  obtain ⟨u, huU, huEq⟩ := Subgroup.mem_map.mp hmem
+  have hmem' : (Units.map (finEmbed a b).toMonoidHom γ : (BHat a b)ˣ) ∈
+      U'.map (MulAut.conj x).toMonoidHom :=
+    Subgroup.mem_map.mpr ⟨u, h huU, huEq⟩
+  exact hmem'
+
+/-- `lem:s01-stab` (c) first part: `|Γ_x(U)| ∣ 24` for `U ≤ Ô^×`. -/
+theorem card_Gam_dvd_24 {d : DefiniteData}
+    {U : Subgroup (BHat d.a d.b)ˣ} {x : (BHat d.a d.b)ˣ}
+    (hU : U ≤ d.Ohat) : Nat.card (Gam (a := d.a) (b := d.b) U x) ∣ 24 := by
+  have hle' : Gam (a := d.a) (b := d.b) U x ≤ Gam (a := d.a) (b := d.b) d.Ohat x :=
+    Gam_mono (a := d.a) (b := d.b) (x := x) hU
+  have hstab := stabilizer_units (a := d.a) (b := d.b) d.O.1 x
+  have hfin_big : Finite (Gam (a := d.a) (b := d.b) d.Ohat x) := by
+    have h1 := hstab.2.2 d.ha d.hb
+    have h2 : Gam (a := d.a) (b := d.b) d.Ohat x = classStabilizer (orderCompletionUnits d.O.1) x := rfl
+    rw [h2]
+    exact h1.1
+  have hcard_big_dvd : Nat.card (Gam (a := d.a) (b := d.b) d.Ohat x) ∣ 24 := by
+    have h2 : Gam (a := d.a) (b := d.b) d.Ohat x = classStabilizer (orderCompletionUnits d.O.1) x := rfl
+    rw [h2]
+    obtain ⟨Ox, _, hEq⟩ := hstab.1
+    rw [hEq]
+    exact (card_unitGroup_dvd_24 d.ha d.hb Ox).2.1
+  have hcard_le_dvd : Nat.card (Gam (a := d.a) (b := d.b) U x) ∣
+      Nat.card (Gam (a := d.a) (b := d.b) d.Ohat x) := by
+    letI : Finite (Gam (a := d.a) (b := d.b) d.Ohat x) := hfin_big
+    letI : Finite (Gam (a := d.a) (b := d.b) U x) :=
+      Finite.of_injective (Subgroup.inclusion hle') (Subgroup.inclusion_injective hle')
+    exact Subgroup.card_dvd_of_le hle'
+  exact Nat.dvd_trans hcard_le_dvd hcard_big_dvd
+
+/-- `lem:s01-stab` (c) second part: for `p ≥ 5` prime, `p ∤ |Γ_x(U)|`. -/
+theorem not_dvd_card_Gam {d : DefiniteData}
+    {U : Subgroup (BHat d.a d.b)ˣ} {x : (BHat d.a d.b)ˣ}
+    {p : ℕ} (hp : Nat.Prime p) (h5 : 5 ≤ p) (hU : U ≤ d.Ohat) :
+    ¬ p ∣ Nat.card (Gam (a := d.a) (b := d.b) U x) := by
+  intro hdvd
+  have h24 : Nat.card (Gam (a := d.a) (b := d.b) U x) ∣ 24 := card_Gam_dvd_24 (d := d) hU
+  have hp24 : p ∣ 24 := Nat.dvd_trans hdvd h24
+  have hle : p ≤ 24 := Nat.le_of_dvd (by norm_num) hp24
+  interval_cases p <;> simp_all
+
+end Langlandscape.Quat
