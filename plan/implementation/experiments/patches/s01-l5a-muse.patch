+        nrd (γ : QuatAlg ℚ d.a d.b) * nrd ((γ⁻¹ : (QuatAlg ℚ d.a d.b)ˣ) : QuatAlg ℚ d.a d.b) :=
+      (nrd_trd_basic (R := ℚ) (a := d.a) (b := d.b)).2.1 _ _
+    rw [h_eq] at hmul
+    exact hmul
+  have hnm : (n : ℚ) * (m : ℚ) = 1 := by
+    have h1 : nrd (γ : QuatAlg ℚ d.a d.b) * nrd ((γ⁻¹ : (QuatAlg ℚ d.a d.b)ˣ) : QuatAlg ℚ d.a d.b) = 1 := hQmul
+    rw [hn, hm] at h1
+    exact h1
