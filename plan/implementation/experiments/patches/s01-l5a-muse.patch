+  have hn_eq : n = 1 ∨ n = -1 := by
+    have h1 : n ∣ 1 := ⟨m, h_int_one.symm⟩
+    have h2 : IsUnit n := isUnit_of_dvd_one h1
+    rwa [Int.isUnit_iff.mp h2]
+  have h_pos : 0 < nrd (γ : QuatAlg ℚ d.a d.b) := by
+    have hq0 : nrd (γ : QuatAlg ℚ d.a d.b) ≠ 0 := left_ne_zero_of_mul_eq_one hQmul
+    have h0 := ((nrd_definite ha hb).1 (γ : QuatAlg ℚ d.a d.b)).1
+    exact lt_of_le_of_ne (le_trans (by positivity) h0) (Ne.symm hq0)
+  rcases hn_eq with rfl | rfl
+  · exact hn
+  · exfalso
+    rw [hn] at h_pos
+    norm_num at h_pos
