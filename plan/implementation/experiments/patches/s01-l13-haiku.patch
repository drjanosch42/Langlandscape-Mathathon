+import Mathlib.Data.Nat.Prime.Defs
+import Mathlib.RingTheory.Ideal.Maps
+import Mathlib.Algebra.Algebra.Hom
+
+/-!
+# Λ-adic Jacquet–Langlands target as a `Prop` (S01-L13)
+
+`plan/staged/stage-01-quaternion-foundations.tex`, `thm:s01-lambdaJL`, `if:s01-targets`.
+
+* `LambdaJLGen` : generator labels `T_ℓ`, `U_ℓ`, `⟨d⟩`, `Π_ℓ` of the ordinary Λ-adic Hecke algebras.
+* `Hyp.LambdaJL D M p Λ TGL TB genGL genB newIdeal` : there is a surjective `Λ`-algebra map `TGL → TB` matching the
+  generators (`U_ℓ ↦ +Π_ℓ` for `ℓ ∣ D`), whose kernel is the abstract ideal `newIdeal` cutting out the `D`-new
+  quotient, i.e. `T^{ord, D-new} ≅ T_B^{ord}`.
+
+Schematic interface: the GL₂ side (`TGL`, `genGL`, `newIdeal`) is abstract data because Mathlib v4.35.0 has no
+Hecke operators on `S_k(Γ_0(N))`; the hypothesis is Λ-adic JL only when these are instantiated by the true algebra
+and ideal, which cannot be checked in Lean here. No later theorem may be advertised as "under Λ-adic JL" without
+this caveat.
+
+Status: *cited (with reference)* for the mathematical content; the definition is *formalized*.
+-/
+
+namespace Langlandscape
+
+/-- Generator labels of the ordinary Λ-adic Hecke algebras (tex `thm:s01-lambdaJL`). -/
+inductive LambdaJLGen
+  | T (ℓ : ℕ)
+  | U (ℓ : ℕ)
+  | dia (d : ℕ)
+  | Pi (ℓ : ℕ)
+
+/-- Schematic interface for Λ-adic Jacquet–Langlands (tex `thm:s01-lambdaJL`). The GL₂ side `genGL`, `newIdeal` is
+abstract data (no Hecke operators on `S_k(Γ_0(N))` in Mathlib v4.35.0); the statement is JL only when instantiated
+by the true algebra and ideal. The kernel conjunct says `ker φ = newIdeal`, i.e. `TGL ⧸ newIdeal ≅ T^{ord, D-new}`
+and `φ` induces `T^{ord, D-new} ≅ T_B^{ord}`. Source: Hida theory and Jacquet–Langlands; cited; not to be discharged
+in this project. -/
+def Hyp.LambdaJL (D M p : ℕ) (Λ TGL TB : Type*) [CommRing Λ] [CommRing TGL] [CommRing TB]
+    [Algebra Λ TGL] [Algebra Λ TB] (genGL : LambdaJLGen → TGL) (genB : LambdaJLGen → TB)
+    (newIdeal : Ideal TGL) : Prop :=
+  ∃ φ : TGL →ₐ[Λ] TB,
+    (Function.Surjective φ ∧
+      (∀ ℓ, ℓ.Prime → ¬ ℓ ∣ D * M * p → φ (genGL (.T ℓ)) = genB (.T ℓ)) ∧
+      (∀ ℓ, ℓ.Prime → ℓ ∣ M * p → φ (genGL (.U ℓ)) = genB (.U ℓ)) ∧
+      (∀ d, φ (genGL (.dia d)) = genB (.dia d)) ∧
+      (∀ ℓ, ℓ.Prime → ℓ ∣ D → φ (genGL (.U ℓ)) = genB (.Pi ℓ))) ∧   -- `U_ℓ ↦ +Π_ℓ` (F6/D3)
+    RingHom.ker φ.toRingHom = newIdeal                                 -- `T^{ord, D-new} ≅ T_B^{ord}`
+
+end Langlandscape
