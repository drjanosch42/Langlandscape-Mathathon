index 0000000..3d4fd17
--- /dev/null
+++ b/code/python/langlandscape/quat.py
@@ -0,0 +1,329 @@
+"""Definite quaternion algebras over Q of squarefree discriminant D, maximal orders and ideal classes.
+
+``DefiniteAlgebra(D)`` realises B = (a, b)_Q (i^2 = a, j^2 = b, a, b < 0) ramified exactly at the primes dividing D
+and at infinity (omega(D) odd); stage tex Def. ``def:s01-B``.
+
+* Maximal order.  Starting from Z<1,i,j,k>, an order is enlarged at a prime l with l^2 | disc/D^2 by adjoining c/l,
+  c running over the kernel of the trace form mod l with l^2 | nrd(c), and closing under multiplication
+  (``DefiniteAlgebra._enlarge``, whose docstring contains the correctness argument).  An order is maximal iff its
+  reduced discriminant is D [Voight, *Quaternion Algebras*, GTM 288 (2021), Ch. 15 and Thm. 15.5.5].
+* Classes.  Left ideal classes of the maximal order are enumerated by l-neighbours (l the smallest prime not dividing
+  D): right multiplication by the l+1 left ideals of norm l of the right order, a connected graph by strong
+  approximation [Kirschmer-Voight, *Algorithmic enumeration of ideal classes for quaternion orders*, SIAM J. Comput.
+  39 (2010), Sec. 6; Voight Ch. 17].  I ~ J iff conj(I)J contains an element of reduced norm N(I)N(J), decided
+  with ``qfminim``.
+* Stabilisers.  |Gamma_x| = |O_x^x| (full unit group, *not* modulo +-1), O_x the right order of the x-th class;
+  this is Gamma_x of stage tex Def. ``def:s01-classset`` at level U = O-hat^x (Prop. ``prop:s01-finite``;
+  Voight Thm. 11.5.14).  With this convention the Eichler mass formula reads sum 1/|Gamma_x| = prod_{l | D}(l-1)/24
+  (stage tex Thm. ``thm:s01-mass``(a); Voight Thm. 25.1.1, Eichler 1955), checked in ``classset.py``.
+* Type number.  Norm forms of the right orders are compared with ``qfisom``.
+
+Status of claims: computed (PARI via cypari2); the maximal-order step is proved in ``_enlarge``'s docstring.
+"""
+
+from __future__ import annotations
+
+import itertools
+import math
+from fractions import Fraction
+from functools import cached_property
+
+from .pari import get_pari
+
+Vec = tuple  # 4-tuple of Fractions (coordinates in 1, i, j, k)
+
+
+def primes_of(n: int) -> list[int]:
+    """The distinct prime divisors of ``n >= 1``, increasing."""
+    ps, p = [], 2
+    while p * p <= n:
+        if n % p == 0:
+            ps.append(p)
+            while n % p == 0:
+                n //= p
+        p += 1
+    if n > 1:
+        ps.append(n)
+    return ps
+
+
+def is_squarefree(n: int) -> bool:
+    """Whether ``n >= 1`` is squarefree."""
+    return all(n % (p * p) for p in primes_of(n))
+
+
+class Lattice:
+    """Full-rank Z-lattice in B = Q^4, stored as a canonical HNF basis (rows are basis vectors)."""
+
+    __slots__ = ("alg", "basis", "_key")
+
+    def __init__(self, alg: "DefiniteAlgebra", gens: list[Vec]):
+        self.alg = alg
+        d = 1
+        for g in gens:
+            for c in g:
+                d = d * c.denominator // math.gcd(d, c.denominator)
+        cols = [[int(c * d) for c in g] for g in gens]
+        P = get_pari()
+        M = P.matrix(4, len(cols), [cols[j][i] for i in range(4) for j in range(len(cols))])
+        H = P.mathnf(M)
+        ent = [[int(H[i, j]) for j in range(4)] for i in range(4)]  # ent[i][j] = coord i of basis vector j
+        g = d
+        for row in ent:
+            for e in row:
+                g = math.gcd(g, e)
+        d //= g
+        ent = [[e // g for e in row] for row in ent]
+        self._key = (d, tuple(tuple(r) for r in ent))
+        self.basis = [tuple(Fraction(ent[i][j], d) for i in range(4)) for j in range(4)]
+
+    def __eq__(self, other):
+        return self._key == other._key
+
+    def __hash__(self):
+        return hash(self._key)
+
+    def covolume(self) -> Fraction:
+        d, ent = self._key
+        P = get_pari()
+        det = abs(int(P.matdet(P.matrix(4, 4, [ent[i][j] for i in range(4) for j in range(4)]))))
+        return Fraction(det, d**4)
+
+    def conj(self) -> "Lattice":
+        return Lattice(self.alg, [self.alg.conj(v) for v in self.basis])
+
+    def __mul__(self, other: "Lattice") -> "Lattice":
+        mul = self.alg.mul
+        return Lattice(self.alg, [mul(x, y) for x in self.basis for y in other.basis])
+
+    def scale(self, c: Fraction) -> "Lattice":
+        return Lattice(self.alg, [tuple(c * x for x in v) for v in self.basis])
+
+    def add(self, other: "Lattice") -> "Lattice":
+        return Lattice(self.alg, self.basis + other.basis)
+
+
+class DefiniteAlgebra:
+    """Definite quaternion algebra of squarefree discriminant ``D`` (``omega(D)`` odd) over Q."""
+
+    def __init__(self, D: int):
+        if D < 2 or not is_squarefree(D):
+            raise ValueError("D must be squarefree and > 1")
+        self.primes = primes_of(D)
+        if len(self.primes) % 2 == 0:
+            raise ValueError("omega(D) must be odd for a definite algebra")
+        self.D = D
+        self.a, self.b = self._find_ab()
+        self.order = self._maximal_order()
+
+    # -- algebra B = (a,b) ------------------------------------------------------------------------------
+    def _find_ab(self) -> tuple[int, int]:
+        """(a, b) with a, b < 0 squarefree, |ab| minimal, such that (a, b)_Q is ramified exactly at D and infinity.
+
+        Ramification at a finite prime p is read off from the Hilbert symbol (a, b)_p; it can only occur for p | 2ab.
+        Any such pair works: ``_maximal_order`` is correct for every (a, b).
+        """
+        P = get_pari()
+        target = set(self.primes)
+        for n in itertools.count(1):
+            for a in range(1, math.isqrt(n) + 1):
+                if n % a or not is_squarefree(a) or not is_squarefree(n // a):
+                    continue
+                b = n // a
+                for (x, y) in ((-a, -b), (-b, -a)):
+                    ram = {p for p in primes_of(2 * n) if int(P.hilbert(x, y, p)) == -1}
+                    if ram == target:
+                        return x, y
+        raise AssertionError  # pragma: no cover
+
+    def mul(self, x: Vec, y: Vec) -> Vec:
+        a, b = self.a, self.b
+        x0, x1, x2, x3 = x
+        y0, y1, y2, y3 = y
+        return (
+            x0 * y0 + a * x1 * y1 + b * x2 * y2 - a * b * x3 * y3,
+            x0 * y1 + x1 * y0 - b * x2 * y3 + b * x3 * y2,
+            x0 * y2 + x2 * y0 + a * x1 * y3 - a * x3 * y1,
+            x0 * y3 + x3 * y0 + x1 * y2 - x2 * y1,
+        )
+
+    @staticmethod
+    def conj(x: Vec) -> Vec:
+        return (x[0], -x[1], -x[2], -x[3])
+
+    def nrd(self, x: Vec) -> Fraction:
+        return x[0] ** 2 - self.a * x[1] ** 2 - self.b * x[2] ** 2 + self.a * self.b * x[3] ** 2
+
+    @staticmethod
+    def trd(x: Vec) -> Fraction:
+        return 2 * x[0]
+
+    def gram(self, L: Lattice, scale: Fraction = Fraction(1)) -> list[list[int]]:
+        """Gram matrix of the form 2*nrd(x)/scale on ``L`` (must be integral)."""
+        bs = L.basis
+        G = [[self.trd(self.mul(bs[i], self.conj(bs[j]))) / scale for j in range(4)] for i in range(4)]
+        assert all(g.denominator == 1 for r in G for g in r), "form not integral"
+        return [[int(g) for g in r] for r in G]
+
+    # -- maximal order ----------------------------------------------------------------------------------
+    def _trace_matrix(self, O: Lattice) -> list[list[int]]:
+        """Integer matrix (trd(b_i b_j)) of the trace form on the basis of the order ``O``."""
+        bs = O.basis
+        T = [[self.trd(self.mul(bs[i], bs[j])) for j in range(4)] for i in range(4)]
+        assert all(t.denominator == 1 for r in T for t in r), "not an order"
+        return [[int(t) for t in r] for r in T]
+
+    def _disc(self, O: Lattice) -> int:
+        """|det(trd(b_i b_j))| = discrd(O)^2 for an order ``O``; equals D^2 iff ``O`` is maximal."""
+        P = get_pari()
+        T = self._trace_matrix(O)
+        return abs(int(P.matdet(P.matrix(4, 4, [T[i][j] for i in range(4) for j in range(4)]))))
+
+    def _maximal_order(self) -> Lattice:
+        """A maximal order containing Z<1,i,j,k>, by repeated enlargement at the primes l with l^2 | disc/D^2."""
+        one, I, J, K = (tuple(Fraction(int(i == j)) for i in range(4)) for j in range(4))
+        O = Lattice(self, [one, I, J, K])
+        while True:
+            disc = self._disc(O)
+            if disc == self.D**2:
+                return O
+            assert disc % self.D**2 == 0
+            l = primes_of(disc // self.D**2)[0]
+            O2 = self._enlarge(O, l)
+            if O2 is None:  # pragma: no cover - impossible by the argument in ``_enlarge``
+                raise RuntimeError("maximalisation failed at l = %d" % l)
+            O = O2
+
+    def _enlarge(self, O: Lattice, l: int) -> Lattice | None:
+        """An order O' with O < O' and l-power index, or ``None`` if ``O`` is l-maximal.
+
+        Correctness (any prime l, ramified or not).  If O is not l-maximal there is an order M > O (inside a maximal
+        order) and z in M - O with l z in O.  Write c = l z in O.  Since M is an order, trd(c y) = l trd(z y) is
+        divisible by l for all y in O, i.e. c mod l lies in the kernel K of the trace form (trd(b_i b_j)) mod l, and
+        nrd(c) = l^2 nrd(z) is divisible by l^2.  Conversely, for c in O with c mod l in K, nrd(c) mod l^2 depends
+        only on c mod l (nrd(c + l y) = nrd(c) + l trd(c conj(y)) + l^2 nrd(y), and trd(c conj(y)) = trd(c) trd(y) -
+        trd(c y) is 0 mod l).  Replacing z by a unit multiple or by z + O does not change O[z].  Hence it suffices to
+        run over the projective points c of K with l^2 | nrd(c) and to close O + Z c/l under multiplication; the
+        closure is accepted iff it stabilises before its discriminant drops below D^2.
+        """
+        P = get_pari()
+        B = O.basis
+        T = self._trace_matrix(O)
+        M = P.matrix(4, 4, [T[i][j] for i in range(4) for j in range(4)]) * P("Mod(1,%d)" % l)
+        ker = P.matker(M)
+        kb = [[int(P.lift(ker[j][i])) for i in range(4)] for j in range(len(ker))]
+        r = len(kb)
+        covol_min = Fraction(self.D) / (4 * abs(self.a * self.b))  # covolume of a maximal order
+        for t in range(r):  # projective points: coefficient vectors (0,..,0,1,*,..,*)
+            for rest in itertools.product(range(l), repeat=r - 1 - t):
+                coef = [0] * t + [1] + list(rest)
+                c = [sum(coef[s] * kb[s][i] for s in range(r)) for i in range(4)]
+                x = tuple(sum(Fraction(c[i]) * B[i][k] for i in range(4)) for k in range(4))
+                if self.nrd(x) % (l * l):
+                    continue
+                L = Lattice(self, B + [tuple(v / l for v in x)])
+                while True:
+                    if L.covolume() < covol_min:
+                        break  # not contained in any order
+                    L2 = L.add(L * L)
+                    if L2 == L:
+                        return L
+                    L = L2
+        return None
+
+    # -- ideals -----------------------------------------------------------------------------------------
+    def norm_of(self, I: Lattice) -> int:
+        """Reduced norm of a left ideal of the maximal order: sqrt of the index [O : I]."""
+        idx = I.covolume() / self.order.covolume()
+        n = math.isqrt(int(idx))
+        assert idx.denominator == 1 and n * n == idx
+        return n
+
+    def right_order(self, I: Lattice) -> Lattice:
+        return (I.conj() * I).scale(Fraction(1, self.norm_of(I)))
+
+    def units(self, R: Lattice) -> int:
+        """|R^x| = number of x in R with nrd(x) = 1 (qfminim on the norm form)."""
+        P = get_pari()
+        G = self.gram(R)
+        return _count_norm_two(P, G)
+
+    def equivalent(self, I: Lattice, J: Lattice) -> bool:
+        """I ~ J as left ideals (J = I*alpha) iff conj(I)*J has an element of reduced norm N(I)N(J)."""
+        if I == J:
+            return True
+        scale = Fraction(self.norm_of(I) * self.norm_of(J))
+        L = I.conj() * J
+        return _count_norm_two(get_pari(), self.gram(L, scale)) > 0
+
+    def neighbours(self, I: Lattice, l: int) -> list[Lattice]:
+        """The l+1 left ideals I*J, J running over the left ideals of norm l of the right order of I."""
+        R = self.right_order(I)
+        found: dict[Lattice, None] = {}
+        lR = R.scale(Fraction(l))
+        for c in itertools.product(range(l), repeat=4):
+            if not any(c):
+                continue
+            al = tuple(sum(Fraction(c[i]) * R.basis[i][k] for i in range(4)) for k in range(4))
+            if self.nrd(al) % l:
+                continue
+            J = Lattice(self, [self.mul(r, al) for r in R.basis] + lR.basis)
+            if J.covolume() != R.covolume() * l * l:
+                continue
+            found[J] = None
+            if len(found) == l + 1:
+                break
+        assert len(found) == l + 1
+        return [I * J for J in found]
+
+    def _neighbour_prime(self) -> int:
+        """The smallest prime l not dividing D (the l-neighbour graph on classes is then connected)."""
+        l = 2
+        while self.D % l == 0 or primes_of(l) != [l]:
+            l += 1
+        return l
+
+    @cached_property
+    def classes(self) -> list[Lattice]:
+        """Representatives of the left ideal classes of the maximal order (BFS in the l-neighbour graph)."""
+        l = self._neighbour_prime()
+        reps = [self.order]
+        queue = [self.order]
+        while queue:
+            I = queue.pop(0)
+            for N in self.neighbours(I, l):
+                if not any(self.equivalent(N, X) for X in reps):
+                    reps.append(N)
+                    queue.append(N)
+        return reps
+
+    @cached_property
+    def right_orders(self) -> list[Lattice]:
+        return [self.right_order(I) for I in self.classes]
+
+    @cached_property
+    def unit_orders(self) -> list[int]:
+        """|Gamma_x| = |O_x^x| for each class, in the order of ``classes``."""
+        return [self.units(R) for R in self.right_orders]
+
+    def type_number(self) -> int:
+        """Number of isometry classes of norm forms of the right orders (computed with ``qfisom``)."""
+        P = get_pari()
+        grams = [P.matrix(4, 4, [e for r in self.gram(R) for e in r]) for R in self.right_orders]
+        reps = []
+        for G in grams:
+            if not any(_isometric(P, G, H) for H in reps):
+                reps.append(G)
+        return len(reps)
+
+
+def _count_norm_two(P, G: list[list[int]]) -> int:
+    """Number of x in Z^4 with x^T G x = 2 (G positive definite, even); exact ``qfminim`` (flag 0)."""
+    M = P.matrix(4, 4, [G[i][j] for i in range(4) for j in range(4)])
+    vecs = P.qfminim(M, 2, None, 0)[2]  # one vector of each pair +-v
+    return 2 * sum(1 for j in range(int(P.matsize(vecs)[1])) if int(P.qfeval(M, vecs[j])) == 2)
+
+
+def _isometric(P, G, H) -> bool:
+    """Integral isometry of the positive definite forms ``G``, ``H`` (``qfisom`` returns 0 if there is none)."""
+    return bool(P.qfisom(G, H) != 0)
