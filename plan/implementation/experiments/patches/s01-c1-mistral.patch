index 0000000..a7420d0
--- /dev/null
+++ b/code/python/langlandscape/classset.py
@@ -0,0 +1,75 @@
+"""Class sets at level O-hat^x of definite quaternion algebras of squarefree discriminant D (computed with PARI).
+
+For each D: the class number h = |X_B(O-hat^x)|, the stabiliser orders |Gamma_x| = |O_x^x| (full unit group of the
+right order, not modulo +-1; stage tex Def. ``def:s01-classset``, Prop. ``prop:s01-finite``), the type number and
+the mass sum 1/|Gamma_x|, compared with the Eichler mass formula prod_{l | D}(l-1)/24 = phi(D)/24 (stage tex
+Thm. ``thm:s01-mass``(a), full-unit convention; Voight, *Quaternion Algebras*, Thm. 25.1.1; Eichler 1955).
+Checks against stage tex Ex. ``ex:s01-masschecks``.  Algorithms: see ``quat.py``.
+
+Status: computed.  Result file: ``code/results/s01/classsets.json`` (``python -m langlandscape.classset``).
+"""
+
+from __future__ import annotations
+
+import time
+from fractions import Fraction
+
+from .quat import DefiniteAlgebra, is_squarefree, primes_of
+
+EXTRA_D = (66, 70, 78)
+
+
+def phi(D: int) -> int:
+    """Euler's phi of the squarefree ``D``, i.e. prod_{l | D} (l - 1)."""
+    r = 1
+    for p in primes_of(D):
+        r *= p - 1
+    return r
+
+
+def definite_discriminants() -> list[int]:
+    """Squarefree D <= 60 with omega(D) odd, plus 66, 70, 78."""
+    ds = [D for D in range(2, 61) if is_squarefree(D) and len(primes_of(D)) % 2 == 1]
+    return ds + list(EXTRA_D)
+
+
+def class_set(D: int) -> dict:
+    """Class number, stabiliser orders |Gamma_x|, type number and mass of B_D at level O-hat^x."""
+    A = DefiniteAlgebra(D)
+    orders = sorted(A.unit_orders)
+    mass = sum(Fraction(1, g) for g in orders)
+    return {
+        "D": D,
+        "a": A.a,
+        "b": A.b,
+        "h": len(orders),
+        "gamma_orders": orders,
+        "type_number": A.type_number(),
+        "mass": mass,
+        "mass_expected": Fraction(phi(D), 24),
+        "mass_ok": mass == Fraction(phi(D), 24),
+    }
+
+
+def compute_all() -> dict:
+    """``class_set(D)`` for all D of ``definite_discriminants()``, keyed by ``str(D)``."""
+    return {str(D): class_set(D) for D in definite_discriminants()}
+
+
+def main() -> None:  # pragma: no cover - writes the result file
+    from . import results
+
+    t = time.perf_counter()
+    data = compute_all()
+    results.write(
+        "s01/classsets.json",
+        data,
+        script="code/python/langlandscape/classset.py",
+        params={"D": definite_discriminants(), "level": "maximal order O-hat^x"},
+        runtime_s=time.perf_counter() - t,
+        notes="Gamma_x = O_x^x (full unit group); mass = sum 1/|Gamma_x| = prod(l-1)/24.",
+    )
+
+
+if __name__ == "__main__":  # pragma: no cover
+    main()
diff --git a/code/python/langlandscape/quat.py b/code/python/langlandscape/quat.py
