+/-!
+Source of the statements: `plan/staged/stage-02-tree-quotients.tex` (`def:s02-tree`,
+`lem:s02-tree`(b)-(d)).  Explicitness convention as in `Tree/Local.lean`.
+
+The Bruhat–Tits tree in coset form: vertices `GL₂(ℚ_q) / (Z · GL₂(ℤ_q))`, oriented edges
+`GL₂(ℚ_q) / (Z · Iw_q)` with `o [g] = [g]`, `t [g] = [g α]`; the type is `vdet g`
+(`lem:s02-tree`(b)); `SL₂(ℚ_q)` is transitive on type-`0` vertices, type-`1` vertices and
+edges with the stated stabilisers (`lem:s02-tree`(c)).  Status: *proved* (seed proof, completed in
+the stage tex).
+-/
+
+namespace Langlandscape.Tree
+
+open Langlandscape.Local (GL2Zl Iw)
+
+variable (q : ℕ) [Fact q.Prime]
+
+/-- `Z · GL₂(ℤ_q)`, the stabiliser of the vertex `v₀` in `GL₂(ℚ_q)` (`def:s02-tree`). -/
+noncomputable def ZK : Subgroup (GL (Fin 2) ℚ_[q]) :=
+  Subgroup.center (GL (Fin 2) ℚ_[q]) ⊔ GL2Zl q
+
+/-- `Z · Iw_q`, the stabiliser of the base edge in `GL₂(ℚ_q)` (`def:s02-tree`). -/
+noncomputable def ZIw : Subgroup (GL (Fin 2) ℚ_[q]) :=
+  Subgroup.center (GL (Fin 2) ℚ_[q]) ⊔ Iw q
+
+/-- The vertices `GL₂(ℚ_q) / (Z · GL₂(ℤ_q))` of the tree (`def:s02-tree`). -/
+abbrev Vert : Type := GL (Fin 2) ℚ_[q] ⧸ ZK q
+
+/-- All *oriented* edges `GL₂(ℚ_q) / (Z · Iw_q)`: both orientations of every geometric edge
+(`def:s02-tree`). -/
+abbrev Edge : Type := GL (Fin 2) ℚ_[q] ⧸ ZIw q
+
+/-- `Z ≤ Z · GL₂(ℤ_q)` (`s02-tree`). -/
+lemma center_le_ZK : Subgroup.center (GL (Fin 2) ℚ_[q]) ≤ ZK q := le_sup_left
+
+/-- `GL₂(ℤ_q) ≤ Z · GL₂(ℤ_q)` (`s02-tree`). -/
+lemma GL2Zl_le_ZK : GL2Zl q ≤ ZK q := le_sup_right
+
+/-- `center ≤ Z · Iw_q` (`s02-tree`). -/
+lemma center_le_ZIw : Subgroup.center (GL (Fin 2) ℚ_[q]) ≤ ZIw q := le_sup_left
+
+/-- `Iw_q ≤ Z · Iw_q` (`s02-tree`). -/
+lemma Iw_le_ZIw : Iw q ≤ ZIw q := le_sup_right
+
+/-- `Z · Iw_q ≤ Z · GL₂(ℤ_q)` (`s02-tree`). -/
+lemma ZIw_le_ZK : ZIw q ≤ ZK q :=
+  sup_le_sup_left (Langlandscape.Local.K0_le_GL2Zl 1) _
+
+/-- `α⁻¹ (Z · Iw_q) α ⊆ Z · GL₂(ℤ_q)`, the well-definedness of `t`
+(`lem:s02-tree`(d), `s02-tree`). -/
+lemma conj_mem_ZK {h : GL (Fin 2) ℚ_[q]} (hh : h ∈ ZIw q) :
+    (alphaq q)⁻¹ * h * alphaq q ∈ ZK q := by
+  have key : ZIw q ≤ (ZK q).comap (MulAut.conj (alphaq q)⁻¹).toMonoidHom := by
+    unfold ZIw
+    refine sup_le ?_ ?_
+    · intro z hz
+      have hz' := Subgroup.mem_center_iff.1 hz (alphaq q)⁻¹
+      show (alphaq q)⁻¹ * z * ((alphaq q)⁻¹)⁻¹ ∈ ZK q
+      rw [inv_inv, hz', mul_assoc, inv_mul_cancel, mul_one]
+      exact center_le_ZK q hz
+    · intro k hk
+      show (alphaq q)⁻¹ * k * ((alphaq q)⁻¹)⁻¹ ∈ ZK q
+      rw [inv_inv]
+      exact GL2Zl_le_ZK q (alphaq_inv_conj_mem_GL2Zl hk)
+  have h2 : (alphaq q)⁻¹ * h * ((alphaq q)⁻¹)⁻¹ ∈ ZK q := key hh
+  rwa [inv_inv] at h2
+
+/-- Right translation by `α` is compatible with the cosets (`def:s02-tree`, `s02-tree`). -/
+lemma inv_mul_alphaq_mem_ZK {a b : GL (Fin 2) ℚ_[q]} (h : a⁻¹ * b ∈ ZIw q) :
+    (a * alphaq q)⁻¹ * (b * alphaq q) ∈ ZK q := by
+  have h2 := conj_mem_ZK q h
+  have e : (a * alphaq q)⁻¹ * (b * alphaq q) = (alphaq q)⁻¹ * (a⁻¹ * b) * alphaq q := by group
+  rw [e]
+  exact h2
+
+/-- `lem:s02-tree`(c) input: an element of `SL₂(ℚ_q) ∩ Z · GL₂(ℤ_q)` lies in `GL₂(ℤ_q)`
+(Serre, *Trees*, II.1.3, Lemma 1, p. 76; `s02-tree`). -/
+lemma mem_GL2Zl_of_mem_SLq_ZK {g : GL (Fin 2) ℚ_[q]} (hg : g ∈ SLq q) (hZ : g ∈ ZK q) :
+    g ∈ GL2Zl q := by
+  have hZ' : g ∈ Subgroup.center (GL (Fin 2) ℚ_[q]) ⊔ GL2Zl q := hZ
+  obtain ⟨z, hz, k, hk, rfl⟩ := Subgroup.mem_sup_of_normal_left.1 hZ'
+  rw [Matrix.GeneralLinearGroup.center_eq_range_scalar] at hz
+  obtain ⟨u, rfl⟩ := MonoidHom.mem_range.1 hz
+  have hdet : (Units.val (Matrix.GeneralLinearGroup.scalar (Fin 2) u * k)).det = 1 :=
+    mem_SLq_iff.1 hg
+  have hk1 : ‖(Units.val k).det‖ = 1 := (Langlandscape.Local.mem_GL2Zl_iff.1 hk).2
+  rw [Units.val_mul, Matrix.det_mul, det_scalar_sq] at hdet
+  have hn : ‖(u : ℚ_[q])‖ = 1 := by
+    have h2 := congrArg (fun x : ℚ_[q] => ‖x‖) hdet
+    simp only [norm_mul, norm_pow, hk1, mul_one, norm_one] at h2
+    nlinarith [norm_nonneg (u : ℚ_[q])]
+  exact mul_mem (scalar_mem_GL2Zl hn) hk
+
+/-! ### The maps `o`, `t` and the type -/
+
+section Maps
+
+variable {q}
+
+/-- The origin `o [g] = [g]` of an oriented edge (`def:s02-tree`). -/
+noncomputable def o : Edge q → Vert q := Subgroup.quotientMapOfLE (ZIw_le_ZK q)
+
+/-- The terminus `t [g] = [g α]` of an oriented edge (`def:s02-tree`). -/
+noncomputable def t : Edge q → Vert q :=
+  (Quotient.map' (fun g : GL (Fin 2) ℚ_[q] => g * alphaq q) (fun _ _ h =>
+    QuotientGroup.leftRel_apply.mpr (inv_mul_alphaq_mem_ZK q (QuotientGroup.leftRel_apply.mp h))) :
+      Quotient (QuotientGroup.leftRel (ZIw q)) → Quotient (QuotientGroup.leftRel (ZK q)))
+
+/-- `o [g] = [g]` (`def:s02-tree`, `s02-tree`). -/
+lemma o_mk (g : GL (Fin 2) ℚ_[q]) :
+    o (QuotientGroup.mk g : Edge q) = (QuotientGroup.mk g : Vert q) := rfl
+
+/-- `t [g] = [g α]` (`def:s02-tree`, `s02-tree`). -/
+lemma t_mk (g : GL (Fin 2) ℚ_[q]) :
+    t (QuotientGroup.mk g : Edge q) = (QuotientGroup.mk (g * alphaq q) : Vert q) := rfl
+
+/-- The type `v_q(det g) mod 2` of a vertex `[g]` (`def:s02-tree`). -/
+noncomputable def vtype : Vert q → ZMod 2 :=
+  Quotient.lift (s := QuotientGroup.leftRel (ZK q)) (fun g : GL (Fin 2) ℚ_[q] => vdet q g)
+    (fun a b h => by
+      have h1 : a⁻¹ * b ∈ ZK q := QuotientGroup.leftRel_apply.mp h
+      have h2 := vdet_mul a (a⁻¹ * b)
+      rw [mul_inv_cancel_left, vdet_of_mem_center_sup h1, add_zero] at h2
+      exact h2.symm)
+
+/-- `vtype [g] = vdet g` (`def:s02-tree`, `s02-tree`). -/
+lemma vtype_mk (g : GL (Fin 2) ℚ_[q]) :
+    vtype (QuotientGroup.mk g : Vert q) = vdet q g := rfl
+
+/-- `lem:s02-tree`(b): `g` shifts the type by `vdet g` (`s02-tree`). -/
+theorem vtype_smul (g : GL (Fin 2) ℚ_[q]) (v : Vert q) :
+    vtype (g • v) = vdet q g + vtype v := by
+  obtain ⟨h, rfl⟩ := QuotientGroup.mk_surjective v
+  show vdet q (g * h) = vdet q g + vdet q h
+  exact vdet_mul g h
+
+/-- `o` is equivariant (`def:s02-tree`, `s02-tree`). -/
+theorem o_smul (g : GL (Fin 2) ℚ_[q]) (e : Edge q) : o (g • e) = g • o e := by
+  obtain ⟨h, rfl⟩ := QuotientGroup.mk_surjective e
+  rfl
+
+/-- `t` is equivariant (`def:s02-tree`, `s02-tree`). -/
+theorem t_smul (g : GL (Fin 2) ℚ_[q]) (e : Edge q) : t (g • e) = g • t e := by
+  obtain ⟨h, rfl⟩ := QuotientGroup.mk_surjective e
+  show (QuotientGroup.mk (g * h * alphaq q) : Vert q) = QuotientGroup.mk (g * (h * alphaq q))
+  rw [mul_assoc]
+
+/-- Orientation: `t e` has the other type than `o e` (`def:s02-tree`, `s02-tree`). -/
+theorem vtype_t (e : Edge q) : vtype (t e) = vtype (o e) + 1 := by
+  obtain ⟨g, rfl⟩ := QuotientGroup.mk_surjective e
+  show vdet q (g * alphaq q) = vdet q g + 1
+  rw [vdet_mul, vdet_alphaq]
+
+end Maps
+
+/-- The edges of the tree in the tex sense (`def:s02-tree`): oriented edges whose origin has
+type `0` (the convention of `rem:s02-treeconv`). -/
+abbrev EdgeO : Type := {e : Edge q // vtype (o e) = 0}
+
+/-- Origin of an edge of `EdgeO` (`def:s02-tree`). -/
+noncomputable def oO {q : ℕ} [Fact q.Prime] (e : EdgeO q) : Vert q := o e.1
+
+/-- Terminus of an edge of `EdgeO` (`def:s02-tree`). -/
+noncomputable def tO {q : ℕ} [Fact q.Prime] (e : EdgeO q) : Vert q := t e.1
+
+/-- `SL₂(ℚ_q)` acts on `EdgeO` (`lem:s02-tree`(b): no type change, `s02-tree`). -/
+noncomputable instance : MulAction (SLq q) (EdgeO q) where
+  smul s e := ⟨(s : GL (Fin 2) ℚ_[q]) • e.1, by
+    rw [o_smul, vtype_smul, vdet_of_mem_SLq s.2, zero_add]
+    exact e.2⟩
+  one_smul e := Subtype.ext (one_smul (GL (Fin 2) ℚ_[q]) e.1)
+  mul_smul a b e :=
+    Subtype.ext (mul_smul (a : GL (Fin 2) ℚ_[q]) (b : GL (Fin 2) ℚ_[q]) e.1)
+
+/-- The base vertex `v₀ = [1]` (`def:s02-tree`). -/
+noncomputable def v0 : Vert q := QuotientGroup.mk 1
+
+/-- The base vertex `v₁ = [α] = α v₀` (`def:s02-tree`). -/
+noncomputable def v1 : Vert q := QuotientGroup.mk (alphaq q)
+
+/-- The base edge `e₀ = [1]`, from `v₀` to `v₁` (`def:s02-tree`). -/
+noncomputable def e0 : EdgeO q :=
+  ⟨QuotientGroup.mk 1, by
+    show vdet q 1 = 0
+    exact vdet_one q⟩
+
+section Basics
+
+variable {q}
+
+/-- `SL₂`-equivariance of the origin on `EdgeO` (`def:s02-tree`, `s02-tree`). -/
+theorem oO_smul (s : SLq q) (e : EdgeO q) : oO (s • e) = (s : GL (Fin 2) ℚ_[q]) • oO e :=
+  o_smul (s : GL (Fin 2) ℚ_[q]) e.1
+
+/-- `SL₂`-equivariance of the terminus on `EdgeO` (`def:s02-tree`, `s02-tree`). -/
+theorem tO_smul (s : SLq q) (e : EdgeO q) : tO (s • e) = (s : GL (Fin 2) ℚ_[q]) • tO e :=
+  t_smul (s : GL (Fin 2) ℚ_[q]) e.1
+
+/-- The origin of an `EdgeO` edge has type `0` (`def:s02-tree`, `s02-tree`). -/
+theorem vtype_oO (e : EdgeO q) : vtype (oO e) = 0 := e.2
+
+/-- The terminus of an `EdgeO` edge has type `1` (`def:s02-tree`, `s02-tree`). -/
+theorem vtype_tO (e : EdgeO q) : vtype (tO e) = 1 := by
+  show vtype (t e.1) = 1
+  rw [vtype_t, e.2, zero_add]
+
+end Basics
+
+/-- The origin of the base edge is `v₀` (`def:s02-tree`, `s02-tree`). -/
+theorem oO_e0 : oO (e0 q) = v0 q := rfl
+
+/-- The terminus of the base edge is `v₁` (`def:s02-tree`, `s02-tree`). -/
+theorem tO_e0 : tO (e0 q) = v1 q := by
+  show (QuotientGroup.mk (1 * alphaq q) : Vert q) = QuotientGroup.mk (alphaq q)
+  rw [one_mul]
+
+/-- `v₀` has type `0` (`def:s02-tree`, `s02-tree`). -/
+theorem vtype_v0 : vtype (v0 q) = 0 := vdet_one q
+
+/-- `v₁` has type `1` (`def:s02-tree`, `s02-tree`). -/
+theorem vtype_v1 : vtype (v1 q) = 1 := vdet_alphaq q
+
+section Implicit
+
+variable {q}
+
+/-- `lem:s02-tree`(b): `g ∈ GL₂(ℚ_q)` preserves types iff `v_q(det g)` is even
+(`s02-tree`). -/
+theorem preserves_vtype_iff {g : GL (Fin 2) ℚ_[q]} :
+    (∀ v : Vert q, vtype (g • v) = vtype v) ↔ vdet q g = 0 := by
+  constructor
+  · intro h
+    have h0 := h (v0 q)
+    rw [vtype_smul, vtype_v0, add_zero] at h0
+    exact h0
+  · intro h v
+    rw [vtype_smul, h, zero_add]
+
+/-! ### Transitivity -/
+
+/-- Transitivity input (`lem:s02-tree`(c), `s02-tree`): for `vdet g = 0` there is `s ∈ SL₂(ℚ_q)`
+with `s⁻¹ g ∈ Z · Iw_q`. -/
+theorem exists_SL_of_vdet_zero {g : GL (Fin 2) ℚ_[q]} (hg : vdet q g = 0) :
+    ∃ s ∈ SLq q, s⁻¹ * g ∈ ZIw q := by
+  obtain ⟨z, hz, hdet⟩ := exists_central_norm_one hg
+  obtain ⟨δ, hδ, hs⟩ := exists_diag_split hdet
+  refine ⟨z * g * δ⁻¹, mem_SLq_iff.2 hs, ?_⟩
+  have hc := Subgroup.mem_center_iff.1 (inv_mem hz) g
+  have e : (z * g * δ⁻¹)⁻¹ * g = δ * z⁻¹ := by
+    calc (z * g * δ⁻¹)⁻¹ * g = δ * (g⁻¹ * z⁻¹ * g) := by group
+      _ = δ * z⁻¹ := by rw [mul_assoc g⁻¹ z⁻¹ g, ← hc, inv_mul_cancel_left]
+  rw [e]
+  exact mul_mem (Iw_le_ZIw q hδ) (center_le_ZIw q (inv_mem hz))
+
+/-- Transitivity input (`lem:s02-tree`(c), `s02-tree`): for `vdet g = 1` there is `s ∈ SL₂(ℚ_q)`
+with `(s α)⁻¹ g ∈ Z · GL₂(ℤ_q)`. -/
+theorem exists_SL_of_vdet_one {g : GL (Fin 2) ℚ_[q]} (hg : vdet q g = 1) :
+    ∃ s ∈ SLq q, (s * alphaq q)⁻¹ * g ∈ ZK q := by
+  have h0 : vdet q (g * (alphaq q)⁻¹) = 0 := by
+    have h := vdet_mul (g * (alphaq q)⁻¹) (alphaq q)
+    rw [inv_mul_cancel_right, vdet_alphaq, hg] at h
+    linear_combination -h
+  obtain ⟨z, hz, hdet⟩ := exists_central_norm_one h0
+  obtain ⟨δ, hδ, hs⟩ := exists_diag_split hdet
+  refine ⟨z * (g * (alphaq q)⁻¹) * δ⁻¹, mem_SLq_iff.2 hs, ?_⟩
+  have hc := Subgroup.mem_center_iff.1 (inv_mem hz) g
+  have e : (z * (g * (alphaq q)⁻¹) * δ⁻¹ * alphaq q)⁻¹ * g =
+      ((alphaq q)⁻¹ * δ * alphaq q) * z⁻¹ := by
+    calc (z * (g * (alphaq q)⁻¹) * δ⁻¹ * alphaq q)⁻¹ * g
+        = ((alphaq q)⁻¹ * δ * alphaq q) * (g⁻¹ * z⁻¹ * g) := by group
+      _ = ((alphaq q)⁻¹ * δ * alphaq q) * z⁻¹ := by
+        rw [mul_assoc g⁻¹ z⁻¹ g, ← hc, inv_mul_cancel_left]
+  rw [e]
+  exact mul_mem (GL2Zl_le_ZK q (alphaq_inv_conj_mem_GL2Zl hδ)) (center_le_ZK q (inv_mem hz))
+
+/-- `lem:s02-tree`(c): `SL₂(ℚ_q)` is transitive on the type-`0` vertices (`s02-tree`). -/
+theorem SLq_transitive_type0 {v : Vert q} (h : vtype v = 0) : ∃ s : SLq q, s • v0 q = v := by
+  obtain ⟨g, rfl⟩ := QuotientGroup.mk_surjective v
+  have hg : vdet q g = 0 := h
+  obtain ⟨s, hs, hsg⟩ := exists_SL_of_vdet_zero hg
+  refine ⟨⟨s, hs⟩, ?_⟩
+  show (QuotientGroup.mk (s * 1) : Vert q) = QuotientGroup.mk g
+  rw [QuotientGroup.eq, mul_one]
+  exact ZIw_le_ZK q hsg
+
+/-- `lem:s02-tree`(c): `SL₂(ℚ_q)` is transitive on the type-`1` vertices (`s02-tree`). -/
+theorem SLq_transitive_type1 {v : Vert q} (h : vtype v = 1) : ∃ s : SLq q, s • v1 q = v := by
+  obtain ⟨g, rfl⟩ := QuotientGroup.mk_surjective v
+  have hg : vdet q g = 1 := h
+  obtain ⟨s, hs, hsg⟩ := exists_SL_of_vdet_one hg
+  refine ⟨⟨s, hs⟩, ?_⟩
+  show (QuotientGroup.mk (s * alphaq q) : Vert q) = QuotientGroup.mk g
+  rw [QuotientGroup.eq]
+  exact hsg
+
+/-- `lem:s02-tree`(c): `SL₂(ℚ_q)` is transitive on the edges `EdgeO` (`s02-tree`). -/
+theorem SLq_transitive_edge (e : EdgeO q) : ∃ s : SLq q, s • e0 q = e := by
+  obtain ⟨e, he⟩ := e
+  obtain ⟨g, rfl⟩ := QuotientGroup.mk_surjective e
+  have hg : vdet q g = 0 := he
+  obtain ⟨s, hs, hsg⟩ := exists_SL_of_vdet_zero hg
+  refine ⟨⟨s, hs⟩, Subtype.ext ?_⟩
+  show (QuotientGroup.mk (s * 1) : Edge q) = QuotientGroup.mk g
+  rw [QuotientGroup.eq, mul_one]
+  exact hsg
+
+end Implicit
+
+/-! ### Stabilisers -/
+
+/-- `lem:s02-tree`(c): the stabiliser of `v₀` in `SL₂(ℚ_q)` is `SL₂(ℤ_q)` (`s02-tree`). -/
+theorem stabilizer_v0 :
+    MulAction.stabilizer (SLq q) (v0 q) = (SL2Zq q).subgroupOf (SLq q) := by
+  ext ⟨s, hs⟩
+  rw [MulAction.mem_stabilizer_iff, Subgroup.mem_subgroupOf]
+  show (QuotientGroup.mk (s * 1) : Vert q) = QuotientGroup.mk 1 ↔ s ∈ SL2Zq q
+  rw [QuotientGroup.eq]
+  simp only [mul_one, inv_mem_iff]
+  constructor
+  · intro h
+    exact mem_SL2Zq_iff.2 ⟨hs, mem_GL2Zl_of_mem_SLq_ZK q hs h⟩
+  · intro h
+    exact GL2Zl_le_ZK q (mem_SL2Zq_iff.1 h).2
+
+/-- `lem:s02-tree`(c): the stabiliser of `v₁` in `SL₂(ℚ_q)` is `SL₂ ∩ α GL₂(ℤ_q) α⁻¹`
+(`s02-tree`). -/
+theorem stabilizer_v1 :
+    MulAction.stabilizer (SLq q) (v1 q) = (K1q q).subgroupOf (SLq q) := by
+  ext ⟨s, hs⟩
+  rw [MulAction.mem_stabilizer_iff, Subgroup.mem_subgroupOf]
+  show (QuotientGroup.mk (s * alphaq q) : Vert q) = QuotientGroup.mk (alphaq q) ↔ s ∈ K1q q
+  rw [QuotientGroup.eq]
+  have e : (s * alphaq q)⁻¹ * alphaq q = ((alphaq q)⁻¹ * s * alphaq q)⁻¹ := by group
+  rw [e, inv_mem_iff]
+  constructor
+  · intro h
+    have hdet : (Units.val ((alphaq q)⁻¹ * s * alphaq q)).det = 1 := by
+      rw [det_alphaq_conj]
+      exact mem_SLq_iff.1 hs
+    have hGL := mem_GL2Zl_of_mem_SLq_ZK q (mem_SLq_iff.2 hdet) h
+    exact mem_K1q_iff.2 ⟨hs, mem_Kalpha_iff.2 hGL⟩
+  · intro h
+    exact GL2Zl_le_ZK q (mem_Kalpha_iff.1 (mem_K1q_iff.1 h).2)
+
+/-- `lem:s02-tree`(c): the stabiliser of the base edge in `SL₂(ℚ_q)` is `SL₂ ∩ Iw_q`
+(`s02-tree`). -/
+theorem stabilizer_e0 :
+    MulAction.stabilizer (SLq q) (e0 q) = (IwSL q).subgroupOf (SLq q) := by
+  ext ⟨s, hs⟩
+  rw [MulAction.mem_stabilizer_iff, Subgroup.mem_subgroupOf]
+  refine Subtype.ext_iff.trans ?_
+  show (QuotientGroup.mk (s * 1) : Edge q) = QuotientGroup.mk 1 ↔ s ∈ IwSL q
+  rw [QuotientGroup.eq]
+  simp only [mul_one, inv_mem_iff]
+  constructor
+  · intro h
+    have hGL : s ∈ GL2Zl q := mem_GL2Zl_of_mem_SLq_ZK q hs (ZIw_le_ZK q h)
+    have hc : (alphaq q)⁻¹ * s * alphaq q ∈ ZK q := conj_mem_ZK q h
+    have hdet : (Units.val ((alphaq q)⁻¹ * s * alphaq q)).det = 1 := by
+      rw [det_alphaq_conj]
+      exact mem_SLq_iff.1 hs
+    have hGL' := mem_GL2Zl_of_mem_SLq_ZK q (mem_SLq_iff.2 hdet) hc
+    have hIw : s ∈ Iw q :=
+      (GL2Zl_inf_Kalpha q).le (Subgroup.mem_inf.2 ⟨hGL, mem_Kalpha_iff.2 hGL'⟩)
+    exact mem_IwSL_iff.2 ⟨hs, hIw⟩
+  · intro h
+    exact Iw_le_ZIw q (mem_IwSL_iff.1 h).2
+
+/-! ### The graph -/
+
+/-- The graph on the vertices: `v ~ w` iff some edge `e : EdgeO q` joins them
+(`def:s02-tree`). -/
+noncomputable def graph : SimpleGraph (Vert q) :=
+  SimpleGraph.fromRel (fun v w => ∃ e : EdgeO q, oO e = v ∧ tO e = w)
+
+section Implicit2
+
+variable {q}
+
+/-- Adjacency in `graph q`: some `e : EdgeO q` has `{oO e, tO e} = {v, w}` (`def:s02-tree`,
+`s02-tree`). -/
+theorem graph_adj_iff {v w : Vert q} :
+    (graph q).Adj v w ↔ ∃ e : EdgeO q, ({oO e, tO e} : Set (Vert q)) = {v, w} := by
+  rw [graph, SimpleGraph.fromRel_adj]
+  constructor
+  · rintro ⟨-, ⟨e, h1, h2⟩ | ⟨e, h1, h2⟩⟩
+    · exact ⟨e, Set.pair_eq_pair_iff.2 (Or.inl ⟨h1, h2⟩)⟩
+    · exact ⟨e, Set.pair_eq_pair_iff.2 (Or.inr ⟨h1, h2⟩)⟩
+  · rintro ⟨e, he⟩
+    rcases Set.pair_eq_pair_iff.1 he with ⟨h1, h2⟩ | ⟨h1, h2⟩
+    · refine ⟨?_, Or.inl ⟨e, h1, h2⟩⟩
+      intro hvw
+      have a : vtype v = 0 := by rw [← h1]; exact vtype_oO e
+      have b : vtype w = 1 := by rw [← h2]; exact vtype_tO e
+      exact absurd (a.symm.trans ((congrArg vtype hvw).trans b)) (by decide)
+    · refine ⟨?_, Or.inr ⟨e, h1, h2⟩⟩
+      intro hvw
+      have a : vtype w = 0 := by rw [← h1]; exact vtype_oO e
+      have b : vtype v = 1 := by rw [← h2]; exact vtype_tO e
+      exact absurd ((b.symm.trans (congrArg vtype hvw)).trans a) (by decide)
+
+end Implicit2
+
+end Langlandscape.Tree
